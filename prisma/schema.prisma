// ============================================================
// REFERRALS (company → company)
// ============================================================
//
// Distinct from ReferralLink above, which is a company's CLIENT referring
// another homeowner to that company. This is FieldQuo's own growth loop: one
// contractor telling another contractor about the product.
//
// Reward rules, encoded here so they aren't scattered across route handlers:
//
//   * The new company's 3 months are granted at signup. That's their trial —
//     it costs nothing if they churn, and it's the thing that makes the offer
//     worth clicking.
//   * The referrer's 3 months are granted on the referred company's FIRST
//     PAYMENT, not their signup. Paying out on signup alone makes this a
//     fraud target: twenty throwaway emails would earn five free years.
//   * A company that already exists can refer but can never redeem. The offer
//     acquires new customers; letting existing ones redeem just discounts
//     revenue you already had.

model ReferralInvite {
  id        String  @id @default(cuid())
  // Who sent it.
  companyId String
  company   Company @relation("ReferralInvitesSent", fields: [companyId], references: [id], onDelete: Cascade)

  // Exactly one of these is set. Kept as plain strings rather than a Contact
  // relation because the recipient is, by definition, not in the system yet.
  email String?
  phone String?

  channel ReferralChannel
  status  ReferralInviteStatus @default(sent)

  // Set when a company signs up carrying this invite's referral code and
  // matching contact details. Not a hard link — someone can forward the link
  // to a colleague, and that referral should still count for the sender.
  redeemedByCompanyId String?   @unique
  redeemedAt          DateTime?

  // Twilio/Resend id, so a delivery complaint can be traced to a send.
  providerMessageId String?
  error             String?

  sentByUserId String?
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
}

// A granted "3 free months". One row per grant so the reason and the source
// are auditable — a support question about a company's billing date should be
// answerable without reading application logs.
model ReferralCredit {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("ReferralCreditsEarned", fields: [companyId], references: [id], onDelete: Cascade)

  // The other company in the relationship: for a referrer's credit this is
  // the company they referred; for a new company's credit it's their referrer.
  counterpartyCompanyId String?

  role   ReferralRole
  // Referee ("referred") side: free months added to their trial. Referrer side
  // no longer uses months — its reward is a dollar credit (below).
  months Int          @default(1)

  // The trial end date this credit produced (referee side), captured at grant
  // time. Storing it means a later change to the reward size can't retroactively
  // rewrite what a company was actually given.
  appliedTrialEndsAt DateTime?

  // Referrer side: the account credit earned, in cents, = one month of the
  // REFERRED company's plan (their seats × their rate). Applied to the referrer's
  // Stripe customer balance. stripeBalanceTxnId is set once actually applied;
  // null means earned-but-not-yet-applied (e.g. the referrer has no Stripe
  // customer yet because they're still on trial — applied when they start paying).
  creditCents        Int?
  currency           String?
  stripeBalanceTxnId String?

  createdAt DateTime @default(now())

  // One credit per company per role per counterparty. Without this, a webhook
  // retry or a double-clicked button grants the reward twice.
  @@unique([companyId, role, counterpartyCompanyId])
  @@index([companyId])
  // For the 50-referrals-per-month cap and the pending-credit sweep.
  @@index([companyId, role, createdAt])
}

enum ReferralChannel {
  email
  sms
  link
}

enum ReferralInviteStatus {
  sent
  failed
  redeemed
}

enum ReferralRole {
  referrer
  referred
}

// ============================================================
// AI USAGE & QUOTA
// ============================================================
//
// Every model call is metered. Two reasons, and the second is the important
// one:
//
//   1. Cost visibility. FieldQuo pays OpenAI, not the company, so without a
//      per-tenant record there is no way to know whether AI costs $4/month or
//      $400 — or which company is responsible.
//   2. Abuse containment. A scripted loop against /api/ai/copilot is an
//      unmetered spend on FieldQuo's card. A cap turns a potentially unbounded
//      bill into a known maximum.
//
// Recorded AFTER the call, from the provider's own usage numbers rather than
// an estimate — a tool-use loop can make several round trips for one question,
// and counting the question rather than the tokens would understate it badly.

model AiUsage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which part of the product spent this: "copilot", "expense_summary",
  // "monthly_digest", "translation". Lets a spike be traced to a feature
  // rather than just a company.
  feature String
  model   String

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  // Cost in millionths of a dollar (micros). Integers, not floats — a
  // single call can cost $0.0004, and summing floats over thousands of rows
  // accumulates error into a number people will compare against an invoice.
  costMicros Int @default(0)

  // Null for background jobs (digests, cron). Set for anything a person
  // triggered, so "who is generating all this" is answerable.
  userId String?

  createdAt DateTime @default(now())

  // Every read is "this company, this month", so the index matches.
  @@index([companyId, createdAt])
  @@index([createdAt])
}

// A company's public website.
//
// ── Why its own table ───────────────────────────────────────────────────────
//
// `blocks` is the whole page and gets read on every public page view. Putting
// it on Company would drag it into every getCurrentMember(), every settings
// screen and every quote render — a few kilobytes of marketing copy loaded
// hundreds of times a day by code that will never look at it.
//
// ── Why the subdomain is stored here and not reused from Company.slug ───────
//
// It's SEEDED from Company.slug, which is what the company already knows
// themselves as, so there's nothing to invent at setup. But once a site is
// live the address is in print, on a van, and in Google's index — it must not
// move because someone renamed their company in Settings. Copying it once and
// letting them change it deliberately is the difference between a URL and an
// accident.
model CompanySite {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // The subdomain: <subdomain>.fieldquo.com. Unique across the platform and
  // checked against RESERVED_SUBDOMAINS in lib/site/subdomain.js.
  subdomain String @unique

  // The page itself: an ordered array of typed blocks. See
  // app/data/siteBlocks.js for the shapes. Json rather than a Block table
  // because the whole page is always read and written together — a relational
  // split would buy queryability nobody needs and cost a join per section.
  //
  // `blocks` is the ORIGINAL single-page model and stays as the Home page's
  // content for backward compatibility — every existing site has it and nothing
  // migrates. `pages` is the multi-page model layered on top: an ordered list of
  // { id, slug, title, nav, blocks } so a site can have Home / Services / About
  // / Work / Contact as real pages with a real menu. Null `pages` means "single
  // page" and the renderer falls back to `blocks` as Home — see lib/site/pages.js.
  blocks Json?
  pages  Json?

  // Nothing is public until this is true. Distinct from having blocks: a
  // company can generate, edit and preview for a week before going live.
  published   Boolean   @default(false)
  publishedAt DateTime?

  // Answers to the setup interview, kept so regenerating doesn't ask again.
  interview Json?

  // The DESIGN style — what makes two companies' sites look different rather
  // than merely read differently. One of a closed set (lib/site/siteStyles.js):
  // modern | bold | minimal | classic | warm. The AI picks it from the
  // company's free-text description, and the company can override it. Colours
  // and logo still come from Branding; a style changes type scale, weight,
  // rhythm and corner treatment, never the palette.
  styleKey String? @default("modern")

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])

  // The conversation. Lovable-style iteration means the thread IS the interface:
  // what you asked for, what was built, and what it still needs. Kept so
  // reopening the builder shows the history rather than a blank box that has
  // forgotten everything you told it.
  //
  // [{ role: "user"|"assistant", text, at, meta? }] — capped in the route.
  chat Json?

  // Photo library for the site, independent of any one block.
  //
  // Before/after pairing needs a pool to pair FROM: you upload six photos and
  // then say which two go together. Storing them only inside a gallery block
  // meant an unpaired photo had nowhere to live, which is why "I can upload 3, 4,
  // 6 — how will it know which is which" had no answer.
  //
  // [{ url, label?, at }]
  photoLibrary Json?

  // When someone last edited the copy BY HAND in the Sections pane.
  //
  // Regenerating rewrites every text field. Photos and before/after pairs are
  // carried across, but hand-written words are not — so a company that spent
  // twenty minutes rewording their about section and then typed a new prompt
  // silently lost it. This is what the confirmation before regenerating reads,
  // and it has to be persisted rather than held in component state: the twenty
  // minutes and the regeneration are often on different days.
  //
  // Cleared on generation, because at that point the copy IS the generated copy
  // and there is nothing of theirs left to warn about.
  handEditedAt DateTime?

  // Which languages this site is published in. The FIRST is the primary — the
  // one served at the root URL — and the rest get /<code> paths.
  //
  // Defaults to the company's own defaultLanguage at creation. Empty is treated
  // as [defaultLanguage] rather than "no languages", because a site that renders
  // in nothing is not a state worth representing.
  languages String[] @default(["en"])

  // Generated CONTENT for the non-primary languages:
  //   { fr: { blocks, seoTitle, seoDescription }, es: {...} }
  //
  // Generated per language and STORED, not machine-translated at request time.
  // Translating on the fly would give two visitors different words for the same
  // page, re-translate on every render, and cost a model call per pageview. The
  // site's furniture is a static table (lib/site/siteCopy.js); this is the part
  // that is actually written per company.
  translations Json?
}

// Per-company, per-trade configuration for the public instant estimator.
//
// The estimator NEVER prices off our defaults — it prices off this row. A
// trade with no row (or enabled=false) is simply not offered as an instant
// quote, which is how non-negotiable #4 (public endpoints don't publish a rate
// card WE invented) stays true: every number a homeowner sees traces to sell
// rates this company reviewed and saved.
//
// `config` is a Json blob whose shape mirrors INSTANT_ESTIMATE_DEFAULTS[trade]
// in lib/estimate/instantEstimate.js — material rows with sell rates, surcharge
// maps, range band, minimum charge. Kept as Json rather than columns because
// the shape differs per trade (roofing has $/square, lawn has size tiers) and
// a column-per-field schema would be mostly nulls. The estimator validates it
// at price time, so a malformed blob degrades to "not configured", never a bad
// price.
model InstantQuoteConfig {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Estimator trade key: roofing | epoxy | parging | lawn_mowing |
  // cabinet_refacing. Maps to a ServiceCategory key, but named `trade` because
  // the estimator's unit of configuration is the pricing model, not the
  // catalogue entry (roofing_service the category vs. roofing the estimator).
  trade     String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, trade])
}

// A tenant-side audit trail: who did what inside a company's own app. This is
// deliberately SEPARATE from PlatformAuditLog (which records FieldQuo staff
// actions). Before this existed, support could see a company's current state
// but never "who deleted this client" or "who changed this price" — the single
// most common support question had no answer anywhere in the schema.
//
// Written best-effort by lib/activity/log.js — a logging failure must never
// fail the user's actual action, so nothing here is in a transaction with the
// thing it records. That means the log can miss an event under failure, which
// is the honest trade: an audit trail that can occasionally drop a row beats
// one that can roll back a customer's quote.
//
// Actor identity is CAPTURED at write time (name + role), not just referenced,
// so a departed employee or a renamed user doesn't erase who did it.
model ActivityLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actorUserId   String?
  actorMemberId String?
  actorName     String?
  actorRole     String?
  // True if the action came through a platform-support impersonation session.
  // Support is read-only, so a write under impersonation should be impossible —
  // if one ever shows up here, that's precisely what an audit trail is for.
  viaImpersonation Boolean @default(false)

  // Dotted verb, e.g. "quote.sent", "client.deleted", "payment.recorded".
  action     String
  entityType String? // "quote" | "invoice" | "client" | "payment" | "settings" | ...
  entityId   String?
  // Human-readable one-liner shown in the log, composed at write time.
  summary    String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}

// ── Voice: the AI receptionist ───────────────────────────────────────────────

/// A phone number the AI receptionist answers on.
///
/// Three ways a company gets one, and they are genuinely different products —
/// see lib/voice/numbers.js:
///   purchased — we buy it from the provider. Instant, theirs to keep.
///   forwarded — they keep their own number and forward calls to ours. The
///               DEFAULT migration path: reversible in a minute, no paperwork,
///               and their number keeps working everywhere else it's printed.
///   ported    — the number itself moves to us. Weeks, irreversible in
///               practice, and their business line is at risk if it stalls.
model VoicePhoneNumber {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// E.164, always. Stored normalised so a lookup from a webhook can't miss on
  /// formatting — the provider sends +15551234567 and a human types (555) 123-4567.
  e164 String @unique

  /// What the company should give out. For `forwarded` this is THEIR number,
  /// not ours, and it's the one that goes on the van — printing ours would
  /// undo the whole point of forwarding.
  publicNumber String?

  source VoiceNumberSource @default(purchased)
  status VoiceNumberStatus @default(provisioning)

  /// local or toll_free. NOT cosmetic: a toll-free number costs us more to rent
  /// AND more per inbound minute, because on toll-free the CALLED party pays the
  /// carrier leg. Billing both at the local rate is a quiet loss on every
  /// toll-free customer — the kind that only shows up in a margin report months
  /// later. See lib/voice/credits.js.
  numberType String @default("local")

  /// The provider's own id, so a release or reassign doesn't have to guess.
  providerId String?
  provider   String  @default("retell")

  /// What it costs the company per month, in cents. Held here rather than read
  /// from a price list at render time: a number bought at last year's rate keeps
  /// last year's rate until someone changes it deliberately.
  monthlyCents Int @default(0)

  /// Rent is paid up to this instant, and not one second further.
  ///
  /// The rental is a REAL, recurring charge to FieldQuo the moment the number
  /// exists at the provider, whether or not the contractor ever pays. So it is
  /// debited from the prepaid balance a month at a time, in advance — the first
  /// month before the number is bought at all. This column is what makes that
  /// idempotent: the rent cron only charges numbers whose paid-through has
  /// passed, and advances it by exactly one period in the same write. A missed
  /// cron day charges once when it next runs, never twice.
  ///
  /// Null means "never charged" — a number that predates rent billing, or a
  /// port that has just gone active. Both are due immediately.
  rentPaidThroughAt DateTime?

  /// Set when a rent debit failed for want of balance. The number KEEPS WORKING
  /// until this passes: a contractor's advertised phone number vanishing without
  /// warning is worse than FieldQuo carrying a week of $4 rental. When it passes
  /// and the balance is still short, the number is released for real.
  /// Cleared the moment rent is paid.
  rentGraceUntilAt DateTime?

  /// When we last told them. Stops a daily cron sending a daily email, while
  /// still proving the warning went out before anything was taken away.
  rentWarnedAt DateTime?

  /// Set while a port is in flight, so the UI can say "moving, est. 3 Aug"
  /// rather than a spinner with no end.
  portRequestedAt DateTime?
  portExpectedAt  DateTime?

  releasedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agentId String?
  agent   VoiceAgent? @relation(fields: [agentId], references: [id])
  calls   VoiceCall[]

  @@index([companyId, status])
}

enum VoiceNumberSource {
  purchased
  forwarded
  ported
}

enum VoiceNumberStatus {
  provisioning
  active
  porting
  failed
  released
}

/// The receptionist's persona and rules for one company.
model VoiceAgent {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  providerAgentId String?
  /// A SECOND agent, for calls WE place. Separate from the inbound receptionist
  /// because its whole prompt differs (discloses up front, honours "stop
  /// calling", never negotiates). One per company, reused across all outbound
  /// purposes via per-call dynamic variables. See lib/voice/outboundPrompt.js.
  outboundProviderAgentId String?
  /// Retell splits an agent in two: the AGENT (voice, language, webhook) and the
  /// RESPONSE ENGINE — a "Retell LLM" object that owns the prompt, the opening
  /// line and the tools. `/create-agent` takes a `response_engine.llm_id`, not a
  /// prompt. We must keep both ids or every re-provision would orphan the old
  /// LLM and create a new one. See lib/voice/provision.js.
  providerLlmId         String?
  outboundProviderLlmId String?
  provider        String  @default("retell")

  name     String  @default("Receptionist")
  voice    String?
  language String  @default("en")

  /// What it says when it picks up. Company-authored, because this is the first
  /// thing a stranger hears from the business.
  greeting String?

  /// Extra instructions the owner types. Layered UNDER the system rules in
  /// lib/voice/prompt.js — a company can shape the tone, not remove the
  /// guardrails.
  instructions String?

  /// A human to hand off to. Null means the agent takes a message instead of
  /// promising a transfer that can't happen.
  transferTo String?

  /// Off by default. An agent that answers before anyone has heard it is how a
  /// contractor finds out from a client.
  enabled Boolean @default(false)

  /// Attribution for anything the agent creates. A synthetic member, so the
  /// activity log says the receptionist did it rather than naming a person who
  /// wasn't there.
  memberId String?

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  numbers   VoicePhoneNumber[]
  calls     VoiceCall[]
}

/// One call, and what came of it.
model VoiceCall {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  providerCallId String  @unique
  numberId       String?
  number         VoicePhoneNumber? @relation(fields: [numberId], references: [id])
  agentId        String?
  agent          VoiceAgent?       @relation(fields: [agentId], references: [id])

  direction String @default("inbound")
  fromE164  String?
  toE164    String?

  startedAt DateTime?
  endedAt   DateTime?
  /// Seconds. Billed minutes are derived from this and stored on the usage row,
  /// so a rounding-rule change can't silently rewrite what was charged.
  durationSec Int @default(0)

  transcript   Json?
  summary      String?
  recordingUrl String?

  /// Why it ended, from the provider — answered, no-answer, hung up, error.
  disposition String?

  /// What the agent produced. Nullable because most calls produce nothing, and
  /// a wrong number is a perfectly normal outcome.
  leadId    String?
  clientId  String?
  bookingId String?

  /// Needs a human to look at it — the agent flagged something, or it failed.
  needsReview Boolean @default(false)
  reviewedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, needsReview])
}

/// Voice minutes bought and spent. Prepaid, deliberately — see lib/voice/credits.js.
model VoiceCreditEntry {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Positive for a top-up, negative for a call. One table for both so the
  /// balance is a SUM that can be audited, rather than a counter that can drift
  /// away from the calls that moved it.
  cents Int

  kind   String  // "topup" | "call" | "trial" | "adjustment" | "number_setup" | "number_rent"
  callId String?
  /// The Stripe Checkout session or payment intent behind a top-up, so a
  /// disputed charge can be traced to the credit it bought.
  stripeRef String?

  /// Idempotency key for anything that must happen EXACTLY once, enforced by
  /// the database rather than by a read-then-write that two concurrent callers
  /// can both pass.
  ///
  /// Three things depend on it, and each is a real bug it prevents:
  ///   "voice_trial"                    — the free-minutes gift, once per
  ///                                      company FOREVER. Guarding it on "no
  ///                                      active number" instead would let a
  ///                                      company release and re-buy for
  ///                                      another 30 minutes, every time.
  ///   "number_rent:<numberId>:<date>"  — one month's rent, once per period,
  ///                                      so a cron that runs twice in a day
  ///                                      charges once.
  ///   "number_setup:<token>"           — the up-front month, paired with a
  ///                                      "refund:<token>" if the purchase then
  ///                                      fails at the provider.
  ///
  /// Nullable, and null is unconstrained in Postgres, so the millions of call
  /// and top-up rows that key on callId/stripeRef are unaffected.
  ref String?

  note      String?

  createdAt DateTime @default(now())

  @@unique([companyId, ref])
  @@index([companyId, createdAt])
}

/// Permission to ring a specific number, and where it came from.
///
/// ── Why this is a table and not a boolean ──────────────────────────────────
///
/// "May we call this number" has to be answerable months later, in front of a
/// regulator, with a date and a reason. TCPA is up to $1,500 PER CALL and CASL
/// up to $10M for an organisation, and the defence is always the same: show
/// that the person asked to be contacted, and when.
///
/// So consent is a ROW with a source and a timestamp, not a flag somebody could
/// have set. If there is no row, the agent does not dial. That makes cold
/// calling structurally impossible rather than merely against the rules — a
/// contractor who pastes in a purchased list gets nothing, which is the point.
model CallConsent {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// E.164, normalised. The lookup key, so a number typed one way and dialled
  /// another can't slip past the check.
  e164 String

  /// How they asked. Each of these is a real, evidenced request to be
  /// contacted — not an inference:
  ///   self_quote     submitted a quote request that said we'd call
  ///   booking        booked a visit
  ///   quote_approved a quote they asked for was approved
  ///   job_completed  we did work for them
  ///   manual         staff recorded a verbal request — needs `note`
  source String

  /// The exact wording they were shown when they gave it. Stored, not
  /// referenced, because the form copy WILL change and the defence has to be
  /// what this person actually saw.
  disclosure String?

  /// What it relates to, so consent can be traced to the thing that created it.
  leadId    String?
  clientId  String?
  quoteId   String?
  jobId     String?
  note      String?

  /// Set the moment they ask to stop. Checked BEFORE any consent row — an
  /// opt-out always wins, whatever else is on file, and it is never deleted.
  optedOutAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId, e164])
  @@index([e164, optedOutAt])
}

/// One queued outbound call, waiting for a good time to be placed.
///
/// A queue rather than a call placed on the spot, because the trigger and the
/// call must not be the same moment: a quote approved at 9pm must not ring the
/// customer at 9pm. The cron drains this within calling hours, re-checking
/// consent and credit at dial time — not at enqueue time, because a number can
/// opt out in the hours between.
///
/// Everything the call is ABOUT is a foreign key, never a copied name or
/// number: the dialled number is read from the linked lead/client at send
/// time, so an opt-out or a corrected number takes effect even for a call
/// already in the queue.
model VoiceCallTask {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Why we're calling — drives the script. See lib/voice/outboundPrompt.js.
  purpose String

  /// queued → calling → done | failed | skipped | cancelled
  status String @default("queued")

  /// What it's about. The number to dial is derived from these, not stored.
  leadId    String?
  clientId  String?
  quoteId   String?
  jobId     String?
  bookingId String?

  /// Script variables the purpose needs (customer first name, quote total as a
  /// fact the agent may STATE because a human already set it, appointment time).
  /// Never a price the agent computes — only figures a human already committed to.
  context Json?

  /// The earliest this may be dialled. Set to the next morning when a trigger
  /// fires after hours, so the queue itself carries the "not yet".
  notBefore DateTime @default(now())

  /// Dial attempts. A no-answer is retried a few times across days, then given
  /// up on — a fourth voicemail is a nuisance, not a follow-up.
  attempts   Int       @default(0)
  lastError  String?
  lastTriedAt DateTime?

  /// The call it produced, once placed. Links to the VoiceCall row the webhook
  /// fills in.
  providerCallId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([status, notBefore])
}

/// One message a crew member texted in — a photo, an update, a voice note.
///
/// Doubles as the record of what was filed AND the "which job?" question when
/// one is open (status = pending, candidateJobIds set). One row, both jobs:
/// there's no separate pending-question table to drift out of sync with the
/// message it's about. See lib/crew/inboxLogic.js for the state machine.
model CrewInboundMessage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The crew member, resolved from their phone. Null when the number isn't on
  /// the roster — the message is still logged (so nothing vanishes) but nothing
  /// is filed, because we don't know whose schedule to look at.
  senderUserId String?
  senderPhone  String

  body      String?
  /// Re-hosted to Cloudinary, not raw Twilio URLs — those need auth to fetch
  /// and expire, and JobVisit.photos are shown to staff expecting durable links.
  mediaUrls String[] @default([])
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// pending → filed | ignored | superseded
  status String @default("pending")
  /// How it was attributed once filed: explicit | gps | only-one | answered.
  method String?

  /// Where it landed. jobVisitId is the specific visit the media was appended to.
  jobId      String?
  jobVisitId String?

  /// When status = pending: the jobs the crew was asked to choose between.
  candidateJobIds String[] @default([])

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([companyId, status])
  @@index([companyId, senderPhone, status])
}

/// One photo of a job, with the stage it belongs to and whether it's been
/// promoted to the public website gallery.
///
/// This is the richer store behind the crew inbox. A crew photo files to a job
/// (JobVisit.photos keeps the raw feed for the job screen); a JobPhoto row adds
/// the STAGE (start / progress / finish / issue) the crew agent inferred, and a
/// `featured` flag the owner sets to lift the best ones onto their website.
/// Start + finish of the same job is the before/after that sells the work.
model JobPhoto {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobVisitId String?

  url     String
  /// start | progress | finish | issue — see lib/gallery/stages.js.
  stage   String  @default("progress")
  caption String?

  /// Promoted to the public gallery. Off by default: a job photo is private
  /// until the owner deliberately shows it — a homeowner's kitchen is not
  /// marketing until they say so.
  featured   Boolean @default(false)
  /// Manual ordering within an album; lower shows first.
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([companyId, featured])
  @@index([jobId, stage])
}
