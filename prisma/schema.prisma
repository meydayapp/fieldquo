// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// PLATFORM — FieldQuo's own back office (never mixed with tenant auth)
// ============================================================
model Product {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  // Per-language name and description, keyed by language code:
  //   { fr: { name, description }, es: { name, description }, ... }
  //
  // `name`/`description` above stay the source language — what the company
  // typed — and are what the app UI shows. This field is only read when
  // rendering a document for a CLIENT in another language.
  //
  // Populated two ways: standard add-ons ship with hand-written translations
  // (app/data/standardAddOns.js), and services a company adds itself get
  // drafted by lib/i18n/translateContent.js for the company to review.
  translations Json?
  type         ProductType @default(service)
  unitPrice    Decimal?    @db.Decimal(12, 2)
  costPrice    Decimal?    @db.Decimal(12, 2)
  unit         String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  // Which quote types (ServiceCategory) this product/service can be added to
  // as a line item. Empty = available on every quote type (e.g. a generic
  // "Rush Fee"); non-empty = only offered when building a quote in one of
  // these categories, so a Flooring quote doesn't offer cabinet hinges.
  categories ServiceCategory[]
}

model PlatformAdmin {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  role         PlatformAdminRole @default(support)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())

  auditLogs        PlatformAuditLog[]
  demoAvailability DemoHostAvailability[]
  demoBookings     DemoBooking[]
}

// When a FieldQuo admin will take a product demo booked from the marketing
// site. FieldQuo's OWN sales calendar — nothing here belongs to a tenant.
//
// ── Why this is not AvailabilitySchedule ───────────────────────────────────
//
// AvailabilitySchedule hangs off User: a tenant employee, with a Better Auth
// session and a companyId. PlatformAdmin is a separate table with its own
// email, its own bcrypt hash and its own JWT — so a platform admin's id can
// never be a valid AvailabilitySchedule.userId. Reusing that model would mean
// fusing two identity systems that are separate on purpose, or inventing a
// shadow User row for each admin. Same shape, different owner, own table.
//
// ── Absence is absence ─────────────────────────────────────────────────────
//
// No rows for an admin means that admin offers nothing, and no rows at all
// means the marketing hero shows "no open times" — it does NOT fall back to an
// invented grid. Before this model existed the hero published 6–10pm every day
// of the week, weekends and holidays included, because three constants in
// lib/demo/slots.js said so and nobody had ever stated otherwise.
model DemoHostAvailability {
  id      String        @id @default(cuid())
  adminId String
  admin   PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  /// 0 = Sunday, matching AvailabilitySchedule and JS Date#getDay.
  dayOfWeek Int
  /// Wall-clock in `timezone` ("18:00"), never UTC — the offered instant moves
  /// with DST, which is the whole reason lib/booking/slotGrid.js exists.
  startTime String
  endTime   String
  timezone  String   @default("America/Toronto")
  createdAt DateTime @default(now())

  /// One window per admin per day per start. Two blocks on the same day (a
  /// morning and an evening) are two rows with different startTimes.
  @@unique([adminId, dayOfWeek, startTime])
  @@index([adminId])
}

// Things that FAILED, recorded so support can see them without a customer
// having to notice first.
//
// The failures this product has been bitten by are all silent: an email Resend
// rejected, a Stripe webhook that never created a row, an AI call that degraded
// to nothing, a PDF that didn't render. Each one is caught and logged to the
// server console today — which means it's invisible the moment nobody is
// tailing logs. This table is the durable version.
//
// Deliberately NOT a general application log. Only real failures land here, so
// an empty list genuinely means "nothing broke", which is the only thing that
// makes it worth opening.
/// FieldQuo's OWN texting numbers — the ones the platform holds, not a tenant's.
///
/// ══ Why this is a table and not TWILIO_PHONE_NUMBER ═══════════════════════
///
/// It was an env var, and an env var cannot be bought. Standing one up meant
/// opening the Twilio console, buying a number by hand, editing a Vercel
/// setting and redeploying — four steps outside the product, none of them
/// visible to anyone afterwards, and one of them silently wrong: production's
/// TWILIO_PHONE_NUMBER named +17372212163, a number the account has never
/// owned. Every send using it failed with Twilio error 21606, and nothing
/// anywhere said so, because naming a number in configuration is not owning it.
///
/// A row can be bought from /platform, is written by the same purchase that
/// tells the carrier, and can be checked against the account. The env var
/// remains as a fallback so nothing breaks the moment this ships, and so a
/// deployment can still be pointed at a number by hand if it must be.
model PlatformSmsNumber {
  id String @id @default(cuid())

  /// E.164. Unique because two rows for one number is two owners for one thing.
  e164 String @unique

  /// Twilio's IncomingPhoneNumber SID — needed to hand the number back.
  providerId String?

  /// system      the default "From" for outbound texts by a company that has no
  ///             number of its own. What TWILIO_PHONE_NUMBER used to name.
  /// shared_test the line lent to one company at a time so a contractor can
  ///             prove crew texting works before buying anything.
  ///
  /// One number can be both, and on a small deployment usually is — which is
  /// exactly what the env var did. Kept as separate rows rather than flags so
  /// splitting them later is a purchase, not a migration.
  purpose String @default("system")

  /// Cleared rather than deleted when a number is handed back, so the ledger of
  /// what FieldQuo has rented over time survives. `active: false` never resolves.
  active Boolean @default(true)

  /// What we paid, in cents, at the provider. Recorded because FieldQuo's own
  /// carrier spend is not otherwise visible anywhere in this product.
  monthlyCostCents Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  releasedAt DateTime?

  @@index([purpose, active])
}

model PlatformErrorLog {
  id String @id @default(cuid())

  // Which subsystem. Free string rather than an enum: a new integration should
  // be loggable without a migration. Convention: email | sms | ai | stripe |
  // webhook | pdf | upload | cron | api.
  area String
  // Short machine-ish code where one exists ("resend_rejected",
  // "cloud_name_mismatch"), else null. Groupable.
  code String?
  // The human-readable failure. Never a raw stack in here — see `detail`.
  message String

  // Which tenant it affected, when it's tenant-scoped. Null for platform-wide
  // failures (a cron that didn't run at all). No FK relation on purpose: a
  // company being deleted must not delete the record that it had errors.
  companyId String?

  // Extra context (ids, status codes, a trimmed stack). Json so each area can
  // record what's actually useful without a schema change.
  detail Json?

  // Support workflow: acknowledged errors drop out of the default view so the
  // list stays a to-do rather than an archive.
  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([companyId, createdAt])
  @@index([area, createdAt])
}

/// FIELDQUO'S OWN phone agent at the provider. At most one row, ever.
///
/// VoiceAgent — the only other place a provider agent id is stored — is keyed
/// by companyId, so there was nowhere to record FieldQuo's own. That absence is
/// what made "does FieldQuo have an agent?" unanswerable, and it is why nothing
/// could provision one.
///
/// The prompt is deliberately NOT stored here. It is derived from the feature
/// registry and the Plan rows on every push (lib/platform/salesKnowledge.js), so
/// a copy in this table would be a second, staler answer to "what does it say" —
/// and the whole point of deriving it is that a price change reaches the phone
/// without anyone editing a prompt. Only the two things a person genuinely
/// decides live here: whether it answers, and the tone notes.
model PlatformVoiceAgent {
  /// Fixed by convention to "fieldquo" so upserts are unconditional and a
  /// second row cannot appear. There is one FieldQuo.
  id String @id @default("fieldquo")

  providerAgentId String?
  providerLlmId   String?

  /// Attachment is the on/off switch at the provider, exactly as for a tenant.
  /// Off by default: an agent that answers before anybody has heard it speak is
  /// how a prospect becomes the first listener.
  enabled Boolean @default(false)

  /// FieldQuo's own tone notes. Bounded and fenced in the prompt, and unable to
  /// override the absolute rules — see lib/platform/salesPrompt.js.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A call to FIELDQUO'S OWN number — the sales line, not a tenant's phone.
///
/// ══ Why this is not a VoiceCall ═══════════════════════════════════════════
///
/// VoiceCall.companyId is a required relation to Company, so recording one of
/// these there needs a Company row for FieldQuo. That row would then be a
/// tenant everywhere a tenant is counted: the company list, the platform
/// dashboard's active-companies figure, MRR, the feature-override picker, the
/// voice credit ledger, the rent cron, every `db.company.findMany` in the
/// console. One table saved, a dozen numbers quietly wrong.
///
/// It also breaks the property FieldQuo's own agent is built around — that it
/// has no tenant and can reach no tenant row. A separate table makes that
/// structural instead of merely intended.
///
/// ══ What it is for ════════════════════════════════════════════════════════
///
/// The webhook resolves a tenant from the number that was dialled, so a call to
/// FieldQuo's own number matched nothing and was recorded as "call to an
/// unknown number" and dropped — no record, no transcript, no summary, nowhere
/// to look. This is where those land, and /platform/sales-agent is where they
/// are read.
///
/// ══ Nothing here is billed ════════════════════════════════════════════════
///
/// Deliberately no credit ledger and no charge: FieldQuo's own minutes are
/// FieldQuo's own cost and already appear in the shared-pool spend on
/// /platform/voice-health (lib/voice/pool.js counts every minute served).
/// Charging a company for them would need a company, which is the whole point.
model PlatformVoiceCall {
  id String @id @default(cuid())

  /// Retell's id. Unique so the three events for one call (started, ended,
  /// analyzed) upsert onto one row and a provider retry cannot duplicate it.
  providerCallId String @unique

  /// The agent that answered, as Retell knows it. A plain string rather than a
  /// relation: there is no VoiceAgent row for FieldQuo's own agent, because
  /// that table is keyed by companyId.
  providerAgentId String?

  direction String  @default("inbound")
  /// The caller. This is the only contact detail a sales call leaves behind, so
  /// it is what "ring them back" is answered from.
  fromE164  String?
  /// FieldQuo's own number, as dialled.
  toE164    String?

  startedAt   DateTime?
  endedAt     DateTime?
  durationSec Int       @default(0)

  transcript   Json?
  summary      String?
  recordingUrl String?

  /// Why it ended, from the provider.
  disposition String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([startedAt])
}

model PlatformAuditLog {
  id              String        @id @default(cuid())
  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  action          String
  targetCompanyId String?
  details         Json?
  createdAt       DateTime      @default(now())
}

// ── Feature availability: what FieldQuo OFFERS ─────────────────────────────
//
// FieldQuo's OWN data, not a tenant's — which is why the platform console may
// write it. Non-negotiable #3 says the console views everything and edits
// nothing on a COMPANY's data; a decision about whether FieldQuo offers a
// feature is not the company's data, in the same way DemoHostAvailability is
// FieldQuo's sales calendar rather than a customer's. Do not "fix" the write
// route by making it read-only.
//
// ── Deliberately NOT the Company booleans ──────────────────────────────────
//
// Company.aiCopilotEnabled / crewInboxEnabled / outboundCallsEnabled /
// sitePublished / discoverable / reviewRequestsEnabled are ADOPTION: the
// contractor found the switch and turned it on. These two tables are
// AVAILABILITY: whether FieldQuo offers it to them at all. Folding one into the
// other would lose the difference between "we don't offer this yet" and "they
// haven't switched it on" — the first question on any "where is X?" ticket.
//
// ── `key` is closed, and enforced in code ──────────────────────────────────
//
// A plain String column, but never free text: every write goes through
// assertKnownFeature() against the closed list in lib/features/registry.js, and
// `npm run check:features` fails if a registry key has no consumer. A row whose
// key is not in the registry resolves HIDDEN and is ignored — fail closed, so a
// stale row from a deleted feature can never re-open something.
//
// ── Nothing here deletes tenant data ───────────────────────────────────────
//
// Same rule as unpublishing a website: turning a feature off makes it
// unreachable and touches nothing. Funnels, campaigns, call records, site blocks
// and instant-quote rate cards survive untouched and come back exactly as they
// were. No cascade from these tables reaches a tenant row.

/// Platform-wide default for one feature. Absent row = the registry's own
/// defaultState, which is how a feature behaves before anyone has said anything.
model PlatformFeature {
  key   String @id
  /// "on" | "preview" | "locked" | "hidden". Validated in code, not by an enum:
  /// a Postgres enum would need a db push to add a state and would still not
  /// constrain `key`, so the registry does both checks in one place.
  state String @default("hidden")
  /// Shown to the CONTRACTOR when state is "locked" — the reason they can read.
  /// Never shown for "hidden", which must leave no trace at all.
  note        String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// One company's answer, overriding the global. Absent row = inherit.
///
/// No foreign key to PlatformFeature on purpose: an override is meaningful
/// before anyone has set a global (letting one beta tester into a feature that
/// is otherwise on its registry default is the common case), and a FK would
/// force a global row to exist first. Integrity comes from assertKnownFeature()
/// on write plus fail-closed resolution on read.
model CompanyFeatureOverride {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  state     String
  note      String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([companyId, key])
  @@index([key])
}

// A platform-issued promo code — influencer or tester. UNLIKE a referral code
// (company-owned, company-to-company, pays a credit to the referrer), these are
// minted by FieldQuo superadmins to give a selected person a free head start.
// There is no referrer and no credit to anyone — just extra free months for the
// company that signs up with it. Single-use per link by default (generate more
// as needed). `label`/`notes` record who we handed it to and are NEVER shown to
// the redeemer.

/// A public, time-boxed promotional price — the "$98/mo for 3 months, then
/// $139" that competitors run on their own pricing pages.
///
/// ══ Why this is not PlatformPromoCode ══════════════════════════════════════
///
/// That model is a CODE somebody types, granted to one influencer or tester,
/// worth N free months, redeemed a fixed number of times. This is the opposite
/// on every axis: nobody types anything, it applies to everyone who signs up
/// while it is running, it changes the PRICE rather than granting free months,
/// and it ends on a date rather than on a redemption count.
///
/// Folding the two together would mean a `kind` flag switching off half the
/// columns of whichever row you were looking at.
///
/// ══ It expires by DATE, and the date is the point ══════════════════════════
///
/// `endsAt` is what makes a promotion a promotion. A discount with no end is a
/// price, and pretending otherwise on a pricing page is the kind of thing that
/// gets a marketing team a letter. `active` is the manual switch on top, so a
/// promotion can be pulled early without editing its dates and losing the
/// record of what it was.
model PlatformPromotion {
  id    String  @id @default(cuid())
  /// Shown on the pricing page — "Save $47/mo for 3 months".
  label String
  notes String?

  /// The switch. False means off regardless of dates.
  active Boolean @default(false)

  /// Null startsAt means "as soon as it is active".
  startsAt DateTime?
  /// Required. See the note above — a promotion without an end is a price.
  endsAt   DateTime

  /// "percent" — 30 means 30% off.
  /// "amount"  — a fixed reduction in the plan's OWN currency, so a CAD plan
  ///             and a USD plan of the same tier are not discounted by the same
  ///             number of dollars in different money.
  discountKind  String  @default("percent")
  discountValue Decimal @db.Decimal(12, 2)

  /// How many months the promotional price applies before the plan reverts.
  /// 3 is the shape competitors use. 0 would mean "forever", which is a price
  /// change, so it is rejected in code rather than encoded here.
  durationMonths Int @default(3)

  /// Empty means every tier. Otherwise the tierKeys it applies to.
  tierKeys Json?

  /// Empty means every currency.
  currencies Json?

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active, endsAt])
}

model PlatformPromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  label            String? // who this was given to (influencer handle, tester name)
  notes            String?
  kind             String    @default("influencer") // "influencer" | "tester"
  rewardMonths     Int       @default(3)
  maxRedemptions   Int       @default(1)
  redeemedCount    Int       @default(0)
  expiresAt        DateTime?
  active           Boolean   @default(true)
  createdByAdminId String?
  createdAt        DateTime  @default(now())

  redemptions PlatformPromoRedemption[]

  @@index([active])
}

model PlatformPromoRedemption {
  id            String            @id @default(cuid())
  promoCodeId   String
  promoCode     PlatformPromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  // A company redeems at most one promo code, ever (globally unique) — so a
  // stack of throwaway codes can't pile free months onto one account.
  companyId     String            @unique
  monthsGranted Int
  redeemedAt    DateTime          @default(now())

  @@unique([promoCodeId, companyId])
  @@index([promoCodeId])
}

// Feedback and bug reports submitted by companies from inside the app.
//
// companyId/userId are plain ids rather than relations on purpose: feedback
// must survive the company being deleted. "We deleted the account because of
// a bug they reported" shouldn't also delete the bug report.
model Feedback {
  id          String  @id @default(cuid())
  companyId   String?
  userId      String?
  // Denormalised at submission time so a reply is still possible after the
  // account is gone, and so triage doesn't need a join to show who reported it.
  email       String?
  companyName String?

  type    FeedbackType @default(other)
  subject String
  body    String
  // Which page they were on. The single most useful field for reproducing a
  // bug, and the one users never think to include.
  pageUrl String?

  status     FeedbackStatus @default(open)
  // Internal triage notes — never shown to the company.
  adminNotes String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Publishable quotes from happy companies, for the marketing site.
//
// Separate from Feedback because they have opposite lifecycles: feedback is
// triaged and closed, a testimonial is approved and published. Conflating them
// means one accidental status change puts a bug report on your homepage.
model Testimonial {
  id           String   @id @default(cuid())
  companyId    String?
  // Captured at approval time — the person's name and role as it should
  // appear publicly, which may differ from their account details.
  authorName   String
  authorTitle  String?
  companyLabel String?
  quote        String
  // Never published without an explicit approval step. Default false so a
  // draft can't reach the public site by omission.
  approved     Boolean  @default(false)
  // Still nothing in the product sets this, so the `featured desc` leading
  // every orderBy remains inert — it just sorts an all-false column. Ordering
  // is done with sortOrder instead, which /app/settings/reviews now writes via
  // the up/down arrows. Left in place rather than dropped because removing a
  // column is the one edit that cannot be undone by editing code; it should go
  // in a deliberate schema pass, not as a side effect of adding a screen.
  featured     Boolean  @default(false)
  // Set by the reorder arrows on /app/settings/reviews. Ties (every row that
  // has never been reordered is 0) are broken by createdAt in every query, so
  // the six that get published are the six the screen shows at the top.
  sortOrder    Int      @default(0)
  // Where the words came from. "manual" (typed in), "csv" (pasted or uploaded
  // in bulk). A future "google" would mean the words are Google's Content, not
  // the contractor's, and the Business Profile API policies bind what may be
  // done with them — 30-day storage, unaltered, attributed. Recording the
  // origin now is what makes it possible to honour that later without
  // guessing which rows arrived how. See docs/ROADMAP.md.
  source       String   @default("manual")
  // Stable identity WITHIN a source, so a second import of the same list
  // updates rather than duplicates. For pasted/CSV rows there is no upstream
  // id, so it is a hash of the author and the words — re-pasting a corrected
  // spelling of the quote is correctly a new row, re-pasting the same one is
  // not. A Google row would carry Google's review name here instead.
  externalId   String?
  createdAt    DateTime @default(now())
  // @default(now()) so adding the column backfills the rows that predate it;
  // @updatedAt keeps it current from then on.
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([approved, sortOrder])
  // The query every caller actually runs is companyId + approved, ordered.
  // The index above matches none of it and was left in place only because
  // dropping an index is not free to reason about on a live table.
  @@index([companyId, approved, sortOrder])
  // Identity is scoped to the company and the id ALONE, deliberately not to
  // the source as well: the same review typed in by hand and later pasted in a
  // bulk list is one testimonial, and including the source in the key would
  // publish it twice. Nulls are distinct in Postgres, so the rows that predate
  // this — every one of which has a null externalId — do not collide.
  @@unique([companyId, externalId])
}

model CustomField {
  id         String                @id @default(cuid())
  companyId  String
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType CustomFieldEntityType
  label      String
  fieldType  CustomFieldType       @default(text)
  options    Json? // string[] — only used when fieldType is "dropdown"
  required   Boolean               @default(false)
  sortOrder  Int                   @default(0)
  createdAt  DateTime              @default(now())

  values CustomFieldValue[]
}

// Polymorphic on purpose — entityId points at whichever table entityType
// implies (Client.id, Quote.id, Job.id, Invoice.id, Member.id). Not wired up
// to any of those forms yet (see note 2 above); the model just exists so the
// data has somewhere to live once that integration happens.
model CustomFieldValue {
  id            String      @id @default(cuid())
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  entityId      String
  value         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([customFieldId, entityId])
}

model TaxRate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  rate      Decimal  @db.Decimal(6, 3)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Plan {
  id                String   @id @default(cuid())
  /// No longer unique on its own: one tier exists once per currency, and
  /// "Crew (USD)" and "Crew" are the same plan to a human. Uniqueness moved to
  /// (tierKey, currency) below; `name` stays unique-per-currency in practice
  /// because the seeder builds it from the tier.
  name              String
  priceMonthly      Decimal  @default(0) @db.Decimal(12, 2)

  /// ── The seat ladder ──────────────────────────────────────────────────────
  ///
  /// `maxUsers` below counted PEOPLE, which is the wrong unit now: a plan
  /// carries billable seats and free crew separately, and 1+5 and 6+0 are the
  /// same headcount for very different money. Left in place and still written,
  /// because /platform/billing/plans reads it and a company on the old model
  /// must keep working until every reader has moved.
  ///
  /// A SEAT is anyone who can create or change a quote, job or invoice.
  /// Everyone else is crew and is free. That line is not a label — it is read
  /// off the permission grid, because owners and admins can hand an `employee`
  /// quote-create rights through the custom grid, and billing on the role name
  /// would let a shop run twenty estimators on a one-seat plan.
  seats             Int      @default(1)
  crewSeats         Int      @default(0)

  /// "solo" | "crew" | "shop" | "scale". Stable across price changes and
  /// currencies, so the CAD and USD rows of one tier can find each other.
  tierKey           String?

  /// ISO 4217. Two rows per tier — the same plan priced in the customer's own
  /// money, not converted at checkout. Jobber quotes USD with no selector, so a
  /// Canadian pays their sticker plus FX plus a card fee; matching their number
  /// in CAD is a real discount that costs nothing.
  currency          String   @default("CAD")

  /// Billed annually. Same monthly rate today — the owner's decision — so this
  /// is the INTERVAL, not a discount. Null means the tier has no annual option.
  priceAnnual       Decimal? @db.Decimal(12, 2)
  stripePriceIdAnnual String?

  sortOrder         Int      @default(0)
  stripePriceId     String?
  maxUsers          Int?
  maxQuotesPerMonth Int?
  aiCopilotEnabled  Boolean  @default(false)
  // Monthly AI token allowance for companies on this plan. Null = unlimited,
  // which should be used sparingly: FieldQuo pays for every token.
  aiMonthlyTokenCap Int?
  features          Json?

  /// Is this plan on the menu, or was it negotiated for one company?
  ///
  /// "Custom (2 employees) — $90/mo" was sitting in the customer-facing plan
  /// picker alongside the three standard plans, with a working Choose plan
  /// button — so any company could move themselves onto a rate agreed with
  /// somebody else. A bespoke plan still has to EXIST (its subscribers are on
  /// it, and it has to render as their current plan); it just must not be
  /// offered.
  ///
  /// Defaults true so every existing standard plan is unaffected. The
  /// company-facing list filters on this; the platform console shows
  /// everything, because that is where bespoke plans get made.
  isPublic          Boolean  @default(true)

  createdAt         DateTime @default(now())

  subscriptions Subscription[]

  @@unique([tierKey, currency])
}

model Subscription {
  id                   String             @id @default(cuid())
  companyId            String             @unique
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               SubscriptionStatus @default(trialing)
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // When the "you're subscribed" confirmation was sent.
  //
  // A real column rather than a boolean, and READ before sending: both the
  // Stripe webhook and the on-return reconcile land on the same upsert, so
  // without this a company whose webhook arrives just after they press "Check
  // with Stripe" gets the email twice. The timestamp also answers "did we ever
  // tell them" during a support conversation, which a boolean doesn't.
  welcomeEmailSentAt DateTime?

  // The plan the last confirmation described. Compared on change so a plan
  // switch sends a "your plan changed" note, and a webhook replaying the same
  // plan sends nothing.
  notifiedPlanId     String?
  /// When the account first went unpaid — trial ended with no working card, or
  /// a renewal failed.
  ///
  /// The grace period counts from HERE, not from `updatedAt`. Any unrelated
  /// write to this row touches updatedAt, so a grace period measured from it
  /// would silently restart every time a webhook arrived — the account would
  /// never actually lock, which is the failure nobody notices because it looks
  /// like everything working.
  ///
  /// Cleared the moment payment succeeds, so a company that fixes their card
  /// and later fails again gets a fresh 7 days rather than inheriting the old
  /// clock.
  pastDueSince DateTime?

  /// Set when the "you have N days left" email goes out, so the daily job
  /// doesn't send it again every morning.
  graceWarnedAt DateTime?

  /// The last save offer this company accepted, and when.
  ///
  /// Recorded so it can't be farmed. A discount you can claim every time you
  /// threaten to cancel isn't a discount — it's the price, and the customers
  /// who learn that are the ones who cost the most. One offer per twelve
  /// months; see lib/billing/retention.js.
  /// month · year — the cadence they are actually being charged on.
  ///
  /// The commitment a company chose at signup lived only in the Stripe checkout
  /// session's metadata, so FieldQuo's own database could not answer "are they
  /// on the one-year deal". The Account & Billing page therefore offered every
  /// upgrade at the monthly rate, and a company on the year silently lost the
  /// two free months by changing tier.
  ///
  /// Written from STRIPE, not from what a screen asked for: the authority on
  /// how somebody is billed is the price on the live subscription item, and it
  /// can change in the Stripe portal without passing through this app.
  ///
  /// Defaults to "month" rather than being nullable. Every existing row was
  /// created before the annual option existed, and monthly is what they are on
  /// — a null here would mean "unknown", which no screen could render honestly.
  billingInterval String @default("month")

  retentionOffer   String?
  retentionOfferAt DateTime?

  /// When the cancellation actually took effect.
  ///
  /// Starts the 30-day read-only window. Distinct from `pastDueSince`, which is
  /// the 7-day window for a FAILED payment: those are different situations and
  /// deserve different treatment. A failed card is urgent — fix it or lose
  /// access. A cancellation is a decision someone made, and they are not being
  /// punished for it; they may simply need to look up an old invoice.
  canceledAt DateTime?

  /// Why they left, in their own words. The single most valuable field in this
  /// table and the one nobody remembers to collect.
  cancelReason String?

  /// The `currentPeriodEnd` an advance renewal reminder was already sent for
  /// (`/api/cron/renewal-reminders`, `lib/billing/renewalReminder.js`).
  ///
  /// Keyed to the PERIOD, the same idea as `rentRef()` keying a rent charge to
  /// a period (lib/voice/spendGate.js) — not a boolean, because a boolean can
  /// only ever fire once. `currentPeriodEnd` advances every time Stripe
  /// renews, so comparing against it is what lets next month's (or next
  /// year's) reminder go out while this month's cannot be sent twice, on a
  /// cron that runs daily, replays, or overlaps itself.
  renewalRemindedPeriodEnd DateTime?

  /// When the reminder above was actually sent. Written only on a CONFIRMED
  /// send — see the cron's claim/revert comment — so a Resend failure doesn't
  /// permanently suppress the one email that exists to give someone notice
  /// before their card is charged.
  renewalReminderSentAt DateTime?

}

/// The Marketing Designer's starter-template gallery (app/components/designer/,
/// lib/designer/) — a FieldQuo-provided catalog, not a per-company save. Global
/// like `Plan` above, for the same reason: every company sees the same shelf of
/// starters, the way every company sees the same pricing tiers.
///
/// Deliberately NOT the source clone's shape. The nextjs-canva-clone this was
/// ported from stored templates as `Project` rows with `isTemplate`/`isPro`
/// flags — one table doing double duty as "a user's saved design" AND "a
/// public gallery entry", gated by a paywall. Two things changed that shape
/// here: (1) this task builds only the gallery, not a "save my project" flow,
/// so there is nothing for a template to be a special case OF; (2) the owner's
/// 2026-08-30 correction on this port is explicit — every editor feature ships
/// free except AI image generation, so an `isPro` column would be written and
/// never meaningfully read (AGENTS.md's #1 recurring failure class). Dropped
/// rather than carried forward as dead weight.
model DesignTemplate {
  id   String @id @default(cuid())
  /// Unique so prisma/seed-design-templates.js can upsert on it — re-running
  /// the seed fixes a template in place rather than duplicating the row.
  name String @unique
  /// A fabric.js canvas.toJSON() document — the same shape
  /// Editor.js's editor.loadJson()/saveJson() read and write, stored as
  /// native Json (this schema's convention — see DocumentTemplate.sections)
  /// rather than a pre-stringified String, so a template can be inspected or
  /// edited with an ordinary Postgres JSON query instead of only ever as an
  /// opaque blob.
  json   Json
  width  Int
  height Int
  /// Nullable: TemplateSidebar renders a generated colour/name card instead
  /// of a broken <img> when this is absent, rather than pretending a preview
  /// image exists. See prisma/seed-design-templates.js for why the seeded
  /// rows below DO have one.
  thumbnailUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// TENANT CORE — Company, Users, Membership/RBAC
// ============================================================

model Company {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  email        String?
  phone        String?
  address      String?
  city         String?
  province     String?
  website      String?
  logoUrl      String?
  // Cloudinary's own id for the logo asset, not just its URL.
  //
  // The upload route has always returned this and the app has always thrown it
  // away, which cost two things: a replaced logo left the old file on the
  // account forever (storage nobody is using but everybody is paying for), and
  // moving to a different Cloudinary account meant reverse-engineering ids out
  // of URLs. Both are cheap to avoid by keeping the id at upload time.
  logoPublicId String?
  // Kept as the canonical PRIMARY colour. Everything that read brandColor
  // before still works; brandColors below layers secondary/neutral on top
  // rather than replacing it, so there's no migration of existing values.
  brandColor   String? @default("#06356b")
  // { secondary, neutral } — see lib/email/emailTheme.js. Null means "derive
  // sensible defaults from brandColor", which is what every existing company
  // gets without touching a thing.
  brandColors  Json?

  // Default interface language for everyone in this company, and the fallback
  // for client-facing documents when a Client has no language of their own.
  // Distinct from Quote.language, which records the language a specific quote
  // was sent in — that must stay fixed even if the company later switches.
  defaultLanguage String   @default("en")

  // The company's own cabinet rate card, for the kitchen designer.
  //
  // Null means "use the defaults in lib/kitchen/pricing.js" — which are a
  // starting point, not a price. The adapted source came from one cabinet maker
  // charging $700 per linear foot; quoting a different shop at that number is
  // quoting someone else's business. The settings page writes this, every
  // pricing path reads it, and normaliseRates() merges it over the defaults so a
  // partially-filled card can't leave a field undefined and price at NaN.
  cabinetRates Json?
  // Languages this company actually sends CLIENT documents in. Drives which
  // options the employee sees when setting a client's language, and which
  // translations get drafted when a service is added.
  //
  // Separate from the six FieldQuo supports: a painter in Ottawa might send
  // in English and French only, and shouldn't be asked to review Tagalog
  // drafts for every service they add. Empty means "default language only".
  sendLanguages   String[] @default([])

  // ── Per-company email sending domain (Resend) ──────────────────────────
  // Until emailDomainStatus is "verified", mail for this company goes out on
  // FieldQuo's shared domain under the company's display name. Once verified,
  // it sends from emailFromLocal@emailDomain instead. See lib/email/resend.js
  // senderFor() and lib/email/resendDomains.js.
  emailDomain            String? // e.g. "send.northline.com"
  emailDomainId          String? // Resend's domain id, needed to verify/delete
  // not_started | pending | verified | failed
  emailDomainStatus      String?          @default("not_started")
  // Local part of the sender address: "quotes" -> quotes@send.northline.com
  emailFromLocal         String?          @default("quotes")
  // Cached DNS records Resend returned at creation, so the setup screen can
  // show them without re-hitting the API on every page load.
  emailDomainRecords     Json?
  emailDomainCheckedAt   DateTime?
  paymentTerms           String?

  /// When this company pays, and for what stretch of work.
  ///
  /// { frequency, periodEndDayOfWeek, payDayOfWeek, anchorDate } — resolved and
  /// defaulted by lib/payroll/payCycle.js, which is also where the reasoning
  /// lives for why the PERIOD END is the anchor and the payday is derived from
  /// it rather than the other way round (buildPayRun computes overtime against
  /// a weekly threshold, so periods have to contain whole weeks).
  ///
  /// Null until someone sets it, and null resolves to the documented default
  /// rather than to nothing: every company was already being handed "the last
  /// fourteen days ending today", so a default here is strictly more honest
  /// than the guess it replaces. What changes is that the default is now
  /// stated, stable, and editable.
  ///
  /// One Json column rather than four scalars because nothing queries on the
  /// parts — they are read together, as one policy, every time.
  payCycle Json?
  taxRate                Decimal          @default(0) @db.Decimal(6, 3)
  paymentMethods         String[]         @default(["cash", "e_transfer", "cheque"])
  bookingSlug            String?          @unique
  industries             String[]         @default([])
  onboardingStatus       OnboardingStatus @default(pending)
  trialEndsAt            DateTime?
  shareAnonymizedPricing Boolean          @default(false)

  // Boilerplate "what happens next" copied onto every new quote — timelines,
  // site access, payment schedule, warranty, who to call. Written once in
  // Settings, then editable per quote. Seeding it rather than rendering it
  // from the company record on the fly is deliberate: a quote sent last March
  // must keep saying what it said in March, even after the terms change.
  defaultProcessNotes String?

  // ── The two optional sections of the quote email ────────────────────────
  //
  // Everything else in that email is derived from the quote: the scope, the
  // line items, what's included, the process steps. These two are the
  // COMPANY's proof rather than the quote's content, so they live here and a
  // quote points at them.
  //
  // quoteEmailReferences:  [{ id, name, phone, note? }] — past clients who
  //   have AGREED to take a call from a stranger. That consent is the whole
  //   reason this is a deliberate list a human types rather than a query over
  //   past clients: publishing a homeowner's phone number to a prospect
  //   because they once bought a deck is not a feature.
  // quoteEmailBeforeAfter: [{ id, beforeUrl, afterUrl, beforePublicId?,
  //   afterPublicId?, caption? }] — photo pairs, Cloudinary URLs.
  //
  // Null and [] mean the same thing here (no entries) and both are honest;
  // the three-state distinction that matters is on Quote, below.
  quoteEmailReferences  Json?
  quoteEmailBeforeAfter Json?

  // Whether a NEW quote starts with each section switched on. Default false,
  // not true: a company with nothing in the list would otherwise have every
  // quote stopped at the send gate by a section they never asked for. Turning
  // one on is how a company says "this belongs on my quotes".
  quoteEmailIncludeReferences  Boolean @default(false)
  quoteEmailIncludeBeforeAfter Boolean @default(false)

  pendingTeamProfiles PendingTeamProfile[]
  customFields        CustomField[]

  referralCode   String?   @unique
  referredByCode String?
  // When the referral was actually redeemed. Null on a company that arrived
  // organically, and also on one that arrived via a link but was blocked from
  // redeeming (see lib/referrals/grantCredit.js).
  referredAt     DateTime?

  referralInvitesSent ReferralInvite[] @relation("ReferralInvitesSent")
  referralCredits     ReferralCredit[] @relation("ReferralCreditsEarned")

  site              CompanySite?
  aiUsage           AiUsage[]
  // Per-company override of the plan's monthly AI token allowance. Null means
  // "use the plan's". 0 means "no AI at all" — distinct from null, which is
  // why this is nullable rather than defaulted.
  aiMonthlyTokenCap Int?

  // Stripe Connect — for this company to receive payments from ITS clients
  stripeAccountId      String?
  stripeOnboarded      Boolean @default(false)
  stripeChargesEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  // Added because the platform churn metric queried it and the field didn't
  // exist — every dashboard load 500'd. Note it changes on ANY edit, so
  // "churned this month" derived from it is approximate: a churned company
  // whose name is corrected months later re-enters the window. Good enough
  // for a directional number; if churn ever drives a decision that matters,
  // measure it off Subscription status changes or PlatformAuditLog instead.
  //
  // @default(now()) is required, not stylistic: without it Prisma can't add
  // the column to a table that already has rows, and the only remedy it
  // offers is --force-reset, which drops the database. The default backfills
  // existing companies; @updatedAt keeps it current from then on.
  updatedAt DateTime @default(now()) @updatedAt

  products Product[]

  members               Member[]
  clients               Client[]
  quotes                Quote[]
  invoices              Invoice[]
  // Cross-company quote imports (GC ↔ subcontractor). AsSource: our quotes that
  // other companies imported. AsTarget: other companies' quotes we imported.
  quoteImportsAsSource  QuoteImport[] @relation("QuoteImportSourceCompany")
  quoteImportsAsTarget  QuoteImport[] @relation("QuoteImportTargetCompany")
  appointments          Appointment[]
  tasks                 Task[]
  workAreas             WorkArea[]
  serviceCategories     CompanyServiceCategory[]
  customQuoteTypes      ServiceCategory[]
  marketingCampaigns    MarketingCampaign[]
  marketingDesigns      MarketingDesign[]
  documentTemplates     DocumentTemplate[]
  expenses              Expense[]
  expenseImportBatches  ExpenseImportBatch[]
  marketingSpends       MarketingSpend[]
  salaries              Salary[]
  debts                 Debt[]
  assets                Asset[]
  forecastSettings      ForecastSettings?
  workers               Worker[]
  shifts                Shift[]
  eventTypes            EventType[]
  funnels               Funnel[]
  jobs                  Job[]
  jobChecklistTemplates JobChecklistTemplate[]
  leadRequests          LeadRequest[]
  materials             Material[]
  notificationRules     NotificationRule[]
  aiDigests             AiDigest[]
  subscription          Subscription?
  instantQuoteConfigs   InstantQuoteConfig[]
  activityLogs          ActivityLog[]
  payRuns               PayRun[]
  salaryComponentDefs   SalaryComponent[]
  workingHours          WorkingHours[]
  leavePolicies         LeavePolicy[]
  leaveRequests         LeaveRequest[]

  postalCode   String?
  country      String?  @default("CA")
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  discoverable Boolean  @default(false)

  taxIdName         String? // e.g. "GST"
  taxIdNumber       String?
  /// Set when the company has told the onboarding card to stop asking for a
  /// tax registration number. NOT a claim that they are unregistered and not
  /// read by anything client-facing — it only suppresses one onboarding step.
  /// Only offered where lib/compliance/taxRegistration.js says the number is
  /// optional in that country, or where a mandatory e-invoicing regime means
  /// FieldQuo cannot deliver the thing being asked for anyway. Nullable
  /// because "never answered" and "said no" are different states, and padding
  /// the first into the second would silently hide the step from everyone.
  taxRegistrationDismissedAt DateTime?
  autoApplyLocalTax Boolean @default(true)

  /// Is this company registered for VAT? THREE states, and the nullability is
  /// the point:
  ///
  ///   true  — registered; the country's VAT rate applies to its invoices.
  ///   false — below the national registration threshold, so it charges no VAT.
  ///           A real, stated 0%.
  ///   null  — never asked. NOT the same as false.
  ///
  /// lib/tax/jurisdictions.js will not return a European rate on `null`,
  /// because both alternatives are wrong for a contractor who simply hasn't
  /// answered: assume registered and a sole trader under the threshold sends a
  /// homeowner a 21% line they must not charge; assume unregistered and a
  /// registered company under-collects and pays the difference themselves.
  /// So null resolves to "unknown" and the company's own default rate applies.
  ///
  /// Not derived from `taxIdNumber` being filled in, though it is tempting.
  /// An empty tax-ID box means the contractor hasn't typed it yet at least as
  /// often as it means they have no number — reading absence as an answer is
  /// how a field ends up asserting something nobody said.
  ///
  /// Only asked of companies in a VAT country; a Canadian or US company never
  /// sees the question and keeps null forever, which costs them nothing.
  vatRegistered Boolean?

  /// Offer clients pay-over-time financing (Affirm) at invoice checkout, on top
  /// of paying by card. Off by default: it's the company's call, it only works
  /// where their Stripe account has Affirm activated (US/CA), and it only shows
  /// for invoice amounts in Affirm's supported range — so the Stripe layer gates
  /// it and falls back to card so a mis-config can never break the pay link.
  offerFinancing Boolean @default(false)

  timezone     String? @default("America/Toronto")

  /// How many hours before an appointment to text the client a reminder. Null
  /// (the default) means OFF — a company opts in, because every reminder is a
  /// billable SMS the contractor pays for, and auto-texting every client
  /// without them choosing it is a surprise on the invoice, not a feature. The
  /// reminder cron does nothing for a company that hasn't set this.
  appointmentReminderHours Int?

  /// The company's OWN provisioned SMS-capable number (E.164), used as the
  /// "from" on client-facing texts so they come from the business, not the
  /// shared FieldQuo line. Null = use the shared system number (with the company
  /// name in the body). This is NOT a free-text field a company types their cell
  /// into — carriers block sending from a number you don't control — it's set
  /// only when a real SMS number has been bought or hosted for them.
  ///
  /// @unique because app/api/sms/inbound/route.js resolves "which company does
  /// this inbound STOP belong to" by matching the webhook's `To` against this
  /// column and nothing else — the same one-number-one-tenant guarantee
  /// CrewInboxNumber.e164 gives the crew line. Without the constraint, two
  /// companies typed into the same row would make that lookup ambiguous, which
  /// on an inbound webhook means "whichever row Postgres returns first" —
  /// silently filing one company's opt-out against another's clients.
  smsFromNumber String? @unique
  dateFormat   String? @default("MM/DD/YYYY")
  weekStartsOn Int?    @default(0) // 0 = Sunday, 1 = Monday
  // The currency this company BILLS ITS CLIENTS in — quotes, invoices, the
  // client pay flow. ISO 4217 code (USD, CAD, EUR, GBP…). Defaults to CAD to
  // preserve the behaviour of every row that predates this column (the app was
  // hardcoded CAD). Distinct from FieldQuo's own subscription currency.
  // See lib/currency.js for the supported set and Stripe mapping.
  currency     String? @default("CAD")
  // Whether this company bills clients OUTSIDE its own country. Off by default:
  // a company only serving its home country bills in one currency (derived from
  // `country`), and the currency picker is hidden so a Canadian shop is never
  // asked to choose between CAD/USD/EUR. Turned on only when they say they serve
  // abroad — then they may pick a billing currency. See lib/currency.js.
  servesAbroad Boolean @default(false)

  // When the business is OPEN — deliberately not AvailabilitySchedule, which
  // hangs off a user and answers "when can this person be booked". The two
  // diverge whenever someone takes a day off, and a website that says CLOSED
  // because one estimator is on holiday is worse than no hours at all.
  //
  // Shape: [{ day: 0-6, closed: bool, open: "HH:MM", close: "HH:MM" }] × 7.
  // Validated on the way in and out by lib/company/businessHours.js — nothing
  // should read this column without going through normaliseHours().
  //
  // Null means "never told us", which the site renders as nothing. Seven
  // closed days would mean "we are shut all week", and conflating the two puts
  // a false CLOSED on a working company's Google listing.
  // How long a site visit / consultation takes, in minutes.
  //
  // ensureConsultationEventType used to hardcode 60, so every auto-created
  // booking slot was an hour whatever the trade — a 15-minute quote call and a
  // two-hour kitchen measure got the same window, and there was nowhere to say
  // otherwise. One company-level answer, used as the default for new event types
  // and settable per event type after that.
  defaultVisitMinutes Int @default(60)

  // How a client may meet this company: "call", "visit", "video".
  //
  // EventType.location was a free-text string ("Phone or on-site visit"), which
  // is a label rather than a choice — the visitor couldn't say which they wanted
  // and the company couldn't offer one without the other. A roofer doing a
  // satellite estimate wants calls; a cabinet maker measuring a kitchen needs to
  // be in the room. Both is common too.
  //
  // Empty array means "not stated", which the booking page treats as visit-only
  // rather than inventing options: the default for a field trade is that someone
  // comes out.
  bookingModes String[] @default(["visit"])

  // ── What a client may do to a booking after making it ────────────────────
  //
  // Hours of notice the CREW needs. Inside this window the client can no longer
  // cancel or move a visit themselves and has to ring — the day is planned.
  // 24 by default rather than 0: an unset value must not mean "changeable
  // until the van pulls up".
  bookingChangeNoticeHours Int @default(24)

  // Whether cancelling in time returns a visit fee that was already paid. OFF
  // by default: the fee is the contractor's money as soon as it is taken, and a
  // public link that returns it because nobody picked a default is a control
  // spending someone else's money. Cancelling still works when this is off —
  // the slot frees, the company is told, and the screen says the fee is not
  // automatically returned.
  refundVisitFeeOnCancel Boolean @default(false)

  // Hours of notice the MONEY needs, when refunds are on. Allowed to be longer
  // than the change window, which is the case worth supporting: "move it up to
  // a day before, but the deposit only comes back with two days' notice."
  // Null falls back to bookingChangeNoticeHours.
  refundCutoffHours Int?

  businessHours Json?

  sitePublished Boolean   @default(false)
  taxRates      TaxRate[]

  authOrgId String? @unique

  quickAddItems QuickAddItem[]

  defaultMaterialMarkupPercent Decimal @default(40) @db.Decimal(6, 3)

  materialRecipeSettings MaterialRecipeSetting[]
  followUpRules          FollowUpRule[]
  marketingSubscribers   MarketingSubscriber[]

  voiceNumbers  VoicePhoneNumber[]
  voiceAgent    VoiceAgent?
  voiceCalls    VoiceCall[]
  voiceCredits  VoiceCreditEntry[]
  voiceAutoTopup VoiceAutoTopup?
  aiCreditBundle AiCreditBundle?
  callConsents  CallConsent[]
  smsOptOuts    SmsOptOut[]

  /// Where a happy customer should leave a review. Usually a Google review
  /// link. Null means we don't ask — a review request with nowhere to go is
  /// worse than none, because it spends the goodwill and returns nothing.
  reviewUrl String?

  /// Hours to wait after a job is finished before asking. Same day is too soon
  /// — the crew may still be packing the van — and a week later they've stopped
  /// thinking about it.
  reviewDelayHours Int @default(24)

  /// Off by default. Nobody should discover that their customers are being
  /// messaged automatically.
  reviewRequestsEnabled Boolean @default(false)

  /// Padding added on top of driving time between appointments: parking,
  /// unloading, writing up the last job. Zero by default because inventing a
  /// number here silently removes bookable slots the contractor never agreed
  /// to give up.
  travelBufferMinutes Int @default(0)

  /// Whether unreachable slots are hidden from the public booking page.
  /// On by default — a slot nobody can drive to is worse than no slot — but a
  /// contractor working one small town can switch the whole thing off.
  travelCheckEnabled Boolean @default(true)

  /// Half-width of the arrival window shown to CLIENTS, in minutes.
  ///
  /// 15 turns "2:00 PM" into "between 1:45 and 2:15 PM" on their confirmation.
  /// Zero — the default — means an exact time, because promising a window
  /// nobody agreed to is a change to what the customer was told.
  ///
  /// Client-facing only. The crew's own schedule keeps the real time: an
  /// estimator told "between 1:45 and 2:15" cannot plan a day, and the whole
  /// point of the window is that it absorbs the slack the ROUTE has, which
  /// only the exact times make visible.
  arrivalWindowMinutes Int @default(0)

  /// A sales demo account, not a real customer.
  ///
  /// Load-bearing in three places, which is why it's a column and not a naming
  /// convention on `name`: platform analytics exclude these (ten seeded
  /// companies would otherwise read as ten signups), billing never chases them,
  /// and — most importantly — the demo reset refuses to touch any company where
  /// this is false. A reset wipes quotes, jobs and invoices; it must be
  /// impossible to point at a real tenant.
  /// When a quote a client requested is approved, ring them to confirm and
  /// schedule. Off by default — an automated sales call is a decision the owner
  /// makes deliberately, not a default they discover.
  outboundCallsEnabled Boolean @default(false)

  /// WHICH quotes the callback above applies to:
  /// `instant_estimates` | `all_quotes` | `off`. See lib/voice/quoteCallScope.js.
  ///
  /// The default is the behaviour that already shipped, not the most useful
  /// one. This trigger was written for instant estimates only, and a company
  /// that switched outbound calls on under that rule must not find the
  /// assistant ringing every customer they hand-wrote a quote for because a
  /// release widened the scope underneath them.
  ///
  /// `off` is NOT outboundCallsEnabled = false: that switch also governs
  /// appointment reminders and new-enquiry follow-ups, and this turns off the
  /// quote closer alone — the one call that reads a price back.
  outboundQuoteCallScope String @default("instant_estimates")

  /// The crew-messaging inbox: crew text photos/updates to a number and the
  /// assistant files them to the right job. Off by default. See lib/crew/.
  ///
  /// Written by claiming/releasing a crew line (app/api/crew/line) — the flow
  /// that also wires the number's SMS webhook. It is NOT an independent switch:
  /// on without a CrewInboxNumber is the exact state that let a contractor turn
  /// this on and text a number nothing was listening to.
  crewInboxEnabled Boolean @default(false)

  /// A yearly revenue target the owner sets. Null means "no goal set", which is
  /// distinct from zero — the dashboard shows the goal card only when this
  /// exists, rather than inventing a target nobody chose. Monthly and weekly
  /// figures are DERIVED (see lib/analytics/goal.js), never stored, so they
  /// can't drift from the annual number.
  revenueGoalAnnual Decimal? @db.Decimal(12, 2)

  /// Per-company overrides for the text messages CLIENTS receive, keyed by
  /// type: { on_my_way: "Hi {name}, {worker} from {company} is on the way." }.
  /// Absent or a missing key means the built-in wording is used — see
  /// lib/sms/renderTemplate.js. Only tokens on the type's whitelist are allowed,
  /// so a saved template can never reference a field that renders as a literal
  /// "{price}" to a customer.
  smsTemplates Json?

  /// Financing offer shown on estimates, or absent/disabled for the many
  /// contractors who don't finance. { enabled, note, url }. FieldQuo computes
  /// NO payment figure — see lib/estimate/financing.js. url present = a real
  /// provider hand-off; otherwise it's a plain "ask us".
  financing Json?

  isDemo Boolean @default(false)

  // ── Account standing (seat-sharing guard) ────────────────────────────────
  //
  // active | under_review | restricted.
  //
  // `under_review` IS A FLAG FOR A HUMAN, NOT A LOCKOUT. Nothing in the app
  // may deny access, hide data or block a write because of this value without
  // a product decision — the detector is a heuristic over a coarse device
  // fingerprint (see lib/security/deviceGuard.js) and it will be wrong about
  // some paying customer. It exists so a FieldQuo admin gets told to go and
  // look, and so the customer sees an honest banner instead of being cut off
  // by a rule nobody explained. The banner in app/components/layout is
  // deliberately non-blocking for the same reason.
  //
  // `restricted` is reserved for a decision a person has already made and can
  // only ever be set by hand; nothing writes it automatically.
  //
  // Separate from onboardingStatus (lifecycle) and from the billing gate
  // (payment). Folding this into either would have coupled "we suspect seat
  // sharing" to machinery that already denies access, which is exactly the
  // outcome this must not have.
  accountStatus       String    @default("active")
  accountReviewedAt   DateTime?
  accountReviewReason String?

  abuseStrikes AccountAbuseStrike[]

  /// Which industry preset this demo is currently dressed as
  /// (see lib/demo/industries.js). Null on real companies.
  demoIndustry String?
  voiceCallTasks VoiceCallTask[]
  crewMessages CrewInboundMessage[]
  crewLine     CrewInboxNumber?
  jobPhotos JobPhoto[]

  /// Per-company AVAILABILITY overrides. Not to be confused with the adoption
  /// booleans above (aiCopilotEnabled, crewInboxEnabled, outboundCallsEnabled,
  /// sitePublished, discoverable…) — those are the CONTRACTOR's switches. See
  /// lib/features/registry.js for why the two axes stay separate.
  featureOverrides CompanyFeatureOverride[]

  /// The bio-link page (/l/<slug>). Optional: no row means the page is live
  /// with the defaults derived from what the company already has — see
  /// lib/links/candidates.js — which is what makes it work the moment a
  /// contractor pastes the URL, without a setup step they'd have to be told
  /// about first.
  linkPage LinkPage?

  /// Recurring work sold as a package — see the ServicePlan model.
  servicePlans ServicePlan[]
}

/// Configuration for the bio-link page at /l/<slug> — the single link an
/// Instagram or TikTok profile allows, pointing at everything a contractor can
/// send traffic to.
///
/// ── Why so few columns ──────────────────────────────────────────────────────
///
/// Almost nothing about this page is stored. WHICH links exist is derived at
/// request time from active event types, enabled estimators, published funnels
/// and the company's own contact columns, so publishing a funnel makes it
/// appear and deleting one makes it vanish — no copy here to go stale, and no
/// way for this table to promise a link that 404s.
///
/// `items` is therefore an ORDERED OVERRIDE LIST, not the list:
/// [{ key, enabled, label?, url? }]. A key it doesn't mention keeps its
/// derived default and appends in the natural order. Shape and sanitising live
/// in lib/links/config.js, which is the boundary between what a browser sent
/// and what a stranger is served.
model LinkPage {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Off takes the page down (404), for a company that doesn't want one.
  /// Defaults to true so the URL works before anyone visits Settings.
  published Boolean @default(true)

  /// Shown instead of the company name, and only when they wrote one. Null
  /// means "use the company name", not "no heading".
  headline String?
  /// One line under it. Null renders nothing — FieldQuo does not write a
  /// sentence about a business it hasn't been told about.
  bio      String?

  items Json?

  createdAt DateTime @default(now())
  /// @default(now()) alongside @updatedAt for the same reason Company.updatedAt
  /// carries one: without it Prisma cannot add a required column to a table
  /// that already has rows.
  updatedAt DateTime @default(now()) @updatedAt
}

// Per-company overrides on top of the built-in defaults in
// app/data/materialRecipes.js — lets a shop punch in its own primer/top-coat
// coverage rates, per-gallon costs, coat counts, consumable costs, and
// labour minutes instead of using the TrueFinish-derived starting numbers.
// `overrides` only needs to contain the keys the company changed; the
// resolver in materialRecipes.js merges this on top of the shared default
// recipe for that categoryKey. One row per company per category.
model MaterialRecipeSetting {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryKey String
  overrides   Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([companyId, categoryKey])
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  // Better Auth's two-factor plugin owns this flag and is the only thing that
  // writes it — it is `input: false` in the plugin's schema, so it can't be set
  // through a signup or a profile update. False for everyone until they enable
  // 2FA themselves; see the plugin block in lib/auth.js for why it is opt-in.
  twoFactorEnabled Boolean @default(false)
  // Interface language for this person. Null means "follow the company
  // default" — a crew member who never opens settings inherits whatever the
  // company set, and changing the company default moves them with it.
  // Storing "en" explicitly would freeze them, which is a different thing.
  language      String?
  // Per-user UI state that isn't worth its own table: which first-visit tours
  // this person has seen, dismissed hints, etc. Server-side (not just
  // localStorage) so a tour a rep already dismissed doesn't re-appear when they
  // open the app on the shop iPad. Shape: { seenTours: string[] }.
  uiState       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orgMemberships OrgMember[]

  memberships           Member[]
  sessions              Session[]
  accounts              Account[]
  quotesCreated         Quote[]                @relation("QuoteCreatedBy")
  quotesAssigned        Quote[]                @relation("QuoteAssignee")
  invoicesCreated       Invoice[]              @relation("InvoiceCreatedBy")
  appointmentsCreated   Appointment[]          @relation("AppointmentCreatedBy")
  appointmentsAssigned  Appointment[]          @relation("AppointmentAssignee")
  tasksCreated          Task[]                 @relation("TaskCreatedBy")
  tasksAssigned         Task[]                 @relation("TaskAssignee")
  timeEntriesApproved   TimeEntry[]            @relation("TimeEntryApprovedBy")
  workAreaAssignments   WorkAreaAssignment[]
  availability          AvailabilitySchedule[]
  workingHours          WorkingHours[]
  eventTypes            EventType[]
  jobVisitsAssigned     JobVisit[]             @relation("JobVisitAssignee")
  jobMaterialsPurchased JobMaterial[]          @relation("JobMaterialPurchaser")
  shiftOverrides        Shift[]                @relation("ShiftAvailabilityOverride")
  workerProfile         Worker?
  campaignsAssigned     MarketingCampaign[]    @relation("CampaignAssignee")
  pamphletStopsAssigned PamphletStop[]         @relation("PamphletStopAssignee")
  leadsAssigned         LeadRequest[]          @relation("LeadAssignee")
  leadNotes             LeadNote[]             @relation("LeadNoteAuthor")
  funnelsCreated        Funnel[]               @relation("FunnelCreatedBy")
  devices               AccountDevice[]
  twoFactors            TwoFactor[]
}

// One row per (user, company) — this is YOUR RBAC join, separate from Better Auth's OrgMember
model Member {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      MemberRole @default(employee)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  phone            String?
  address          String?
  city             String?
  province         String?
  postalCode       String?
  country          String?
  imageUrl         String?
  laborCostPerHour Decimal? @db.Decimal(10, 2)
  permissions      Json?

  invitationLanguage String? @default("en")

  @@unique([userId, companyId])
}

model PendingTeamProfile {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email              String
  name               String?
  phone              String?
  address            String?
  city               String?
  province           String?
  postalCode         String?
  country            String?
  imageUrl           String?
  laborCostPerHour   Decimal? @db.Decimal(10, 2)
  permissions        Json?
  // The granular FieldQuo role (admin/supervisor/employee) captured at invite
  // time. Better Auth's invitation can only carry admin/member, so this is the
  // only place the supervisor/employee distinction survives until the invite is
  // accepted and Member.role is written — see the invite routes and the accept
  // route. Nullable String, not the MemberRole enum, so an older pending row
  // with no role reconciles harmlessly.
  role               String?
  invitationLanguage String?  @default("en")
  createdAt          DateTime @default(now())

  @@unique([companyId, email])
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// One row per user who has turned on two-factor authentication. Absence of a
// row is the "off" state — User.twoFactorEnabled mirrors it for the session
// object, but this table is where the secret actually lives.
//
// Shape dictated by better-auth/plugins/two-factor (schema.mjs); the field
// names are the plugin's, not ours, and renaming one silently breaks it.
// Deliberately NOT carrying createdAt/updatedAt: the plugin declares neither,
// so nothing would ever write them and a support question they look like they
// could answer ("when did this get switched on?") would get an answer that
// isn't true.
model TwoFactor {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The TOTP shared secret and the one-time backup codes, both encrypted by
  // the plugin with BETTER_AUTH_SECRET before they get here. Marked
  // `returned: false` in the plugin schema, so neither ever reaches a client.
  secret      String
  backupCodes String

  // False only in the window between scanning the QR code and typing the first
  // correct code. Enrolment that is started and abandoned therefore cannot lock
  // anyone out of their own account.
  verified Boolean @default(true)

  // Brute-force ceiling on a six-digit code, enforced by the plugin's
  // accountLockout across every challenge and factor: ten consecutive failures
  // locks the account for fifteen minutes, and one success resets the count.
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  // Both indexed because the plugin looks a row up by each: by userId at
  // sign-in, and by secret when verifying.
  @@index([userId])
  @@index([secret])
}

// ── Seat-sharing guard ─────────────────────────────────────────────────────
//
// One coarse row per (user, device setup). Written by lib/security/deviceGuard.js
// so we can answer ONE question: how many genuinely different setups is a
// single login being used from?
//
// NOT Session. Better Auth's Session table already holds ipAddress/userAgent,
// and reusing it was the obvious first idea — but sessions are created and
// destroyed on every sign-in, expiry and cookie clear, so counting them counts
// LOGINS, not people. A contractor who signs in every morning on the same phone
// would look like thirty devices in a month. This table collapses repeat visits
// from the same setup onto one row, which is the only shape that makes
// "how many different setups" a real number.
//
// deviceHash is a truncated SHA-256 of user-agent + accept-language. It is a
// heuristic, not an identity: two identical iPhones on the same iOS version
// hash the SAME (so this UNDER-counts a uniform crew), and one person changing
// browser, clearing it, or taking an OS update hashes DIFFERENT. That
// asymmetry is deliberate — see the thresholds in deviceGuard.js.
model AccountDevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Denormalised from Member so the abuse query can group by tenant without a
  // join. No FK: a device row surviving a company delete is harmless, and the
  // cascade from User already covers the case that matters.
  companyId String

  deviceHash String
  userAgent  String?
  // Last seen source IP. Kept whole because support reviewing a flagged account
  // needs to tell "two networks in one town" from "four cities at once", and a
  // pre-truncated prefix can't answer that. Never shown raw in the platform
  // console — only the /16 network is rendered there.
  lastIp String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, deviceHash])
  @@index([companyId])
}

// One recorded suspicion. A strike is EVIDENCE, not a punishment — nothing in
// the app reads these to deny anything. Three inside 30 days flips the company
// to `under_review`, which is a note for a human.
model AccountAbuseStrike {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Nullable so a future company-wide signal (one that isn't attributable to a
  // single login) can be recorded here without inventing a user to blame.
  userId String?

  // distinct_devices | concurrent_networks
  kind String
  // The numbers behind the call: counts, the window, the /16 networks involved.
  // Json so a new signal can record what's actually useful without a migration,
  // and so support can see WHY rather than trusting the word "strike".
  detail Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

// ── Better Auth organization plugin — separate from your own Member/Company models ──

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members     OrgMember[]
  invitations Invitation[]
}

// Renamed from Better Auth's default "member" to avoid colliding with your own Member table
model OrgMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime     @default(now())
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
}

// ============================================================
// CLIENTS / QUOTES / INVOICES / PAYMENTS
// ============================================================

model Client {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  // individual = a homeowner / end customer whose jobs are at their own
  // address; company = another business (e.g. a general contractor) that
  // hires this company across many DIFFERENT job sites, so `address` is just
  // their office and the real work location is set per quote/job instead.
  type        ClientType @default(individual)
  // For company clients: the person you actually deal with there. Null for
  // individuals (the client IS the person).
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  province    String?
  /// ISO-3166 alpha-2, and the reason lib/tax/jurisdictions.js can answer at
  /// all. Without it "ON" is two letters, not Ontario — it could be a province,
  /// a foreign region, or a typo, and picking Canada because most tenants are
  /// Canadian would put a 13% rate on a quote for someone who owes something
  /// else entirely.
  ///
  /// Null on every row that predates this column, and deliberately NOT
  /// backfilled. Stamping "CA" across the existing table would turn a guess
  /// into stored data and make it un-auditable a week later; instead a null
  /// country resolves to "unknown" and the company's own default rate applies,
  /// which is exactly what those clients get today. It fills in as clients are
  /// edited — the address autocomplete has always returned country and simply
  /// had nowhere to put it.
  country     String?
  notes       String?
  // Language this client is written to in. Drives quote/invoice PDFs, emails
  // and the client portal. Null falls back to Company.defaultLanguage.
  //
  // This is the field that makes translation worth building: a contractor
  // whose crew works in English can still send a Punjabi-speaking homeowner a
  // quote they can actually read.
  language    String?
  portalToken String?    @unique
  createdAt   DateTime   @default(now())

  quotes        Quote[]
  invoices      Invoice[]
  jobs          Job[]
  referralLinks ReferralLink[]
  appointments  Appointment[]
  tasks         Task[]
  pamphletStops PamphletStop[]
  servicePlans  ServicePlan[]
}

enum ClientType {
  individual
  company
}

model Quote {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteNumber String
  status      QuoteStatus @default(draft)
  language    String      @default("en")
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id])
  createdById String?
  createdBy   User?       @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  // Who is working this quote — distinct from createdById, which never
  // changes hands. Defaults to the creator on the normal builder (see
  // POST /api/quotes) and stays null when nobody could be named, which is
  // the honest outcome for an auto-estimated draft: nobody was signed in
  // when the instant-quote flow created it. needsReview carries that case
  // into the review queue rather than this column inventing an owner.
  // Reassigning to someone else requires "quote:assign" — the same rule
  // Appointment.assignedToId enforces (lib/permissions.js).
  assignedToId String?
  assignedTo   User?       @relation("QuoteAssignee", fields: [assignedToId], references: [id])

  lineItems    Json?
  clientPhotos Json?
  subtotal     Decimal   @default(0) @db.Decimal(12, 2)
  discount     Decimal   @default(0) @db.Decimal(12, 2)
  tax          Decimal   @default(0) @db.Decimal(12, 2)
  total        Decimal   @default(0) @db.Decimal(12, 2)
  taxEnabled   Boolean   @default(true)
  notes        String?
  // INTERNAL. Never rendered on a client-facing surface — `notes` above is the
  // one the homeowner reads (lib/documentSections/NotesSection.js), and this is
  // deliberately a second field rather than a prefix on that one.
  //
  // What it holds: what a caller asked for that the draft could not place on
  // the quote. A phone lead says "and maybe new handles, I'm not sure"; the
  // request has to survive to whoever reviews the draft, and it must not
  // survive onto the PDF, where "we couldn't work out what you meant" is an
  // apology nobody asked for. See lib/ai/callQuoteDraft.js reviewNotesFromDraft.
  reviewNotes  String?
  /// The phone call this quote was drafted from, if any — VoiceCall.id.
  ///
  /// A plain column, not a relation, for the same reason VoiceCall.leadId is
  /// one: the link is only ever followed in one direction and a relation would
  /// hang a `quotes` list off a call that nothing reads.
  ///
  /// It holds an ID and never a URL, and that is the whole design. The
  /// recording it leads to is a Retell BEARER link — nothing signs it, proxies
  /// it or expires it, so the string alone plays a customer's phone call with
  /// no session (lib/voice/recording.js). A URL on THIS row would ride along on
  /// every client-facing read that loads the quote whole and filters afterwards
  /// — app/api/public/quotes/[token] does exactly that — and a quote is the one
  /// document in this product that gets forwarded and printed. An id is useless
  /// to a stranger; /api/voice/calls/[id]/recording is what turns it into audio,
  /// for a signed-in member of the owning company only.
  sourceCallId String?
  validUntil   DateTime?
  pdfUrl       String?

  quoteType    String?
  scopeDetails Json?

  shareToken          String?   @unique
  // Written by /api/kitchen-design/[token] and read by nothing. The UI and the
  // public approval route both use `clientDesignAt` (the timestamp) instead, which
  // carries the same fact plus when it happened. Two representations of one event,
  // one of them never consulted — trust clientDesignAt, not this.
  clientDesignSaved   Boolean   @default(false)
  clientDesignAt      DateTime?
  clientKitchenConfig Json?

  // ── Email trail ─────────────────────────────────────────────────────────
  // What was actually sent, to whom, and when.
  //
  // sentAt used to be set by the "Send" button, which only changed the status
  // and never sent anything — so the field recorded an intention, not an
  // event. These are written only after Resend accepts the message, which
  // makes them safe to show a client-facing claim like "Emailed 3 July".
  sentAt         DateTime?
  // The address it went to, captured at send time. A client whose email is
  // corrected later must not make an old record claim the quote went
  // somewhere it didn't.
  sentToEmail    String?
  followUpSentAt DateTime?
  followUpCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  scopeGroups  QuoteScopeGroup[]
  appointments Appointment[]
  tasks        Task[]
  jobs         Job[]
  // The lead this quote was converted from, if any — the real link the old fake
  // "Start quote" button never made. Lets a lead show "quoted" and a quote trace
  // back to who asked. Optional: most quotes are created from scratch.
  lead         LeadRequest? @relation("LeadQuote")

  // Cross-company quote import (general-contractor ↔ subcontractor). See model
  // QuoteImport. As SOURCE: this quote was sent to another FieldQuo company who
  // pulled it into their own quote as a marked-up cost. As TARGET: this quote
  // pulled other companies' quotes in as cost lines.
  importsAsSource QuoteImport[] @relation("QuoteImportSource")
  importsAsTarget QuoteImport[] @relation("QuoteImportTarget")

  calledAt DateTime?

  tierGroupId String? // shared ID linking Good/Better/Best variants together
  tierLabel   String? // "good" | "better" | "best"

  // ── Optional extras the client can add at approval time ────────────────
  addOns QuoteAddOn[]

  // What this quote was estimated to cost when it was priced. A separate row,
  // never a column — see model QuoteCosting for why that is structural here.
  costing QuoteCosting?

  // What the client ACTUALLY approved, including any add-ons they ticked.
  // Deliberately separate from `total`: total is what the company quoted, and
  // overwriting it would destroy the record of what was originally offered.
  // The invoice is built from this when it's set.
  //
  // Null until someone accepts. A quote accepted with no add-ons still sets
  // it — "accepted at the quoted price" and "never accepted" are different
  // facts and shouldn't share a representation.
  acceptedTotal    Decimal? @db.Decimal(12, 2)
  acceptedSubtotal Decimal? @db.Decimal(12, 2)
  acceptedTax      Decimal? @db.Decimal(12, 2)

  // "What happens next" — timelines, access, payment schedule, warranty. The
  // single most common gap in a quote that doesn't get signed: the price was
  // fine, the client just didn't know what they were committing to. Seeded
  // from Company.defaultProcessNotes so it's written once, then editable per
  // quote because a two-day repair and a three-week reno need different words.
  processNotes String?

  // ── Per-quote control of the two optional email sections ────────────────
  //
  // THREE states, and the third is the point. NULL means "follow the company
  // default", so a company that adds references next month gets them on the
  // drafts already sitting in the pipeline; `true`/`false` mean this quote was
  // decided on its own and stops following. Collapsing this to a Boolean with
  // a default would freeze every existing draft at whatever the company
  // setting happened to be the day it was written.
  emailIncludeReferences  Boolean?
  emailIncludeBeforeAfter Boolean?

  // Per-quote CONTENT, when this quote shouldn't use the company list — the
  // referee who did this exact kitchen, the before/after from this street.
  // NULL means "use the company's". An empty array is deliberately NOT a way
  // to remove a section: it is an included-but-empty section, which is exactly
  // what the send gate refuses to let out (lib/quotes/emailSections.js).
  // Removing a section is turning the flag above off.
  emailReferences  Json?
  emailBeforeAfter Json?

  // Last AI review. Stored rather than recomputed so reopening the quote
  // doesn't spend tokens again, and so a review can be dismissed item by item
  // without re-running. Shape: see lib/ai/quoteReview.js.
  aiReview     Json?
  aiReviewedAt DateTime?

  // Every PAID deep photo read — see lib/ai/visionPass.js. A separate column
  // from aiReview above, and a deliberately different shape: aiReview is
  // OVERWRITTEN on every re-run because nothing was paid for the discarded
  // copy, but a deep read costs real credit (VISION_PASS_CENTS) each time it
  // runs, and silently discarding one an estimator already paid for the
  // moment they run a second is the same "wrote it, never showed it" failure
  // AGENTS.md warns about, one step later. So passes ACCUMULATE — newest
  // first, see app/api/quotes/[id]/vision/route.js — and every earlier read
  // stays on record alongside what it cost.
  //
  // Append-only in a second sense too: nothing here is ever copied onto
  // lineItems, notes or scopeGroups automatically. It is the estimator's own
  // decision to act on a note, exactly like the free photoNotes above.
  aiVisionPasses Json?

  // ── Instant estimate provenance & review gate ───────────────────────────
  // Set when a quote was born from the public instant estimator rather than
  // typed by staff. The homeowner saw a RANGE and the company must confirm it
  // before it's binding — so an auto-estimated quote lands here in `draft`
  // with needsReview=true, and the review queue is the only path to `sent`.
  //
  // These are deliberately distinct from status: a normal draft a rep is still
  // editing is not "awaiting approval", and must not clutter the review queue.
  autoEstimated  Boolean   @default(false)
  needsReview    Boolean   @default(false)

  // ── Electronic signature (the approval itself) ──────────────────────────
  // When a client signs, THIS is the acceptance — the signature is the intent,
  // not a button. One Json audit blob, written once and read whole:
  //   { name, signatureDataUrl, signedAt, ip, userAgent, documentHash, consent }
  // documentHash is a sha256 of the exact quote content at signing time, so a
  // later edit can't silently change what was agreed — the tamper-evidence that
  // gives a self-built simple electronic signature the same standing the paid
  // providers charge for. Null until signed.
  signature      Json?
  // How the numbers were derived, for the reviewer's trust: e.g.
  // "google_solar", "lawn_polygon", "manual". Free-form, not an enum, because
  // new trades add sources without a migration.
  estimateSource String?
  /// Seconds a human actually spent BUILDING this quote — active time, not
  /// wall-clock.
  ///
  /// createdAt → sentAt cannot answer "how fast can you quote": on the eight
  /// real quotes in production it ranged from 0 minutes to 146 hours, because
  /// it measures a contractor starting a quote on Monday and sending it on
  /// Wednesday. Work time and idle time are indistinguishable in it.
  ///
  /// This is measured client-side by lib/analytics/composeTimer.js, which
  /// stops counting when the tab is hidden or the user goes idle. It is
  /// therefore a LOWER bound on effort and an honest one — the failure mode is
  /// under-counting a distracted user, never inflating the number that ends up
  /// in a marketing claim.
  ///
  /// Null for every quote created before this existed, and for any client that
  /// doesn't report it. Absence is not zero, and no average may treat it as
  /// zero.
  composeSeconds Int?

  /// WHEN the client said yes or no.
  ///
  /// `status` records the outcome and threw away the date, so the single most
  /// useful sales number a contractor can be told — how long your clients take
  /// to decide — was unmeasurable. `updatedAt` cannot stand in: it moves on
  /// every edit, including edits made months after the decision.
  ///
  /// Stamped by lib/quotes/quoteLifecycle.js, which both the public approval
  /// link and the back-office status change already funnel through. Null on
  /// every quote decided before this existed — absence is not "decided
  /// instantly", and any average must drop nulls rather than treat them as
  /// zero.
  acceptedAt DateTime?
  declinedAt DateTime?

  /// Why it was lost, when anyone says.
  ///
  /// "You lose 60% of quotes on price" and "you lose 60% on timing" describe
  /// two completely different businesses and call for opposite responses. A
  /// win rate alone tells a contractor they are losing and nothing about what
  /// to change.
  ///
  /// Optional and free text on purpose: a required dropdown gets whatever is
  /// nearest the cursor, which is worse than no data. Null means nobody said,
  /// and no report may infer a reason from silence.
  declineReason String?


  // Snapshot of what produced the figure — measurements (squares, pitch,
  // area), the satellite image URL, the chosen material key, the computed
  // range and breakdown. Kept verbatim so the reviewer sees exactly what the
  // homeowner saw, and a later imagery change can't rewrite history.
  estimateData   Json?
  // Audit stamp for who approved. Plain id, not a relation: this is a record
  // of an event, never joined on, and adding a User back-relation for it would
  // churn the auth models for no query we run.
  reviewedById   String?
  reviewedAt     DateTime?

  // Visits booked off the back of this quote. A list rather than one, because a
  // client can cancel and book again and the history is worth keeping.
  bookings       Booking[]  @relation("BookingQuote")

  @@unique([companyId, quoteNumber])
}

// A quote received FROM another FieldQuo company, pulled INTO this company's own
// quote as a marked-up cost line. The cross-company join for the general
// contractor ↔ subcontractor flow: a GC imports an electrician's quote, marks it
// up, and it becomes a line on the GC's own quote to the homeowner, plus an
// internal subcontractor cost that feeds job costing.
//
// Read by BOTH tenants, projected differently (see lib/quotes/importedStatus.js):
//  • the importer (GC) sees the cost, the markup and the client price;
//  • the source (sub) sees only THAT they were imported and the DERIVED
//    pending/confirmed status — never the GC's markup or homeowner price.
//
// Commit status is NOT a column here. It is DERIVED from the importing quote's
// stage (draft/sent = pending; accepted / has a job / invoiced = confirmed), so
// the two can never disagree — a stored "confirmed" boolean is exactly the
// write-once-read-never dead field this codebase keeps having to hunt down.
model QuoteImport {
  id String @id @default(cuid())

  // ── Source: the subcontractor's quote being imported ──────────────────────
  sourceQuoteId   String
  sourceQuote     Quote   @relation("QuoteImportSource", fields: [sourceQuoteId], references: [id], onDelete: Cascade)
  // Denormalised so a sub can list "who imported my quotes" without reaching
  // across into the GC's tenant.
  sourceCompanyId String
  sourceCompany   Company @relation("QuoteImportSourceCompany", fields: [sourceCompanyId], references: [id], onDelete: Cascade)

  // ── Target: the GC's own quote it was added to ────────────────────────────
  targetQuoteId   String
  targetQuote     Quote   @relation("QuoteImportTarget", fields: [targetQuoteId], references: [id], onDelete: Cascade)
  targetCompanyId String
  targetCompany   Company @relation("QuoteImportTargetCompany", fields: [targetCompanyId], references: [id], onDelete: Cascade)

  // The `id` stamped on the line we appended to targetQuote.lineItems JSON, so
  // an edit or removal can find that exact line again.
  targetLineId String

  // Snapshot of the sub's price at import time, in the GC's currency. A COPY, on
  // purpose: the sub editing their quote later must not silently move a cost the
  // GC already booked. The backlink (sourceQuoteId) is how the GC still reaches
  // the live original.
  snapshotAmount Decimal @db.Decimal(12, 2)

  // Markup the GC applies on top of snapshotAmount to reach the client price.
  // A percent (0/10/20/30 or custom). Client price is DERIVED — snapshot ×
  // (1 + pct) — computed server-side, never accepted from the browser.
  markupPercent Decimal @default(0) @db.Decimal(6, 2)

  // How it appears on the GC's quote to the homeowner. "blended" = folded into
  // one line per trade at the client price (default); "itemized" = its own
  // visible line. The homeowner never sees the sub or the markup either way.
  display String @default("blended")

  // Optional label for the trade/line ("Electrical", "Countertops") so the GC
  // can tell competing options apart before committing one.
  label String?

  // The Expense this cost was materialised into once the GC quote became a job,
  // so it flows into job costing / margin. Null until a job exists. Kept as a
  // link (not a boolean) so materialisation is idempotent — a second run sees
  // it's already set — and so removing the import can delete the expense too.
  // Not a relation: Expense.projectId is a loose job id, and we don't want an
  // Expense delete to cascade back here.
  expenseId String?

  createdAt   DateTime @default(now())
  createdById String?

  // A given source quote lands in a given target quote at most once.
  @@unique([targetQuoteId, sourceQuoteId])
  @@index([sourceCompanyId])
  @@index([targetCompanyId])
}

// An optional extra offered at the bottom of a quote.
//
// A separate table rather than a Json column on Quote, for one reason: the
// price has to be trustworthy. When a client ticks "add gutter guards", the
// server recomputes the total from THESE rows — never from a figure the
// browser sent. A Json blob would work equally well for display and equally
// badly for that, since the whole point is having a server-side record of
// what each option costs that the client cannot influence.
model QuoteAddOn {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  description String
  // One line on why it's worth having. Optional, but an add-on without it
  // converts noticeably worse — "Gutter guards $340" is a cost, "Gutter
  // guards $340 — stops the autumn clean-out you're paying for every year"
  // is a saving.
  detail      String?
  amount      Decimal @default(0) @db.Decimal(12, 2)

  // Whether tax applies. Most extras are taxed like the rest of the job, but
  // a permit fee or a disbursement isn't, and getting that wrong on an
  // accepted total is a real invoice problem rather than a cosmetic one.
  taxable   Boolean @default(true)
  sortOrder Int     @default(0)

  // "manual" | "history" | "ai" — where the suggestion came from. Kept so the
  // platform can answer whether the AI suggestions are worth their tokens:
  // if nobody ever accepts an "ai" add-on, the feature isn't earning its cost.
  source String @default("manual")

  selected   Boolean   @default(false)
  selectedAt DateTime?

  createdAt DateTime @default(now())

  @@index([quoteId])
}

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceNumber String
  status        InvoiceStatus @default(draft)
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  quoteId       String?
  quote         Quote?        @relation(fields: [quoteId], references: [id])
  createdById   String?
  createdBy     User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  parentInvoiceId String?
  parentInvoice   Invoice?  @relation("InvoiceVersions", fields: [parentInvoiceId], references: [id])
  versions        Invoice[] @relation("InvoiceVersions")
  version         Int       @default(1)
  changeLog       Json?

  lineItems Json?
  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  tax       Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  /// Mirrors Quote.taxEnabled, and had to exist for the same reason it does
  /// there: `tax: 0` on its own cannot say WHY it is zero.
  ///
  /// The invoice editor already rendered an "apply tax" switch, but there was
  /// no column behind it — it reconstructed its own state as `tax > 0` on
  /// load. So the switch round-tripped by accident and carried no meaning: an
  /// invoice deliberately raised with no tax and one whose rate nobody could
  /// work out were the same row, and the client read "$0.00" for both.
  ///
  /// With this, turning tax off is a recorded decision the send gate honours
  /// and the document can state; leaving it on with nothing charged is the
  /// hole it refuses to send (lib/tax/documentTax.js).
  ///
  /// @default(true) matches Quote, and matches what the editor already assumed
  /// for every existing row. It does not re-price anything — Invoice.tax holds
  /// a money AMOUNT and nothing reads this to compute one.
  taxEnabled Boolean @default(true)

  dueDate      DateTime?
  startDate    DateTime?
  endDate      DateTime?
  pdfUrl       String?

  // What the office wrote on this invoice — the same block Quote.notes carries,
  // printed on the document and in the client's copy.
  //
  // ── This column was missing and three write paths sent it anyway ──────────
  //
  // POST /api/invoices, PATCH /api/invoices/[id] and the invoice editor's
  // "Notes" textarea all passed `notes`, and Prisma rejects an unknown argument
  // before the query is ever built. So creating an invoice from /app/invoices/new
  // threw, and the detail page rendered `invoice.notes` — permanently undefined.
  // A field written by three callers and declared by none is the schema half of
  // the "control that appears to work and doesn't" rule.
  notes        String?

  // Same shape as Quote.clientPhotos — [{ url, kind: "photo"|"video", publicId }].
  // Was String[], which nothing ever read or wrote, and which could not hold a
  // quote's photos without flattening away whether each one is a photo or a
  // video. Changed while every row was still empty.
  clientPhotos Json?
  language     String    @default("en")

  stripePaymentIntentId String?
  stripeCheckoutUrl     String?
  paidVia               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  tasks    Task[]

  amountPaid Decimal   @default(0) @db.Decimal(12, 2)
  amountDue  Decimal   @default(0) @db.Decimal(12, 2)
  paidDate   DateTime?

  // ── Email trail ─────────────────────────────────────────────────────────
  // sentAt existed but was written by a button that only changed the status
  // and never sent anything — so it recorded an intention, not an event. It's
  // now written only after Resend accepts the message, which makes it safe to
  // show as "Emailed 3 July" in front of a client dispute.
  sentAt      DateTime?
  sentToEmail String?

  // What the job cost the company. A separate row, never a column here — see
  // InvoiceCosting for why that distinction is load-bearing.
  costing InvoiceCosting?

  // ── The job this invoice bills for ────────────────────────────────────────
  //
  // Until now the only path from an invoice to the work was
  // invoice → quote → job, matching on Quote.id. That covers the ordinary
  // pipeline and covers nothing else: an invoice raised by hand — a callout, a
  // warranty return, a deposit taken before anything was quoted — had no way to
  // reach the job at all, so its timesheets, its visits and its real cost were
  // invisible on the document that bills for them.
  //
  // Nullable and NOT a replacement for the quote path: see
  // lib/invoices/jobLink.js, which is the single place that decides. An
  // explicit link wins; the quote is the fallback; neither means "no job", which
  // the page states rather than papering over.
  //
  // Many invoices to one job on purpose. Progress billing raises a deposit
  // invoice and a final one against the same work, and modelling it the other
  // way round would force one of them to lie.
  //
  // SetNull rather than Cascade: deleting a job must never delete an invoice.
  // Jobs already refuse deletion while they carry approved hours; an invoice is
  // a financial record and outranks the link to it.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Set when this invoice was raised by a service plan's schedule rather than
  /// by a person. Optional on both sides: the overwhelming majority of invoices
  /// have no plan behind them, and a plan's occurrence keeps its invoice even
  /// if the plan is deleted.
  servicePlanOccurrence ServicePlanOccurrence?

  @@index([companyId, jobId])
}

/// What one invoice's job actually cost: who worked it, for how many hours, at
/// what rate, plus materials and overhead. Internal only.
///
/// ── Why this is a table and not a Json column on Invoice ────────────────────
///
/// Two live code paths hand a whole Invoice row onwards without naming its
/// fields:
///
///   app/api/portal/[token]/route.js  returns `client.invoices` — full rows —
///     from a PUBLIC, token-only endpoint the homeowner loads.
///   app/api/invoices/[id]/pdf/route.js  spreads `...invoice` into the PDF's
///     `data`.
///
/// A `costing Json?` column on Invoice would ride along on both. It would
/// render nowhere and still be sitting in the JSON the client's browser
/// received — which is how a homeowner ends up reading the contractor's labour
/// rates and margin. A separate row that nothing joins cannot leak by
/// accident, and that is a stronger guarantee than remembering to strip a key
/// in every future query. Same reasoning as the reserved-subdomain rule: make
/// the boundary structural, not a habit.
///
/// No companyId of its own: every read goes through an Invoice already scoped
/// to the member's company, and a second copy of the tenant key is a second
/// thing that can disagree.
model InvoiceCosting {
  id        String  @id @default(cuid())
  invoiceId String  @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// [{ id, name, rate, hours }] — one row per person on the job.
  ///
  /// `hours` is per-person and ACTUAL here, not a share of a predicted pool
  /// the way it is on a quote: an invoice bills the time that was worked. The
  /// worker id is kept for provenance only; name and rate are COPIES, frozen
  /// at save. A raise next year must not rewrite what last year's job cost.
  crew Json?

  /// Materials bought for this job, and the overhead basis used. overheadPct
  /// is only consulted when the company has no real cost-per-job figure — see
  /// estimateQuoteCost's overheadBasis.
  materialCost Decimal @default(0) @db.Decimal(12, 2)
  overheadPct  Decimal @default(0) @db.Decimal(6, 3)
  note         String?

  /// Computed SERVER-side from the fields above at save time, never accepted
  /// from the browser. Stored rather than recomputed on read because the
  /// company's overhead and rates move: this row is the answer as of the day
  /// the invoice was costed, which is the only version of it worth comparing
  /// against later.
  labourHours Decimal @default(0) @db.Decimal(10, 2)
  labourCost  Decimal @default(0) @db.Decimal(12, 2)
  overhead    Decimal @default(0) @db.Decimal(12, 2)
  totalCost   Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id                    String        @id @default(cuid())
  invoiceId             String
  invoice               Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount                Decimal       @default(0) @db.Decimal(12, 2)
  method                PaymentMethod @default(e_transfer)
  notes                 String?
  // Unique because Stripe re-delivers events, and an asynchronous method fires
  // BOTH checkout.session.completed and checkout.session.async_payment_succeeded
  // for one intent — a read-then-create guard lets two concurrent deliveries
  // both pass and double-count amountPaid. The database settles the race.
  //
  // Nullable, and Postgres allows any number of NULLs in a unique index, so
  // manual payments (cash, cheque, e-transfer) are untouched by this.
  stripePaymentIntentId String?       @unique
  date                  DateTime      @default(now())
  createdAt             DateTime      @default(now())
}

// ============================================================
// SERVICE CATALOG / PRICING
// ============================================================

model ServiceCategory {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String

  // The trade name in other languages: { fr: "Peinture intérieure", ... }
  //
  // A tenant website in French listed "Interior Painting" under a French
  // heading, because the site reconciles service names live from this column and
  // it only ever held English. Half-translated reads as a page nobody finished.
  //
  // NOT left to the model: it is told to reproduce service names exactly so it
  // can't invent a trade the company doesn't offer, and relaxing that to let it
  // translate them would relax the guard too. Trade names are a fixed, closed
  // vocabulary — a lookup is the right tool.
  //
  // Missing languages fall back to `label`. Better a visibly English name than a
  // machine-guessed one on a page a homeowner is deciding from.
  labelTranslations Json?

  description String?
  icon        String?
  sortOrder   Int     @default(0)
  isSystem    Boolean @default(true)

  // Custom (non-system) quote types a company creates for itself — null for
  // the ~26 seeded system categories, set for anything a company added under
  // Settings > Services. `key` stays globally unique either way (custom keys
  // are generated as custom_<cuid>, never user-typed), so this doesn't need
  // its own compound unique constraint.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Only set (and only read) for custom categories — the subset of fields
  // the company picked from the shared field library in
  // app/data/intakeFieldLibrary.js when creating this quote type. Same shape
  // as one entry's array in app/data/quoteIntakeFields.js's INTAKE_FIELDS map
  // ({ key, label, type, options? }[]), so the quote builder can treat both
  // sources identically. System categories keep using getIntakeFields()
  // instead and leave this null.
  customFields Json?

  companySettings    CompanyServiceCategory[]
  scopeGroups        QuoteScopeGroup[]
  checklistTemplates JobChecklistTemplate[]
  leadRequests       LeadRequest[]
  quickAddItems      QuickAddItem[]
  products           Product[]
}

model QuickAddItem {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id])
  description String
  unit        String           @default("flat")
  rate        Decimal          @db.Decimal(12, 2)
  section     String?
  sku         String?
  createdAt   DateTime         @default(now())
}

model CompanyServiceCategory {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  enabled      Boolean         @default(false)

  // DEAD — written for months, read by nothing. No quote, PDF, invoice or
  // estimator ever branched on it, so "hourly" priced identically to "flat".
  // Real trades don't price by one of three generic models anyway: cabinets
  // are per door and per drawer, stairs per tread/riser/baluster/post,
  // painting and flooring per square foot. That lives in `rates` below.
  //
  // No longer written or returned by the API (app/api/settings/service-
  // categories/route.js). Left in place because dropping it is a data
  // migration, not a code change; rows keep whatever they last stored.
  pricingModel PricingModel    @default(flat)

  // For the ~50 catalog trades with no price book of their own: one rate and
  // the unit it is charged in. Both ARE read — they seed a quote line item.
  defaultRate  Decimal?        @db.Decimal(12, 2)
  unit         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  crewRate1Person Decimal? @db.Decimal(10, 2)
  crewRate2Person Decimal? @db.Decimal(10, 2)

  // This company's edits to the trade price book — see app/data/tradePriceBooks.js.
  //
  // A sparse PATCH, not a copy: only the fields actually changed are stored, so
  // a company that adjusted one tread price keeps inheriting every other
  // default, and one that edited nothing has null here. Same reasoning as
  // includedItems/processSteps below, and the reason `defaultRate` alone was
  // never enough — a staircase is priced per tread, per riser, per baluster and
  // per newel post, and a countertop is a supplier's invoice with a margin.
  rates Json?

  // ── Document content overrides ──────────────────────────────────────────
  // What this company's quotes SAY about this service, beyond the price.
  // All null on a company that hasn't customised anything, which is the
  // normal case — the defaults in lib/documents/serviceContent.js are good
  // enough to send, and a company that never opens this screen still gets a
  // quote that reads like they've done the job before.
  //
  // Null rather than a copy of the default on purpose: a company that hasn't
  // edited theirs keeps inheriting improvements to the default wording, and
  // one that has is never overwritten by them.
  accentColor   String? // hex, tints the scope card for this service
  includedItems Json? // string[] — the "what's included" list
  processSteps  Json? // { title, body }[] — numbered at render time

  // The scope paragraph printed above the prices on this trade's scope card:
  // what the work IS, and what it stops at. Text, not Json, because it is one
  // paragraph rather than a list.
  //
  // Set here it applies to the whole trade, which loses the per-choice variants
  // the defaults carry (a refacing quote's paragraph changes with the door
  // material picked on the takeoff — see lib/documents/serviceContent.js). That
  // is the company's call to make, and the same trade-off includedItems has.
  scopeDescription String?

  @@unique([companyId, categoryId])
}

model QuoteScopeGroup {
  id         String          @id @default(cuid())
  quoteId    String
  quote      Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  label      String?
  lineItems  Json?

  // The estimator's takeoff for trades that have a structured form — which
  // stair elements were ticked and how many, the countertop's supplier costs
  // and markup. lineItems is DERIVED from this (lib/pricing/tradeScope.js).
  //
  // Kept so reopening a quote restores the form rather than a flat list of
  // priced lines: without it, changing 13 treads to 14 means deleting the line
  // and re-doing the arithmetic, which is the workflow this replaced.
  //
  // lineItems stays the source of truth for what is BILLED — a document must
  // not re-derive its own prices from a rate card that has since changed.
  takeoff    Json?

  // The intake answers behind a unit-priced group — 32 doors, 3 drawer fronts,
  // thermofoil. Kept for the same reason as `takeoff`, and for one more: the
  // cost estimate is DERIVED from these (materialRecipes.js turns doors into
  // gallons of primer and minutes of spraying). Without them stored, a cabinet
  // quote could be re-priced but never re-costed, so the Cost & Margin panel a
  // user filled in while quoting read back as "this quote was never costed".
  //
  // Not client-facing and not the source of truth for what is BILLED — the
  // flattened lineItems are.
  intakeValues Json?
  subtotal   Decimal         @default(0) @db.Decimal(12, 2)
  sortOrder  Int             @default(0)
}

/// What one quote was ESTIMATED to cost, frozen at the moment it was quoted:
/// who was expected on the job and at what rate, the bill of materials, this
/// job's share of overhead, and the margin those produced. Internal only.
///
/// ── Why this is a table and not a Json column on Quote ──────────────────────
///
/// The quote is the most widely-spread row in this codebase. Two paths hand it
/// onwards without naming its fields:
///
///   app/api/public/quotes/[token]/route.js  builds the homeowner's approval
///     page from the quote row. It is credential-free by design — the share
///     token IS the authentication — and its own header already warns that a
///     spread of the quote row is what it must never become.
///   app/api/quotes/[id]/pdf/route.js  does exactly that spread today:
///     `data: { ...quote, client, scopeGroups }`, straight into the document
///     the client downloads.
///
/// A `costing Json?` column on Quote would ride along on both. It would render
/// nowhere and still be sitting in the payload the homeowner's browser
/// received — which is how a stranger comparing three contractors reads one of
/// them's labour rates, crew wages and target margin. And the leak would be
/// worse here than on an invoice: an invoice goes to somebody who has already
/// signed, while a quote goes to somebody still deciding, sometimes to three
/// people bidding the same job.
///
/// A row nothing joins cannot leak by forgetting. That is a stronger guarantee
/// than a rule about stripping a key from every future query, and the two
/// routes above are proof the rule would eventually be forgotten.
///
/// ── Why the derived figures are stored and not recomputed ──────────────────
///
/// Recomputing on read answers "what would this cost today", not "what did we
/// think it would cost when we quoted it". The price book, the crew's wages
/// and the company's overhead per job all move. A margin that changes when
/// nobody touched the quote is worse than a stale one, and it is useless for
/// the only question worth asking later: did we price this job right?
///
/// GET /api/quotes/[id]/costing will still recompute when this row is absent —
/// for the quotes raised before this table existed — and says so with
/// `saved: false` rather than passing today's arithmetic off as the estimate.
///
/// No companyId of its own: every read reaches this through a Quote already
/// scoped to the member's company, and a second copy of the tenant key is a
/// second thing that can disagree.
model QuoteCosting {
  id      String @id @default(cuid())
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // ── The estimator's inputs ────────────────────────────────────────────────

  /// [{ id, name, rate, hours }] — who is expected on this job.
  ///
  /// `hours` is a SHARE of a predicted pool here, not a fact off a timesheet
  /// the way it is on an invoice: null means "take an even share of whatever
  /// the takeoffs predict", a number means somebody overrode that. Name and
  /// rate are COPIES, frozen at save — a raise next year must not rewrite what
  /// last spring's quote was priced against.
  crew Json?

  /// Hours and materials the estimator added ON TOP of what the takeoffs
  /// predicted, because the person standing in the driveway is allowed to know
  /// better than a price book. Stored separately from the totals below so a
  /// later reader can tell a prediction from a judgement.
  addedLabourHours  Decimal @default(0) @db.Decimal(10, 2)
  addedMaterialCost Decimal @default(0) @db.Decimal(12, 2)

  /// The single fallback cost-rate, used only when no crew was named. Kept
  /// because it is an input the estimator chose; with a crew, the blended rate
  /// below supersedes it entirely.
  labourRate Decimal @default(0) @db.Decimal(10, 2)

  /// Overhead as a percentage of price. Consulted only when the company has no
  /// real cost-per-job figure — `overheadBasis` records which one actually ran.
  overheadPct Decimal @default(0) @db.Decimal(6, 3)

  note String?

  // ── Computed SERVER-side at save, never accepted from the browser ─────────
  //
  // Same discipline as add-on repricing: the request carries crew names, rates
  // and hours, and the server runs estimateQuoteCost over the quote's own
  // scope groups to work out every figure below. A tampered or merely stale
  // browser cannot write a margin its own numbers don't support.

  labourHours   Decimal @default(0) @db.Decimal(10, 2)
  labourCost    Decimal @default(0) @db.Decimal(12, 2)
  materialTotal Decimal @default(0) @db.Decimal(12, 2)

  /// Bill-of-materials lines that had a quantity and no supplier price. Stored
  /// with the figures because a material total built over eleven unpriced
  /// shingle bundles is an understatement by an unknown amount, and a reader
  /// six months later needs to know that as much as the estimator did.
  unpricedMaterials Int @default(0)

  overhead      Decimal @default(0) @db.Decimal(12, 2)
  /// "per_job" (the company's real overhead) or "pct_of_price" (the fallback).
  /// Which one ran changes what the number means, so it travels with it.
  overheadBasis String  @default("pct_of_price")

  totalCost Decimal @default(0) @db.Decimal(12, 2)

  /// The pre-tax price this cost was measured against, frozen. The quote's own
  /// subtotal moves when it is edited; the margin below was computed against
  /// this one, and the two must not silently drift apart.
  price  Decimal @default(0) @db.Decimal(12, 2)
  profit Decimal @default(0) @db.Decimal(12, 2)

  /// Null, not zero, when there was no price to have a margin against. A quote
  /// priced at nothing has no margin — reporting 0% would say it broke even.
  marginPct       Decimal? @db.Decimal(9, 3)
  marginTargetPct Decimal  @default(30) @db.Decimal(6, 3)

  /// "green" | "amber" | "red" | "none" — the vocabulary CostMarginPanel
  /// renders. Stored rather than re-derived so the badge cannot change colour
  /// because the target moved in Settings after the quote was sent.
  signal String @default("none")

  /// True when labour hours were costed at no rate at all, or somebody on the
  /// crew had none. The figure isn't wrong so much as unfinished, and a reader
  /// has to be able to tell which.
  costIncomplete Boolean @default(false)

  /// What one hour of this crew cost, on average. Null with no crew.
  blendedRate Decimal? @db.Decimal(12, 2)

  /// The per-scope-group breakdown — labour hours, material total, and the
  /// bill of materials line by line.
  ///
  /// Frozen alongside the totals rather than rebuilt on read for the same
  /// reason as everything else here: rebuilding needs today's price book, and
  /// the itemised half must not disagree with the totals it is supposed to
  /// explain. It is also the only surviving record of the takeoff's material
  /// PRICES — QuoteScopeGroup.takeoff keeps the quantities, and the rates that
  /// priced them live in a settings row that will be edited.
  groups Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// DOCUMENT TEMPLATES (customizable PDF/email layouts)
// ============================================================

model DocumentTemplate {
  id        String               @id @default(cuid())
  companyId String
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      DocumentTemplateType
  name      String
  // Client-facing subject line. Supports the same {{mergeField}} tokens as
  // the body blocks. Nullable so each send path can fall back to its own
  // built-in subject when a company hasn't set one.
  subject   String?
  sections  Json
  // Per-template theme overrides (accent colour, background, font, whether
  // to show the branded header/footer). Null means "inherit from
  // Company.brandColor / Company.logoUrl" — see lib/email/emailTheme.js.
  theme     Json?
  isDefault Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  followUpRules      FollowUpRule[]
  marketingCampaigns MarketingCampaign[]
}

// A company-configured automation rule: "N days/hours after <triggerEvent>,
// if still unresolved, send <template>." triggerEvent is a plain String
// (not a Prisma enum) so new trigger types can be added later just by
// extending the checker in app/api/cron/follow-ups/route.js and the UI
// dropdown, with no migration. Supported today: quote_no_response,
// invoice_overdue, job_completed.
model FollowUpRule {
  id           String            @id @default(cuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  triggerEvent String
  delayValue   Int               @default(3)
  delayUnit    String            @default("days") // "hours" | "days"
  templateId   String?
  template     DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  active       Boolean           @default(true)
  conditions   Json? // reserved for future rule conditions (min quote total, etc.)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  logs FollowUpLog[]
}

// One row per (rule, entity) send — the cron route's dedupe guard so the
// same quote/invoice/job never gets the same rule's email twice.
model FollowUpLog {
  id         String       @id @default(cuid())
  ruleId     String
  rule       FollowUpRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityType String // "quote" | "invoice" | "job"
  entityId   String
  sentAt     DateTime     @default(now())

  @@unique([ruleId, entityId])
}

// ============================================================
// APPOINTMENTS / TASKS / WORK AREAS
// ============================================================

model Appointment {
  id                 String            @id @default(cuid())
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client            @relation(fields: [clientId], references: [id])
  quoteId            String?
  quote              Quote?            @relation(fields: [quoteId], references: [id])
  scheduledAt        DateTime
  location           String?
  requiresSupervisor Boolean           @default(false)
  status             AppointmentStatus @default(scheduled)
  notes              String?
  /// Once-only guard so the reminder cron can't text the same client twice for
  /// the same appointment (same pattern as Job.reviewRequestedAt). Null until a
  /// reminder actually goes out.
  reminderSentAt     DateTime?
  createdById        String
  createdBy          User              @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  assignedToId       String?
  assignedTo         User?             @relation("AppointmentAssignee", fields: [assignedToId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  booking Booking?
  /// Geocoded from `location`, so an internally-booked appointment counts
  /// toward travel time exactly like a client-booked one. Without this, a day
  /// full of manually-entered appointments looks like an empty day to the
  /// travel check.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

}

/// A prospect's booked FieldQuo product-demo slot (30 min, 6–10pm ET). This is
/// FieldQuo's OWN sales calendar, not a tenant's — there is no companyId, and it
/// surfaces in /platform, not /app. Kept deliberately separate from Appointment
/// (which is a contractor's client visit) so the two never share a query or a
/// list; conflating "someone wants a demo of us" with "a homeowner booked a
/// contractor" would put prospect data on a tenant's calendar.
model DemoBooking {
  id          String   @id @default(cuid())
  name        String
  email       String
  companyName String?
  phone       String?
  notes       String?
  /// The slot start, UTC. Always a time the assigned host actually offers — the
  /// booking route re-validates against that host's DemoHostAvailability, so
  /// this can't be an arbitrary time a client posted.
  scheduledAt DateTime
  /// booked · cancelled · completed. Plain string, not an enum — this is a light
  /// internal sales record, and a new status shouldn't need a migration.
  status      String   @default("booked")
  source      String?
  createdAt   DateTime @default(now())

  /// Which FieldQuo admin is taking this demo. Assigned by /api/demo/book from
  /// the hosts free at that instant (least-loaded, ties by id).
  ///
  /// Nullable for two reasons. Rows written before demo availability existed
  /// have no host, and a host account being removed must not delete the sales
  /// record. A host-less booking is treated as busy for EVERY host — we know
  /// the time is committed, we just no longer know to whom, and over-blocking
  /// costs one slot where under-blocking double-books a prospect.
  hostAdminId String?
  hostAdmin   PlatformAdmin? @relation(fields: [hostAdminId], references: [id], onDelete: SetNull)

  /// One booking per host per slot — the DB is the final guard against two
  /// prospects grabbing the same time in a race the availability check didn't
  /// catch. This REPLACED a global @@unique([scheduledAt]), which capped the
  /// whole platform at one demo per half hour however many people were
  /// available to run them.
  ///
  /// Postgres treats NULLs as distinct here, so legacy host-less rows are not
  /// deduped by it — but the constraint this replaces already guaranteed at
  /// most one row per instant, so there is nothing for it to catch. Every row
  /// written from here on has a host.
  @@unique([hostAdminId, scheduledAt])
  @@index([status, scheduledAt])
}

model Task {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  dueDate      DateTime?
  status       TaskStatus   @default(open)
  priority     TaskPriority @default(normal)
  createdById  String
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id])
  quoteId      String?
  quote        Quote?       @relation(fields: [quoteId], references: [id])
  invoiceId    String?
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  jobId        String?
  job          Job?         @relation(fields: [jobId], references: [id])
  workAreaId   String?
  workArea     WorkArea?    @relation(fields: [workAreaId], references: [id])

  /// Identity of the LIFECYCLE EVENT that produced this task, e.g.
  /// "quote_accepted:<quoteId>". Null for anything a person typed.
  ///
  /// Unique, because idempotency here has to survive a retried webhook, a
  /// double-clicked Send and two servers racing — a "read then create" guard
  /// loses all three. lib/tasks/autoCreate.js relies on the constraint itself
  /// and swallows P2002, so the second attempt is a no-op rather than a
  /// duplicate reminder nagging someone about a job they already scheduled.
  sourceKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkArea {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  assignments WorkAreaAssignment[]
  tasks       Task[]
}

model WorkAreaAssignment {
  id         String   @id @default(cuid())
  workAreaId String
  workArea   WorkArea @relation(fields: [workAreaId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([workAreaId, userId])
}

// ============================================================
// JOBS (work orders — separate from Quote/Invoice)
// ============================================================

model Job {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteId        String?
  quote          Quote?    @relation(fields: [quoteId], references: [id])
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  title          String
  status         JobStatus @default(scheduled)
  recurring      Boolean   @default(false)
  recurrenceRule String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  visits      JobVisit[]
  timeEntries TimeEntry[]
  shifts      Shift[]
  /// When the job was actually finished, and when we asked for a review.
  ///
  /// Both are needed and neither is derivable from `status`: a job can flip in
  /// and out of "completed" while somebody tidies up the paperwork, and asking
  /// for a review every time it does is the fastest way to have a customer mute
  /// you. `reviewRequestedAt` is the once-only guard.
  completedAt       DateTime?
  reviewRequestedAt DateTime?

  /// Put away, not deleted.
  ///
  /// Deliberately NOT a JobStatus value. Status says what happened to the
  /// WORK — needs a date, scheduled, in progress, completed, cancelled.
  /// Archiving says whether you still want to look at it. Those are different
  /// questions and a job answers both: a completed job stays visible for weeks
  /// and is then filed away; a cancelled one might be filed the same day.
  /// Folding them into one column is the "one field doing two jobs" mistake
  /// this schema keeps getting cleaned of.
  ///
  /// Exists because a job carrying approved hours or tasks cannot be deleted —
  /// those are payroll and to-do records — so without this the only way to
  /// clear finished work off the list was to CANCEL it, which says something
  /// untrue about work that actually happened.
  ///
  /// Nullable timestamp rather than a boolean: "when was this filed" is worth
  /// knowing, costs nothing, and null reads as "not archived" with no default
  /// to maintain.
  archivedAt DateTime?

  galleryPhotos JobPhoto[]

  /// Back-relation for the office to-do list. A Task is internal admin ("ask
  /// them for a review"); a JobVisit is work at an address. Deliberately not
  /// merged with `visits` — conflating the two is exactly the confusion this
  /// link exists to make legible on /app/tasks.
  tasks Task[]

  /// What has to be bought before the crew leaves the yard.
  materials JobMaterial[]

  /// The invoices raised against this job. Plural: progress billing raises a
  /// deposit and a final invoice for the same work. See Invoice.jobId.
  invoices Invoice[]
}

/// One line of a job's sourcing list: what to buy, how much, and whether it has
/// been bought yet.
///
/// ── Why this is a table and not a Json column on Job ────────────────────────
///
/// Every other derived list in this schema that nobody ticks is Json. This one
/// is ticked, one line at a time, by different people on different days, and
/// each tick can carry money and a supplier. A Json blob read-modify-written by
/// two phones in a supply yard loses one of the ticks, and the person who lost
/// it has no way to know.
///
/// ── Estimated and actual are two columns, not one ───────────────────────────
///
/// `estUnitCost` is what lib/costing/tradeMaterials.js derived from the takeoff
/// — often NULL, because for roofing, siding and insulation no supplier pricing
/// ships. `actualCost` is what the receipt said. Overwriting the first with the
/// second would destroy the only record of whether the estimate was any good,
/// which is the whole point of collecting the second.
model JobMaterial {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name String
  qty  Decimal @db.Decimal(12, 2)
  unit String

  /// Which scope group this came from, so a regenerate can tell a roofing line
  /// from a paving one on a two-trade job.
  categoryKey String?

  /// Per-unit cost the estimate used. Null means nobody has priced it — see
  /// the note above, and the `unpriced` flag in lib/costing/tradeMaterials.js.
  estUnitCost Decimal? @db.Decimal(12, 2)

  /// The whole line as actually paid, entered when it is ticked off. Not a
  /// per-unit figure: a receipt is a total, and asking someone standing at a
  /// till to divide it by 17 bags is asking for a wrong number.
  actualCost Decimal? @db.Decimal(12, 2)
  supplier   String?

  /// Ticked. A timestamp rather than a boolean, for the same reason
  /// Job.archivedAt is: "when was this bought" is worth knowing, costs nothing,
  /// and null reads as "not yet" with no default to maintain.
  purchasedAt   DateTime?
  purchasedById String?
  purchasedBy   User?     @relation("JobMaterialPurchaser", fields: [purchasedById], references: [id])

  /// Hand-added lines survive a regenerate; derived ones are replaced. Someone
  /// who wrote "gas for the compactor" on the list did not derive it from a
  /// takeoff and should not lose it when the quote is revised.
  addedByHand Boolean @default(false)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, purchasedAt])
}

model JobVisit {
  id             String   @id @default(cuid())
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  assignedToId   String?
  assignedTo     User?    @relation("JobVisitAssignee", fields: [assignedToId], references: [id])
  status         String   @default("scheduled")
  checklistItems Json?
  photos         String[] @default([])
  notes          String?
  createdAt      DateTime @default(now())
}

model JobChecklistTemplate {
  id String @id @default(cuid())

  /// Null for the SYSTEM library seeded by prisma/seed-checklists.js — the
  /// per-trade starter lists every company can see. A row with a companyId is
  /// that company's own, and only they can read or edit it.
  ///
  /// System rows are OFFERED, never applied on their own: nothing stamps a
  /// checklist onto a real visit unless somebody ticked it. A crew arriving to
  /// find eight invented steps against their name is worse than no checklist.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  items Json

  /// pre · during · post — when in the visit this list belongs.
  ///
  /// A plain String rather than an enum: the three phases below are what a
  /// working day actually has, but a trade that wants a fourth shouldn't need
  /// a schema change, and lib/jobs/checklistItems.js already coerces anything
  /// unrecognised back to "during".
  ///
  /// Defaults to "during" so every template written before phases existed
  /// keeps meaning what it meant — the work steps.
  phase String @default("during")

  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])

  /// Stable identity for the seeded rows, e.g. "plumbing:pre". Only the seed
  /// sets it; company templates leave it null. Unique so re-running the seed
  /// upserts instead of piling up a second copy of every trade — the seed is
  /// expected to be run again every time the item lists are improved.
  systemKey String? @unique

  /// Everything about a checklist that is neither its name nor its steps:
  /// description, who normally runs it, roughly how long it takes, what has to
  /// be true before you start, and which roles sign it off.
  ///
  /// One Json column rather than five scalars because these are DESCRIPTIVE —
  /// nothing queries or filters on them, they are rendered next to the list so
  /// somebody picking one knows what they are picking. Five nullable columns
  /// that only the construction library ever fills would be five columns most
  /// rows leave empty.
  ///
  /// Null for every hand-written and residential-trade template, which is the
  /// honest answer: nobody stated a sign-off role for "mask the baseboards".
  meta Json?

  createdAt DateTime @default(now())

  @@index([companyId])
}

// ============================================================
// MARKETING — campaigns + pamphlet (door-to-door) distribution
// ============================================================

// A marketing effort the company runs. `type` distinguishes the facets Emilio
// described: pamphlet door-to-door distribution (the one with real workflow
// below), plus lighter-weight records for paid channels (meta_ads) and a
// generic bucket. Only pamphlet campaigns use PamphletStop rows.
model MarketingCampaign {
  id        String                  @id @default(cuid())
  companyId String
  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  type      MarketingCampaignType   @default(pamphlet)
  status    MarketingCampaignStatus @default(draft)
  notes     String?

  // The employee tasked with distribution (User, so it lines up with the same
  // assignee model appointments/jobs use). Nullable until assigned.
  assignedToId String?
  assignedTo   User?   @relation("CampaignAssignee", fields: [assignedToId], references: [id])

  // Paid-channel record-keeping — only meaningful for non-pamphlet types,
  // left null for pamphlet campaigns.
  budget      Decimal? @db.Decimal(12, 2)
  externalUrl String?

  // Email-blast campaigns (type = email): which template to send and to how
  // many subscribers, set once Send is clicked on the campaign detail page.
  templateId     String?
  template       DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sentAt         DateTime?
  recipientCount Int?

  stops   PamphletStop[]
  designs MarketingDesign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A saved advert built in the Marketing Designer canvas editor
// (app/components/designer/). Distinct from DesignTemplate — that is a
// global, company-agnostic starter shelf every company sees the same rows
// of; this is what one company actually built, tied to the campaign it is
// advertising.
//
// Multi-tenant like every model in this schema: companyId scopes it
// directly rather than only through campaignId, so a lookup never has to
// walk the relation to prove ownership (lib/tenant/ownedIds.js's convention
// — see also its OWNED_ID_FIELDS entry for campaignId, which every route
// creating a design must prove against before writing this foreign key).
model MarketingDesign {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name String

  layouts MarketingDesignLayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([campaignId])
}

// One row per aspect ratio the design has been adjusted for.
//
// lib/marketing/ratios.js's own header explains why this can't be a single
// shared layout: reflow() only ever produces a STARTING point for a new
// ratio, a human adjusts it from there, and "each ratio's adjustments are
// SAVED SEPARATELY, so fixing the Story does not disturb the square" is the
// whole point of that module. Modelling one JSON blob per design here would
// throw that away the moment a second ratio was opened.
//
// No companyId of its own — reached only through a MarketingDesign already
// proved to belong to the caller's company, the same pattern PamphletStop
// uses for MarketingCampaign (see app/api/marketing/campaigns/[id]/stops):
// a child table hanging off an owner that was already checked doesn't need
// a second copy of the same fact.
model MarketingDesignLayout {
  id       String          @id @default(cuid())
  designId String
  design   MarketingDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  /// One of lib/marketing/ratios.js's AD_RATIOS keys (e.g. "instagram_post").
  /// A plain string rather than an enum: the ratio list is product-owned and
  /// AD_RATIOS can grow without a schema migration.
  ratioKey String
  /// A fabric.js canvas.toJSON(JSON_KEYS) document — see
  /// lib/designer/constants.js's JSON_KEYS for the exact extra props that
  /// must round-trip. Native Json, same convention as DesignTemplate.json.
  json   Json
  width  Int
  height Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One saved layout per ratio per design — saving again for the same ratio
  // REPLACES it (upsert on this key), it never accumulates a history row.
  @@unique([designId, ratioKey])
  @@index([designId])
}

// A marketing-email recipient — either imported from the Client list or
// added by hand. Kept separate from Client because not every subscriber is
// necessarily a client yet (e.g. a pamphlet-stop lead who never converted),
// and because unsubscribes need to persist even if the underlying Client
// record changes or is removed. `clientId` is a plain reference (no Prisma
// relation/cascade) so a subscriber's send history survives a client delete.
model MarketingSubscriber {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  phone      String?
  address    String?
  clientId   String?
  subscribed Boolean  @default(true)
  source     String   @default("manual") // "manual" | "client_import"
  createdAt  DateTime @default(now())

  /// The credential in the unsubscribe link — same shape as Client.portalToken
  /// (32 CSPRNG bytes, base64url): unguessable, and unique per ROW rather than
  /// derived from the email, so a token can resolve to exactly one company's
  /// subscriber and nothing else. Null until first needed; lib/marketing/
  /// unsubscribe.js mints one lazily the same way ensurePortalToken does,
  /// which is also why a row can exist (manual add, client import) with no
  /// token yet — nothing sent them a link, so nothing needed one.
  unsubscribeToken String? @unique

  /// When they clicked. Set once and never moved on a repeat click — CASL asks
  /// when they asked to stop, not how many times they've confirmed it since.
  unsubscribedAt DateTime?

  /// The exact copy the unsubscribe page showed them, stored verbatim rather
  /// than referenced — same reasoning as CallConsent.disclosure: the page copy
  /// WILL change, and the defence has to be what THIS person actually saw.
  unsubscribeDisclosure String?

  @@unique([companyId, email])
}

/// One phone number's current SMS opt-out status for one company.
///
/// Deliberately NOT the same field as CallConsent.optedOutAt. That column is
/// documented as permanent — "always wins, whatever else is on file... never
/// deleted" — because a voice opt-out under TCPA is a heavier, one-way signal
/// and this codebase chose not to let it be silently reversed by a new consent
/// row. SMS STOP/START are different: they're standard, REVERSIBLE keywords
/// carriers expect an application to honour in real time (CTIA guidelines,
/// and Twilio's own opt-out/opt-in handling). Forcing that through the
/// one-way CallConsent ledger would mean either STOP never truly clearing (a
/// false compliance signal) or quietly rewriting voice's permanence rule for
/// everyone. So this is its own status row, updated in place: STOP flips it
/// true, START flips it back. lib/sms/optOut.js's maySms() checks BOTH this
/// AND CallConsent — a number that opted out of calls is refused SMS too, but
/// opting back into SMS here never silently restores call consent.
model SmsOptOut {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// E.164, normalised — same lookup key CallConsent uses, so a number typed
  /// one way and texted another can't slip past the check.
  e164 String

  optedOut Boolean @default(true)

  /// The exact inbound text that set this status ("stop", "STOP.", "please
  /// STOP") — the defence for "we honoured what they actually sent" is the
  /// message itself, not our interpretation of it.
  lastMessageBody String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, e164])
}

// One address on a pamphlet route. Ordering is precomputed (nearest-neighbor
// over lat/lng) so the assigned employee walks an efficient path; status +
// spokeToOwner capture what happened at the door in the field. When they talk
// to a homeowner and have the RBAC role, a stop can spawn a real Appointment
// and/or Quote — those FKs link back to the created records.
model PamphletStop {
  id         String            @id @default(cuid())
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  address   String
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  sortOrder Int      @default(0)

  status       PamphletStopStatus @default(pending)
  // Written by /api/marketing/stops/[id] and read by nothing. The UI drives off
  // `status === "spoke"` instead. Redundant with status and able to disagree with
  // it, so status is the source of truth.
  spokeToOwner Boolean            @default(false)
  notes        String?

  // Field agent override — a stop can be handed to a specific person, though
  // by default it inherits the campaign's assignee.
  assignedToId String?
  assignedTo   User?   @relation("PamphletStopAssignee", fields: [assignedToId], references: [id])

  // Set when the doorstep conversation converts into real work.
  clientId      String?
  client        Client? @relation(fields: [clientId], references: [id])
  appointmentId String?
  quoteId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, sortOrder])
}

enum MarketingCampaignType {
  pamphlet
  meta_ads
  email
  other
}

enum MarketingCampaignStatus {
  draft
  active
  completed
}

enum PamphletStopStatus {
  pending
  delivered
  spoke
  not_home
  skipped
}

// ============================================================
// LEADS / REFERRALS / BOOKING
// ============================================================

model LeadRequest {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])
  message    String?
  status     LeadStatus       @default(new)
  source     String?
  createdAt  DateTime         @default(now())
  // A kitchen the CLIENT drew themselves, from the public self-quote designer.
  //
  // Stored on the lead rather than turned straight into a Quote because it
  // isn't one yet: nobody at the company has priced it, and a Quote that exists
  // before anyone has looked at it is a number the client can see and the
  // contractor never agreed to. Converting the lead builds the quote, and the
  // designer opens with this as its starting layout.
  //
  // Prices are absent by construction — the public designer never receives the
  // rate card, so there is nothing here to strip.
  kitchenDesign Json?
  // Photos/videos the homeowner attached to the self-quote — the pile to haul,
  // the room to paint, the leak. Same shape as Quote.clientPhotos
  // ({ url, kind, publicId }), normalised server-side so only https media URLs
  // land here. Carried onto the Quote when the lead is converted.
  clientPhotos  Json?

  /// The phone assistant asked them to email photos, and where it sent them.
  ///
  /// A call cannot carry a picture, and for most trades a picture is what the
  /// person pricing the job wants most — so the receptionist asks, and this
  /// records that it did. Two columns rather than one boolean because the
  /// reviewer's real question is "photos are outstanding — where should they
  /// have landed?", and the address is the company's own contact email at the
  /// time of the call, which can change afterwards.
  ///
  /// Whether they ARRIVED is deliberately not a third column: `clientPhotos`
  /// already answers it, and a second representation of the same fact is one
  /// that can disagree with the pictures actually attached. See
  /// lib/ai/callQuoteDraft.js, which reads both so a reviewer can tell a
  /// photo-less quote that is photo-less ON PURPOSE from one nobody chased.
  photosRequestedAt DateTime?
  photosRequestedTo String?

  // The structured intake answers, kept ALONGSIDE the human-readable `message`
  // blob (which used to be the only home for them). Shape: { fieldKey: value }.
  // Scoring reads typed values here; conversion seeds the quote's scope from it.
  intake        Json?
  // Universal qualifiers now asked of every self-quote lead, captured
  // structurally so they can actually be triaged — they were free-text hints
  // nobody could sort or score on. Stored as stable keys, not display strings.
  budgetBand    String?
  timeline      String?

  // The language the homeowner filled the form in, fixed at creation.
  //
  // The public self-quote form offers the company's send languages and posted
  // the choice; the route destructured `language` from the body and dropped
  // it, so the pick changed the words on screen and nothing downstream. The
  // quote this lead converts into is a DOCUMENT, and a document keeps the
  // language it was created in (AGENTS.md non-negotiable 6) — so the choice
  // has to survive the round trip rather than be re-guessed, or machine-
  // translated, when someone gets round to pricing it.
  //
  // Null means the homeowner was never asked (a phone lead, an import, a
  // company with one send language). Callers fall back to the company default
  // rather than treating null as English.
  language      String?

  // Lead triage. `score` is 0–100; `temperature` is the hot/warm/cold band it
  // maps to; `scoreReasons` is the human-readable "why" ([{ label, weight }]) so
  // the number is never a black box a rep has to trust blind. Written when the
  // lead is created and recomputed if the inputs change.
  score         Int?
  temperature   String?
  scoreReasons  Json?

  // Who's working it, and the quote it became. `quoteId` is the real link the
  // old "Start quote" button never set: a converted lead's quote appears on the
  // quotes list and points back here. Unique — one lead becomes at most one quote.
  assignedToId  String?
  assignedTo    User?            @relation("LeadAssignee", fields: [assignedToId], references: [id])
  quoteId       String?          @unique
  quote         Quote?           @relation("LeadQuote", fields: [quoteId], references: [id])
  notes         LeadNote[]
  updatedAt     DateTime         @default(now()) @updatedAt
}

// A timeline note on a lead — the call-back log the kanban never had. Kept
// separate from the lead's own `message` (which is the homeowner's words) so a
// rep's "left a voicemail, trying again Tue" can't be confused with what the
// client actually asked for.
model LeadNote {
  id        String      @id @default(cuid())
  leadId    String
  lead      LeadRequest @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?       @relation("LeadNoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime    @default(now())
}

// ============================================================
// LEAD FUNNELS  (perspective.co-style mobile-first quiz funnels)
// ============================================================
//
// A funnel is an ordered sequence of full-screen mobile STEPS a stranger taps
// through — the "TikTok ad → quiz → qualified lead + booked estimate" loop. The
// whole thing (steps, their blocks, answer options and branching) lives in one
// `steps` JSON, exactly like CompanySite.blocks: the funnel is always read and
// written as a unit, and a relational split would buy queryability nobody needs.
//
// The public render never trusts this JSON raw — app/data/funnelBlocks.js
// sanitises it the same way sanitiseBlocks does for websites (clamp step kinds,
// whitelist text fields, guard image URLs), so a browser POST can never turn a
// stored funnel into a script or a layout it didn't define.
model Funnel {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  // Public URL segment: /f/<companySlug>/<slug>. Unique per company.
  slug        String
  status      FunnelStatus @default(draft)

  // The ordered steps. Shape (see funnelBlocks.js): each step is
  // { id, kind, ...fields, answers?: [{ id, label, value, weight?, next? }] }.
  steps       Json
  // Which channel template this came from — only for the analytics rollup
  // ("your TikTok funnels convert at X"), never a layout switch.
  channel     String?
  // Per-funnel theme overrides; falls back to the company brand hex.
  theme       Json?

  // Ad-platform pixels, so the ad account can optimise toward booked estimates
  // rather than clicks. IDs only — the pixel scripts are the platforms' own.
  metaPixelId   String?
  tiktokPixelId String?
  ga4Id         String?

  createdById String?
  createdBy   User?    @relation("FunnelCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  responses FunnelResponse[]
  events    FunnelEvent[]

  @@unique([companyId, slug])
}

// One completed (or abandoned-with-contact) run through a funnel. `answers` is
// every tap keyed by step/field; `leadId` is the LeadRequest it produced, so a
// funnel lead sits in the same scored pipeline as every other inbound.
model FunnelResponse {
  id          String    @id @default(cuid())
  funnelId    String
  funnel      Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  answers     Json
  leadId      String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

// A single step-level analytics beacon (a step viewed, or the funnel completed),
// tagged with an anonymous session id so drop-off between steps can be computed
// — "60% quit at the budget question" is the whole point. Deliberately its own
// rows rather than counters so the funnel view can slice by step and by day.
model FunnelEvent {
  id        String   @id @default(cuid())
  funnelId  String
  funnel    Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  stepId    String
  kind      String
  sessionId String?
  createdAt DateTime @default(now())

  @@index([funnelId, stepId])
}

enum FunnelStatus {
  draft
  published
}

/// ── Written by nobody, read by nobody ──────────────────────────────────────
///
/// The one route that created these rows — POST /api/portal/[token]/refer — was
/// deleted, because it was an orphan three times over. Nothing in the portal
/// ever called it (the portal page's own comment records that it was a
/// zero-byte file). Nothing anywhere read `ReferralLink.code`: /refer/[code]
/// resolves through findReferrer, which looks up Company.referralCode, so every
/// per-client link it minted would have 404'd.
///
/// And wiring it up would have been wrong rather than merely missing. The
/// referral programme is FieldQuo's OWN — one contractor telling another about
/// the product — and its landing page reads "{company} thinks you'd like
/// FieldQuo". Pointing a homeowner at that from a contractor's client portal
/// leaks FieldQuo into a client-facing surface, which the product's first
/// non-negotiable exists to prevent. A homeowner referring their neighbour to
/// the CONTRACTOR is a real and different feature; it is not this one.
///
/// The model is kept rather than dropped: zero rows exist today, and a migration
/// that removes a table to tidy up dead code is a worse trade than a documented
/// unused one. If the neighbour-referral feature is ever built, it starts here.
model ReferralLink {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code          String   @unique
  referredCount Int      @default(0)
  // Never read: whether a referral reward was actually issued is derived at read
  // time in /api/settings/referral from Stripe credit records instead (see
  // `rewarded` there), which is the more truthful source. This column can go out
  // of step with reality and nothing would notice, so nothing consults it.
  rewardIssued  Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// When a person is BOOKABLE by a client — not when they work.
//
// ── Why these are two different things ──────────────────────────────────────
//
// An estimator might work 8–4 but only take consultations 2–4, because mornings
// are on site. Conflating the two produces one of two wrong outcomes: publish
// 8–4 and clients book over their site work; publish 2–4 as their working day
// and payroll/scheduling think they're part-time.
//
// So: this table is the PUBLIC booking window (it feeds the booking calendar and
// the website). WorkingHours below is the internal shift — what scheduling and
// timesheets treat as their day. They're allowed to differ, and the bookable
// window is expected to be the narrower of the two.
//
// Deliberately not merged with Company.businessHours either, which is when the
// business is open — see lib/company/businessHours.js.
model AvailabilitySchedule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  timezone  String   @default("America/Toronto")
  createdAt DateTime @default(now())
}

// The internal shift — when this person is actually on the clock.
//
// Read by scheduling (is assigning them a 7am job unreasonable?) and by payroll
// as the expected-hours baseline against which logged time is sanity-checked.
// NEVER published to clients; that's AvailabilitySchedule's job.
model WorkingHours {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday
  startTime String   // "08:00"
  endTime   String   // "16:00"
  timezone  String   @default("America/Toronto")
  createdAt DateTime @default(now())

  // One shift row per person per day. A split shift is a product decision we
  // haven't taken; until then this keeps the data unambiguous.
  @@unique([userId, dayOfWeek])
  @@index([companyId])
}

model EventType {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  name            String
  slug            String
  durationMinutes Int      @default(60)
  bufferBefore    Int      @default(0)
  bufferAfter     Int      @default(0)
  location        String?
  active          Boolean  @default(true)

  // Fee for this booking type (e.g. a paid on-site diagnostic / estimate visit).
  // null or 0 = free. When set, the booking page collects it via the company's
  // Stripe Connect account before confirming the slot. promoFeeCents is an
  // optional promotional price shown instead of feeCents while promoActive is on
  // (e.g. a $20 estimate special). The contractor can later credit a paid fee
  // onto the client's invoice by hand (see Booking.feeCreditedInvoiceId).
  feeCents      Int?
  promoFeeCents Int?
  promoActive   Boolean @default(false)

  createdAt DateTime @default(now())

  bookings Booking[]

  @@unique([companyId, slug])
}

model Booking {
  id            String        @id @default(cuid())
  eventTypeId   String
  eventType     EventType     @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  clientName    String
  clientEmail   String
  clientPhone   String?
  startTime     DateTime
  endTime       DateTime
  // Which of the company's offered modes the client picked: call | visit | video.
  // Stored because it changes what the crew does that morning — driving to an
  // address or ringing a number — and the confirmation email has to say which.
  mode          String        @default("visit")
  /// Who took this booking. null = the client booked it themselves on the web,
  /// which is the overwhelming majority and needs no badge. "phone_assistant"
  /// means the AI receptionist took it on a call.
  ///
  /// Stored rather than derived from VoiceCall.bookingId: the calendar renders
  /// appointments, reaches a booking through one relation already, and would
  /// need a third query per row to answer "did a robot arrange this?" — which
  /// is a question the person driving there is entitled to have answered.
  source        String?

  /// What the client said they wanted, in their own words.
  ///
  /// The booking form asked for a name, an email, a phone number and — for a
  /// visit — an address, and nothing about the WORK. So a contractor opened
  /// their calendar to a name and a time and had to ring the person to find out
  /// what they had booked. Everything needed to prepare for the appointment was
  /// a question nobody had asked.
  ///
  /// Copied onto Appointment.notes at confirmation, because the calendar reads
  /// that one — a note only reachable through the booking row is a note nobody
  /// working that day will see.
  notes         String?

  /// Which of the company's services this is about, as a ServiceCategory key.
  ///
  /// Optional and free-form-adjacent on purpose: the client picks from what the
  /// company actually offers, and "not sure" is a real answer that must not be
  /// coerced into the first item on the list. Null means they did not say, which
  /// is different from them saying "something else".
  serviceKey    String?
  status        BookingStatus @default(confirmed)
  // The estimate that prompted this visit, when there was one. An instant
  // estimate ends with "book a visit"; without this the booking and the quote
  // are two unrelated rows and the confirmation email cannot say which job it
  // is about. Set only after server-side verification that the quote belongs to
  // the same company — the browser is the only thing that knows the session,
  // so the id arrives from it and is never trusted on arrival.
  quoteId       String?
  quote         Quote?        @relation("BookingQuote", fields: [quoteId], references: [id], onDelete: SetNull)

  // The client's own link to this booking. Unguessable, minted at confirmation
  // and mailed to them, and the ONLY way they can reach it — a booking has no
  // account behind it, and the portal token identifies a client rather than a
  // visit. Nullable because bookings created before this existed have none;
  // those rows simply have no manage link rather than a broken one.
  manageToken   String?       @unique

  // When the visit fee was returned, and how much of it. Written only after
  // Stripe confirms the refund, for the same reason sentAt is written only
  // after Resend accepts: this is a record that money moved, not that somebody
  // asked for it to. Read by the policy so a forwarded link cannot refund twice.
  feeRefundedAt      DateTime?
  feeRefundedCents   Int?

  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])

  // Paid-visit fee, captured when this was a paid booking type. feePaidCents is
  // what the client actually paid (promo price if a promo was on). The booking
  // is only confirmed once payment succeeds — a pending_payment booking holds
  // the slot until then. feeCreditedInvoiceId records the invoice the contractor
  // later credited this fee onto (so it can't be credited twice).
  feePaidCents             Int?
  feeCurrency              String?
  feeStripePaymentIntentId String?
  feeCreditedInvoiceId     String?

  // The Stripe Checkout Session this hold was sent to.
  //
  // Stripe already carries the link the other way (session.metadata.bookingId),
  // and for a long time that was the only link there was — which is precisely
  // why a webhook that never arrived was undetectable. Reconciliation has to run
  // FROM our side: "this booking says it is waiting for money, what does Stripe
  // say about it?" is a question that cannot be asked without this column.
  // See lib/booking/reconcileBookingFee.js.
  //
  // Nullable: holds created before this existed have none, and the reconciler
  // falls back to scanning Stripe around createdAt for them.
  feeCheckoutSessionId     String?

  // Why this booking is cancelled, when something other than a person cancelled
  // it. Today the only writer is the reconciler, stamping "payment_incomplete"
  // on a hold whose checkout was abandoned — read by the awaiting-payment panel
  // so a contractor sees "payment wasn't completed" rather than a slot that
  // silently evaporated.
  cancelReason             String?

  createdAt     DateTime      @default(now())
  /// Where the visit is. Collected from the client at booking time for
  /// in-person modes, and geocoded once so the scheduler can work out whether
  /// the estimator can physically get there from their previous job.
  ///
  /// Nullable, and null is meaningful: phone/video bookings have no address,
  /// and a geocode that fails leaves the coordinates null rather than zeroed.
  /// Travel filtering treats missing coordinates as "unknown", which never
  /// hides a slot — see lib/booking/travel.js.
  address   String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

}

// ============================================================
// WORKFORCE — Workers, Time Tracking, Payouts
// ============================================================

model Worker {
  id                        String     @id @default(cuid())
  companyId                 String
  company                   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                    String?    @unique
  user                      User?      @relation(fields: [userId], references: [id])
  // Who this person reports to. Null means the top of the chain — an owner, or
  // a company that has never drawn an org chart, which is most of them.
  //
  // Leave approval walks this: a request goes to the direct manager, and past
  // them to THEIR manager when they are away. Without it every owner and admin
  // could approve holiday for crews they have never met. See
  // lib/org/reportingLine.js.
  //
  // Self-relation on Worker rather than Member because Member is the auth and
  // role record, and this is about the crew: a leave request already points at
  // a Worker, and some workers have no login at all.
  managerId                 String?
  manager                   Worker?    @relation("WorkerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports                   Worker[]   @relation("WorkerReports")

  name                      String
  email                     String?
  phone                     String?
  address                   String?
  city                      String?
  province                  String?
  type                      WorkerType @default(contractor)
  hourlyRate                Decimal?   @db.Decimal(10, 2)

  /// Where this person's time COSTS the business: on a job, or on the business.
  ///
  /// Deliberately not the same question as `type` (contractor|employee), which
  /// is about how they are PAID and which decides a payment rail and nothing
  /// else. A bookkeeper and a cabinet installer can both be employees, and only
  /// one of them has hours that belong to a job.
  ///
  /// "field"  — their hours are direct labour. Costed to the jobs they log time
  ///            against, which is what actualJobCost already does.
  /// "office" — their hours are overhead. Nobody should be asking them which
  ///            job to bill an afternoon to.
  ///
  /// Defaulted to "field" rather than left null: every Worker row that exists
  /// today was created by a screen that only ever added people to do jobs, so
  /// "field" is what those rows actually mean. A null would be a third state
  /// nothing knows how to read.
  workType String @default("field")

  /// The week this person is paid for whether or not the work fills it — 37.5,
  /// 40, whatever the company guarantees. Null means they are paid only for the
  /// hours they log, which is the honest default and NOT the same as zero.
  ///
  /// Never defaulted to 40. An invented week here would invent unabsorbed
  /// labour for somebody who has none — the same refusal Salary.hoursPerWeek
  /// and ForecastSettings.jobsPerWeekCapacity already make, and for the same
  /// reason: this number ends up next to money.
  ///
  /// Read by lib/costing/utilisation.js, which reports the gap between this and
  /// the hours that reached a job. It does NOT feed the price floor: see the
  /// note there on why that is a separate, deliberate switch.
  scheduledHoursPerWeek Decimal? @db.Decimal(6, 2)

  // When this person actually started. NOT the same as createdAt, which is when
  // the row was made — a five-year employee whose Worker row was backfilled
  // yesterday has a createdAt of yesterday, and using that to pro-rate their
  // holiday entitlement would cut it to a fraction. Nullable on purpose: no
  // hire date means "we don't know", which is why leave accrual grants the full
  // allotment rather than inventing a start date. See lib/leave/balances.js.
  hiredOn                   DateTime?

  stripeConnectedAccountId  String?
  payrollProviderEmployeeId String?
  active                    Boolean    @default(true)
  createdAt                 DateTime   @default(now())

  timeEntries TimeEntry[]
  shifts      Shift[]
  payouts     Payout[]
  salaries    Salary[]
  payRunLines PayRunLine[]
  salaryComponents WorkerSalaryComponent[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
}

model TimeEntry {
  id           String          @id @default(cuid())
  workerId     String
  worker       Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobId        String?
  job          Job?            @relation(fields: [jobId], references: [id])
  clockIn      DateTime
  clockOut     DateTime?
  hours        Decimal?        @db.Decimal(6, 2)
  approvedById String?
  approvedBy   User?           @relation("TimeEntryApprovedBy", fields: [approvedById], references: [id])
  status       TimeEntryStatus @default(pending)
  createdAt    DateTime        @default(now())
}

// A scheduled shift assigned to a worker. Distinct from TimeEntry (hours the
// worker ACTUALLY clocked) and from AvailabilitySchedule (when they CAN work) —
// a Shift is the plan the manager publishes. Draft shifts are the manager's
// working copy; `published` is the line the worker is allowed to see, so a
// half-built week never shows up on someone's phone.
model Shift {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  start     DateTime
  end       DateTime
  note      String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  /// Set when a manager scheduled this OUTSIDE what the worker said they were
  /// available for, and chose to go ahead.
  ///
  /// ── Why this is a column and not a confirm dialog ────────────────────────
  ///
  /// A confirmation that lives only in the manager's browser is theatre: they
  /// click OK, feel informed, and the worker still finds out on the morning.
  /// Recorded here, the shift can say so in the rota, on the worker's own
  /// screen when it is published, and afterwards if anyone disagrees about what
  /// was agreed.
  ///
  /// Null means the shift fitted, which is the ordinary case. A timestamp
  /// rather than a boolean for the same reason Job.archivedAt is one — "when
  /// was this decided" is worth knowing and costs nothing.
  ///
  /// APPROVED LEAVE IS NOT OVERRIDABLE and never sets this. Availability is a
  /// statement about preference and emergencies are real; leave is a decision
  /// the company already made and honoured, and the way to change it is to
  /// amend the leave — which involves the person whose day off it is.
  availabilityOverrideAt   DateTime?
  availabilityOverrideById String?
  availabilityOverrideBy   User?     @relation("ShiftAvailabilityOverride", fields: [availabilityOverrideById], references: [id])
  /// Optional. The fact is what matters and an emergency should not be gated on
  /// typing, but a reason makes the record worth reading later.
  availabilityOverrideNote String?

  @@index([companyId, start])
  @@index([workerId, start])
}

model Payout {
  id          String       @id @default(cuid())
  workerId    String
  worker      Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  amount      Decimal      @db.Decimal(12, 2)
  periodStart DateTime
  periodEnd   DateTime
  method      PayoutMethod @default(stripe_transfer)
  status      PayoutStatus @default(pending)
  createdAt   DateTime     @default(now())
}

// ============================================================
// FINANCE — Expenses, Marketing, Salaries, Debt, Forecast
// ============================================================

model Expense {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    String
  amount      Decimal          @default(0) @db.Decimal(12, 2)
  date        DateTime         @default(now())
  notes       String?
  projectId   String?
  isOverhead  Boolean          @default(false)
  recurring   Boolean          @default(false)
  frequency   ExpenseFrequency @default(one_time)
  materialId  String?
  material    Material?        @relation(fields: [materialId], references: [id])
  // Who recorded it. Added because the permission grid offers "Expenses:
  // view, record, and edit THEIR OWN" and there was no way to tell whose an
  // expense was — the level was unenforceable, so everyone saw everything
  // regardless of what was configured.
  //
  // Nullable: rows that predate this have no owner, and a restricted member
  // won't see them. That's the honest outcome — we genuinely don't know who
  // entered them — but it means existing expenses effectively become
  // admin-only.
  createdById String?
  createdAt   DateTime         @default(now())

  // ── Bills due: the state a cost has BEFORE it is paid ────────────────────
  //
  // The owner, on why this is smaller than "accounts payable" sounds: "i don't
  // think hydro ottawa or other companies take payments through quickbook but
  // either credit card payments or payments through a bank... i would assume
  // that they log the information like we do in overhead."
  //
  // He is right. There is no payment rail to build. What was missing is only
  // the state a cost has between arriving and being settled — owed, due on a
  // date, not yet paid — so the month's outgoings can be seen before they
  // leave rather than reconstructed afterwards.
  //
  // ── Why two columns here and not a Bill model ────────────────────────────
  //
  // A bill IS an expense; the only thing a separate model would add is a
  // second table holding the same category and amount, and a contractor who
  // recorded the hydro bill in both would double their own price floor with
  // nothing on the way telling them so. That is precisely the argument
  // app/api/overhead/fixed-costs/route.js already makes for not inventing a
  // FixedCost model, and it applies unchanged.
  //
  // ── Why a dueDate is what MAKES a row a bill ─────────────────────────────
  //
  // Every Expense that predates these columns has dueDate null, and null must
  // not read as "overdue since forever". So the bills list selects on
  // `dueDate != null`: a row becomes a bill when somebody says when it is due,
  // and a receipt for fuel already paid stays a receipt. Absence of a
  // statement is not a statement.
  dueDate DateTime?

  // When it was actually settled. Null means outstanding — but only for a row
  // that has a dueDate; see above. A timestamp rather than a boolean because
  // "paid" without "when" cannot answer the one question the screen is for.
  paidAt DateTime?

  priceEntries MaterialPriceEntry[]

  // ── Import provenance — CSV today, a bank aggregator later ───────────────
  //
  // The owner evaluated Plaid and rejected it for now: no published pricing,
  // four-figure monthly contract minimums, and it doesn't support Canadian
  // bank accounts at all — a hard blocker for a contractor base that includes
  // Ottawa. CSV import gets most of the value at zero recurring cost and no
  // bank credentials held. But it's a stepping stone, not the permanent
  // shape: once there are enough paying companies to justify a Plaid
  // contract, that integration has to write into the SAME ledger, or a
  // contractor who used CSV for a year gets a wall between two eras of their
  // own books.
  //
  // So these three columns exist before there is a second writer. Nothing
  // but the CSV importer (lib/expenses/csvImport.js, app/api/expenses/import/*)
  // writes them today — normally the sign of a dead field, called out here so
  // it reads as deliberate groundwork instead. `externalId` in particular is
  // written by nothing yet at all; it is reserved for Plaid's own transaction
  // id, so that integration can backfill this shape rather than migrate it.
  //
  // Null on every row that predates this and on everything typed by hand on
  // Settings -> Expense Tracking — "we don't know" and "entered manually" are
  // both real answers, and neither is the string "csv_upload".
  importSource  String?
  importBatchId String?
  importBatch   ExpenseImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  // Stable id FROM THE SOURCE SYSTEM. The CSV importer never writes this — a
  // spreadsheet has no such id, and duplicate detection for CSV rows works on
  // date + amount + normalised description instead (see naturalKey in
  // lib/expenses/csvImport.js), scoped to companyId and deliberately blind to
  // source so a later Plaid delivery of the same transaction is recognised as
  // the same row rather than a second one.
  externalId    String?

  @@index([companyId, createdById])
  // The bills query: this company's dated, unsettled rows, oldest first.
  @@index([companyId, dueDate])
  // Duplicate detection and the trend chart both scan a company's expenses by
  // date range; this is that query's index.
  @@index([companyId, date])
  @@index([importBatchId])
  // Nulls are distinct in Postgres, so the years of rows that predate
  // externalId — and every CSV-imported row, which never sets it — don't
  // collide with each other. Only two real external ids landing on the same
  // company would collide, which is exactly the point: that's Plaid
  // redelivering a transaction it already sent.
  @@unique([companyId, externalId])
}

// One CSV upload, reviewed and committed in one sitting. Exists for two
// reasons: idempotency (see idempotencyKey below) and provenance — "which
// file did these 40 rows come from" is a question a contractor reconciling a
// statement will actually ask, and a bare importSource string on the Expense
// row can't answer "which upload, which time".
model ExpenseImportBatch {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // The member who ran the import. Nullable for the same reason
  // Expense.createdById is: a session without a userId (support
  // impersonation, which is read-only and can't reach this route at all, but
  // the column shouldn't assume that forever) shouldn't crash the write.
  createdById String?
  // "csv_upload" today. A future "plaid" batch would represent one sync run
  // rather than one file — see the Expense.importSource comment for why this
  // column exists ahead of that integration.
  source      String   @default("csv_upload")
  filename    String?
  // Generated once by the browser when the review screen loads
  // (crypto.randomUUID()) and resubmitted unchanged on every commit attempt
  // for that review session. A double-submit — a slow response and an
  // impatient second click, or a retried fetch — carries the same key, so the
  // commit route finds the batch it already wrote instead of writing the
  // rows twice. Unique per company rather than globally: it only has to
  // disambiguate one company's concurrent imports, and scoping it tighter is
  // free.
  idempotencyKey String
  rowCount       Int      @default(0)
  duplicateCount Int      @default(0)
  createdAt      DateTime @default(now())
  expenses       Expense[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
}

model MarketingSpend {
  id           String            @id @default(cuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform     MarketingPlatform @default(other)
  campaignName String?
  amount       Decimal           @default(0) @db.Decimal(12, 2)
  impressions  Int?
  clicks       Int?
  leads        Int               @default(0)
  conversions  Int?
  date         DateTime          @default(now())
  notes        String?
  createdAt    DateTime          @default(now())
}

// ── Leave / PTO ─────────────────────────────────────────────────────────────
//
// Modelled on Frappe HR's split: a POLICY defines the rule, a BALANCE holds
// what one person has accrued and used, a REQUEST is someone asking for time
// off. Keeping balance separate from request history is what makes "how many
// days do I have left" a single cheap read instead of a replay of every request.
//
// Why this matters here specifically: leave touches BOTH payroll (paid leave is
// an earning; unpaid is not) and scheduling (don't book an estimator who's
// away). Those are the two systems a field-service company runs on, which is
// why this was the biggest gap.

model LeavePolicy {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String // "Vacation", "Sick leave", "Unpaid leave"
  // vacation | sick | personal | unpaid | other — drives labels and whether it
  // defaults to paid.
  kind String @default("vacation")

  // Is time off under this policy paid? Unpaid leave still needs tracking (for
  // scheduling and for a record), it just doesn't reach payroll as an earning.
  paid Boolean @default(true)

  // How entitlement builds up:
  //   annual_allotment — a fixed number of days granted each year
  //   per_period       — accrues each pay period (annualDays / periods)
  //   percent_of_gross — vacation PAY as a share of earnings (the common
  //                      Canadian 4% = two weeks model). Accrues money, not days.
  accrualMethod String @default("annual_allotment")

  annualDays     Decimal? @db.Decimal(6, 2)
  percentOfGross Decimal? @db.Decimal(6, 3)

  // Days that may roll into next year. Null = unlimited, 0 = use it or lose it.
  // Null and 0 are genuinely different answers and must not collapse.
  carryoverMaxDays Decimal? @db.Decimal(6, 2)

  // Whether a request needs approving. Some companies auto-approve sick days.
  requiresApproval Boolean @default(true)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, name])
}

// One person's standing under one policy for one year.
//
// `accruedDays`/`accruedAmount` are what they've earned, `usedDays`/`usedAmount`
// what they've taken. Remaining is derived, never stored — a stored remainder
// is the field that drifts.
model LeaveBalance {
  id        String      @id @default(cuid())
  policyId  String
  policy    LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  workerId  String
  worker    Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  year      Int

  accruedDays   Decimal @default(0) @db.Decimal(8, 2)
  usedDays      Decimal @default(0) @db.Decimal(8, 2)
  carriedInDays Decimal @default(0) @db.Decimal(8, 2)

  // For percent_of_gross policies, which accrue money rather than days.
  accruedAmount Decimal @default(0) @db.Decimal(12, 2)
  usedAmount    Decimal @default(0) @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt

  @@unique([policyId, workerId, year])
}

model LeaveRequest {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  policyId  String
  policy    LeavePolicy @relation(fields: [policyId], references: [id])
  workerId  String
  worker    Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  // Working days requested — computed at submit time and stored, because the
  // company's working week can change and a past request must keep meaning what
  // it meant.
  days      Decimal  @db.Decimal(6, 2)
  halfDay   Boolean  @default(false)

  reason String?
  // pending | approved | declined | cancelled
  status String  @default("pending")

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, startDate])
  @@index([workerId, status])
}

// A reusable named earning or deduction — Frappe HR's "Salary Component"
// pattern. Set up once per company ("CPP", "Income tax", "Union dues", "Tool
// allowance"), then assigned to workers.
//
// Three calculation shapes, because real components come in all three:
//   fixed    — a flat amount per period (union dues, health premium)
//   percent  — a share of gross (CPP 5.95%, EI 1.66%)
//   slabs    — progressive brackets (income tax); see taxFromSlabs
//
// `statutory` marks the ones that exist because a government requires them, so
// the payslip can group them separately and a company can see at a glance
// whether its statutory set is configured at all. FieldQuo never invents these
// rates: they are seeded from published tables as a STARTING POINT the company
// confirms, and thereafter they're the company's own numbers.
model SalaryComponent {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String
  // earning | deduction
  kind String  @default("deduction")
  // fixed | percent | slabs
  calculation String @default("fixed")

  amount  Decimal? @db.Decimal(12, 2)
  percent Decimal? @db.Decimal(6, 3)
  // [{ upTo: number|null, percent: number }] ascending. Annual thresholds.
  slabs   Json?

  statutory Boolean @default(false)
  // CA | US | UK — which regime this belongs to, for grouping and for warning
  // when a company's region and its components disagree.
  region    String?
  active    Boolean @default(true)

  // Applies to everyone by default (statutory usually does); otherwise it only
  // applies to workers it's explicitly assigned to.
  appliesToAll Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments WorkerSalaryComponent[]

  @@unique([companyId, name])
}

// A component assigned to one worker, optionally overriding the amount/percent
// (someone's union dues or garnishment differ from the default).
model WorkerSalaryComponent {
  id          String          @id @default(cuid())
  workerId    String
  worker      Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  componentId String
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  amount  Decimal? @db.Decimal(12, 2)
  percent Decimal? @db.Decimal(6, 3)

  createdAt DateTime @default(now())

  @@unique([workerId, componentId])
}

// One payroll period for a company: draft → approved → paid.
//
// ── What FieldQuo is and isn't doing here ───────────────────────────────────
//
// It computes GROSS pay from data it owns and can be right about: approved
// hours × rate, overtime, salary ÷ periods, plus adjustments someone typed.
// Statutory deductions (CPP/EI, FICA, PAYE/NI) are NOT calculated from tax
// tables — those change annually per jurisdiction and getting them wrong bills
// the employer for penalties. Instead each line carries deductions the company
// (or its accountant) supplied, and net is the arithmetic on top. The payslip
// says which is which, so nobody mistakes an estimate for a filing.
//
// See lib/payroll/computePayRun.js for the arithmetic and why it's pure.
model PayRun {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  // draft | approved | paid | cancelled. A string, not an enum: payroll states
  // vary by how a company actually operates and adding one shouldn't migrate.
  status      String   @default("draft")

  // Totals, denormalised at approval so a payslip can never be re-derived into
  // a different number than the one that was approved and paid.
  grossTotal     Decimal @default(0) @db.Decimal(12, 2)
  deductionTotal Decimal @default(0) @db.Decimal(12, 2)
  netTotal       Decimal @default(0) @db.Decimal(12, 2)

  // Which tax regime's LABELS the payslip uses (CA | US | UK). Labels only —
  // it does not imply FieldQuo calculated or remitted anything.
  region String @default("CA")

  notes        String?
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines PayRunLine[]

  @@index([companyId, periodStart])
}

// One worker's pay for one run — the payslip row.
model PayRunLine {
  id       String @id @default(cuid())
  payRunId String
  payRun   PayRun @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  workerId String
  worker   Worker @relation(fields: [workerId], references: [id])

  // Captured at run time, not joined at read time: a rate change next month
  // must not rewrite what a past payslip says was paid.
  workerName String
  workerType String // employee | contractor — drives whether Stripe payout is offered
  hourlyRate Decimal? @db.Decimal(10, 2)

  regularHours  Decimal @default(0) @db.Decimal(8, 2)
  overtimeHours Decimal @default(0) @db.Decimal(8, 2)

  // [{ label, amount, kind: "earning"|"deduction", source: "hours"|"salary"|"manual" }]
  // Kept as one ordered list so the payslip prints exactly what was computed,
  // in order, without the renderer re-deciding anything.
  items Json?

  gross     Decimal @default(0) @db.Decimal(12, 2)
  deductions Decimal @default(0) @db.Decimal(12, 2)
  net       Decimal @default(0) @db.Decimal(12, 2)

  // Set when this line has actually been paid out, and how.
  paidAt   DateTime?
  payoutId String?

  createdAt DateTime @default(now())

  @@unique([payRunId, workerId])
}

model Salary {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workerId  String?
  worker    Worker?          @relation(fields: [workerId], references: [id])
  name      String
  amount    Decimal          @db.Decimal(12, 2)
  frequency ExpenseFrequency @default(monthly)

  // Only set when `frequency` is `hourly`, where `amount` is a rate rather
  // than a sum. Required in that case and meaningless otherwise: an hourly
  // rate with no hours attached cannot become a monthly cost, and defaulting
  // it to a 40-hour week would put an invented number into a PRICE FLOOR —
  // the same failure the capacity default in lib/analytics/minimumPrice.js was
  // removed for. burnRate contributes 0 when it's missing.
  hoursPerWeek Decimal?      @db.Decimal(6, 2)

  startDate DateTime         @default(now())
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
}

model Debt {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  principal      Decimal  @db.Decimal(12, 2)
  interestRate   Decimal  @default(0) @db.Decimal(6, 3)
  monthlyPayment Decimal  @db.Decimal(12, 2)
  startDate      DateTime @default(now())
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  // The capital items this loan bought. Populated, this is what stops the
  // truck being charged twice — see the Asset model below.
  assets         Asset[]
}

// ── A capital item that wears out ───────────────────────────────────────────
//
// The owner's sentence: "i have a truck i still pay it is an overhead but it's
// also an asset that depreciates." Three facts about one truck, and the
// product could only hold one of them.
//
// ── Why this is not another Expense row ────────────────────────────────────
//
// An Expense is money that LEFT. A $60,000 truck is money that turned into a
// thing, and the cost lands over the years it is used — $12,000 a year for
// five years, whether or not the loan is still running. Recorded as an
// Expense it is either one $60,000 month (a price floor nobody could quote
// against) or a $1,000 recurring row that keeps charging forever, long after
// the truck is worth nothing. Neither is the number.
//
// The failure this exists to stop is the quiet one: a contractor counts the
// loan payment as overhead, the loan ends, they drop it — and the truck is
// still wearing out and still needs replacing. Their break-even price falls
// below the truth with nothing anywhere saying so.
//
// ── Why straight-line only, and no method column ───────────────────────────
//
// Declining-balance and units-of-production are real methods and neither
// belongs here. A trades business wants one number it can defend to itself
// and its accountant, and a method picker is a dial whose two extra positions
// change the price floor for reasons the person choosing cannot evaluate.
// A method column that only ever holds one value is a feature flag for a
// feature that does not exist (AGENTS.md failure class #8). If an accountant
// ever needs declining balance for the tax return, that is a tax-return
// concern; this number exists to price work.
//
// ── Why months rather than years ───────────────────────────────────────────
//
// Vehicle finance and useful life are both quoted in months in the trade
// ("60 months"), the charge this feeds is monthly, and an integer year count
// forced to a monthly figure re-introduces the rounding it was meant to avoid.
model Asset {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  // What it cost to put into service. Not what it is worth now — book value is
  // derived (lib/accounting/depreciation.js), never stored, because a stored
  // one goes stale the day after it is written and nothing would update it.
  cost Decimal @db.Decimal(12, 2)

  // What it will still be worth at the end of its life. Optional in practice
  // (most contractors leave it at zero) but load-bearing when it is set: the
  // depreciable base is cost MINUS salvage, so a $60k truck worth $10k at
  // trade-in charges $50k over its life, not $60k.
  salvageValue Decimal @default(0) @db.Decimal(12, 2)

  // When it started being used, which is when the charge starts — not the
  // purchase date and not the date this row was typed. A truck bought in
  // December and put on the road in March has three months of no charge.
  inServiceDate DateTime @default(now())

  usefulLifeMonths Int

  // Sold, written off or traded in. Nullable and never defaulted: an absent
  // disposal date means "still ours", which is a fact, whereas a defaulted one
  // would be an invented disposal (AGENTS.md failure class #5).
  disposedOn DateTime?

  active Boolean @default(true)

  // The loan that bought it, if there is one. THIS is the double-count guard:
  // linked, the loan contributes its INTEREST to the price floor and the
  // depreciation carries the capital cost. Unlinked, the loan contributes its
  // whole payment, because nothing else is carrying that cost.
  //
  // SetNull, not Cascade: paying a truck off deletes nothing about the truck.
  // Cascading would delete the ASSET when the debt row goes, which is the
  // exact moment the depreciation charge matters most.
  debtId String?
  debt   Debt?   @relation(fields: [debtId], references: [id], onDelete: SetNull)

  notes     String?
  createdAt DateTime @default(now())

  @@index([companyId, active])
  @@index([debtId])
}

// ── Twelve of these thirteen columns are unused ─────────────────────────────
//
// `jobsPerWeekCapacity` is read by lib/analytics/minimumPrice.js and set from
// /app/settings/overhead. Every other column here is written by nothing and read
// by nothing: no route accepts them, no screen shows them, no calculation
// consumes them. They are a forecasting model that was scaffolded and never
// built on.
//
// Left in place rather than dropped — the defaults are considered and someone
// clearly intended a forecasting feature — but do NOT put them on a settings
// form until something reads them. A form whose inputs save and change nothing
// is the exact failure this codebase keeps being swept for; see AGENTS.md.
model ForecastSettings {
  id                  String    @id @default(cuid())
  companyId           String    @unique
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteSentToPaid     Decimal   @default(0.35) @db.Decimal(6, 3)
  invoiceSentToPaid   Decimal   @default(0.80) @db.Decimal(6, 3)
  avgJobValue         Decimal   @default(7000) @db.Decimal(12, 2)
  jobsPerWeekCapacity Int       @default(3)
  leadsPer1000        Decimal   @default(12) @db.Decimal(8, 2)
  leadToSale          Decimal   @default(0.60) @db.Decimal(6, 3)
  curveType           CurveType @default(log)
  curveA              Decimal   @default(18) @db.Decimal(12, 4)
  curveB              Decimal   @default(0.0018) @db.Decimal(12, 6)
  smoothingAlpha      Decimal   @default(0.35) @db.Decimal(6, 3)
  useCalendarYear     Boolean   @default(true)
  updatedAt           DateTime  @updatedAt
}

// ============================================================
// MATERIALS
// ============================================================

// ⚠️ ORPHANED — the feature these two backed was deleted, the TABLES were not.
//
// /app/settings/materials, /api/materials, getMaterialTrends and the expense
// tagging that fed it are all gone: the catalogue could never produce a trend,
// because MaterialPriceEntry rows are only written when an expense carries a
// materialId and no UI ever sent one. The screen was a list you could add to
// and nothing on earth read.
//
// The models stay because `Material` holds a real row belonging to a real
// company. Removing them from this file makes `prisma db push` DROP the tables
// and that row with them, which is a data decision and not a code one. Left
// here, they cost nothing and destroy nothing.
//
// To finish the removal: confirm with the owner, export anything worth keeping,
// then delete both models and push. Until then, do not wire anything new to
// them — the feature is gone on purpose.
model Material {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  unit             String?
  category         String?
  currentAvgCost   Decimal? @db.Decimal(12, 2)
  reorderThreshold Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  expenses     Expense[]
  priceEntries MaterialPriceEntry[]
}

model MaterialPriceEntry {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  expenseId  String?
  expense    Expense? @relation(fields: [expenseId], references: [id])
  price      Decimal  @db.Decimal(12, 2)
  date       DateTime @default(now())
  supplier   String?
  createdAt  DateTime @default(now())
}

