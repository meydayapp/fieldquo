// ============================================================
// REFERRALS (company → company)
// ============================================================
//
// Distinct from ReferralLink above, which is a company's CLIENT referring
// another homeowner to that company. This is FieldQuo's own growth loop: one
// contractor telling another contractor about the product.
//
// Reward rules, encoded here so they aren't scattered across route handlers:
//
//   * The new company's 3 months are granted at signup. That's their trial —
//     it costs nothing if they churn, and it's the thing that makes the offer
//     worth clicking.
//   * The referrer's 3 months are granted on the referred company's FIRST
//     PAYMENT, not their signup. Paying out on signup alone makes this a
//     fraud target: twenty throwaway emails would earn five free years.
//   * A company that already exists can refer but can never redeem. The offer
//     acquires new customers; letting existing ones redeem just discounts
//     revenue you already had.

model ReferralInvite {
  id        String  @id @default(cuid())
  // Who sent it.
  companyId String
  company   Company @relation("ReferralInvitesSent", fields: [companyId], references: [id], onDelete: Cascade)

  // Exactly one of these is set. Kept as plain strings rather than a Contact
  // relation because the recipient is, by definition, not in the system yet.
  email String?
  phone String?

  channel ReferralChannel
  status  ReferralInviteStatus @default(sent)

  // Set when a company signs up carrying this invite's referral code and
  // matching contact details. Not a hard link — someone can forward the link
  // to a colleague, and that referral should still count for the sender.
  redeemedByCompanyId String?   @unique
  redeemedAt          DateTime?

  // Twilio/Resend id, so a delivery complaint can be traced to a send.
  providerMessageId String?
  error             String?

  sentByUserId String?
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
}

// A granted "3 free months". One row per grant so the reason and the source
// are auditable — a support question about a company's billing date should be
// answerable without reading application logs.
model ReferralCredit {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("ReferralCreditsEarned", fields: [companyId], references: [id], onDelete: Cascade)

  // The other company in the relationship: for a referrer's credit this is
  // the company they referred; for a new company's credit it's their referrer.
  counterpartyCompanyId String?

  role   ReferralRole
  // Referee ("referred") side: free months added to their trial. Referrer side
  // no longer uses months — its reward is a dollar credit (below).
  months Int          @default(1)

  // The trial end date this credit produced (referee side), captured at grant
  // time. Storing it means a later change to the reward size can't retroactively
  // rewrite what a company was actually given.
  appliedTrialEndsAt DateTime?

  // Referrer side: the account credit earned, in cents, = one month of the
  // REFERRED company's plan (their seats × their rate). Applied to the referrer's
  // Stripe customer balance. stripeBalanceTxnId is set once actually applied;
  // null means earned-but-not-yet-applied (e.g. the referrer has no Stripe
  // customer yet because they're still on trial — applied when they start paying).
  creditCents        Int?
  currency           String?
  stripeBalanceTxnId String?

  createdAt DateTime @default(now())

  // One credit per company per role per counterparty. Without this, a webhook
  // retry or a double-clicked button grants the reward twice.
  @@unique([companyId, role, counterpartyCompanyId])
  @@index([companyId])
  // For the 50-referrals-per-month cap and the pending-credit sweep.
  @@index([companyId, role, createdAt])
}

enum ReferralChannel {
  email
  sms
  link
}

enum ReferralInviteStatus {
  sent
  failed
  redeemed
}

enum ReferralRole {
  referrer
  referred
}

// ============================================================
// AI USAGE & QUOTA
// ============================================================
//
// Every model call is metered. Two reasons, and the second is the important
// one:
//
//   1. Cost visibility. FieldQuo pays OpenAI, not the company, so without a
//      per-tenant record there is no way to know whether AI costs $4/month or
//      $400 — or which company is responsible.
//   2. Abuse containment. A scripted loop against /api/ai/copilot is an
//      unmetered spend on FieldQuo's card. A cap turns a potentially unbounded
//      bill into a known maximum.
//
// Recorded AFTER the call, from the provider's own usage numbers rather than
// an estimate — a tool-use loop can make several round trips for one question,
// and counting the question rather than the tokens would understate it badly.

model AiUsage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which part of the product spent this: "copilot", "expense_summary",
  // "monthly_digest", "translation". Lets a spike be traced to a feature
  // rather than just a company.
  feature String
  model   String

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  // Cost in millionths of a dollar (micros). Integers, not floats — a
  // single call can cost $0.0004, and summing floats over thousands of rows
  // accumulates error into a number people will compare against an invoice.
  costMicros Int @default(0)

  // Null for background jobs (digests, cron). Set for anything a person
  // triggered, so "who is generating all this" is answerable.
  userId String?

  createdAt DateTime @default(now())

  // Every read is "this company, this month", so the index matches.
  @@index([companyId, createdAt])
  @@index([createdAt])
}

// A company's public website.
//
// ── Why its own table ───────────────────────────────────────────────────────
//
// `blocks` is the whole page and gets read on every public page view. Putting
// it on Company would drag it into every getCurrentMember(), every settings
// screen and every quote render — a few kilobytes of marketing copy loaded
// hundreds of times a day by code that will never look at it.
//
// ── Why the subdomain is stored here and not reused from Company.slug ───────
//
// It's SEEDED from Company.slug, which is what the company already knows
// themselves as, so there's nothing to invent at setup. But once a site is
// live the address is in print, on a van, and in Google's index — it must not
// move because someone renamed their company in Settings. Copying it once and
// letting them change it deliberately is the difference between a URL and an
// accident.
model CompanySite {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // The subdomain: <subdomain>.fieldquo.com. Unique across the platform and
  // checked against RESERVED_SUBDOMAINS in lib/site/subdomain.js.
  subdomain String @unique

  // The page itself: an ordered array of typed blocks. See
  // app/data/siteBlocks.js for the shapes. Json rather than a Block table
  // because the whole page is always read and written together — a relational
  // split would buy queryability nobody needs and cost a join per section.
  //
  // `blocks` is the ORIGINAL single-page model and stays as the Home page's
  // content for backward compatibility — every existing site has it and nothing
  // migrates. `pages` is the multi-page model layered on top: an ordered list of
  // { id, slug, title, nav, blocks } so a site can have Home / Services / About
  // / Work / Contact as real pages with a real menu. Null `pages` means "single
  // page" and the renderer falls back to `blocks` as Home — see lib/site/pages.js.
  blocks Json?
  pages  Json?

  // Nothing is public until this is true. Distinct from having blocks: a
  // company can generate, edit and preview for a week before going live.
  published   Boolean   @default(false)
  publishedAt DateTime?

  // Answers to the setup interview, kept so regenerating doesn't ask again.
  interview Json?

  // The DESIGN style — what makes two companies' sites look different rather
  // than merely read differently. One of a closed set (lib/site/siteStyles.js):
  // modern | bold | minimal | classic | warm. The AI picks it from the
  // company's free-text description, and the company can override it. Colours
  // and logo still come from Branding; a style changes type scale, weight,
  // rhythm and corner treatment, never the palette.
  styleKey String? @default("modern")

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])

  // The conversation. Lovable-style iteration means the thread IS the interface:
  // what you asked for, what was built, and what it still needs. Kept so
  // reopening the builder shows the history rather than a blank box that has
  // forgotten everything you told it.
  //
  // [{ role: "user"|"assistant", text, at, meta? }] — capped in the route.
  chat Json?

  // Photo library for the site, independent of any one block.
  //
  // Before/after pairing needs a pool to pair FROM: you upload six photos and
  // then say which two go together. Storing them only inside a gallery block
  // meant an unpaired photo had nowhere to live, which is why "I can upload 3, 4,
  // 6 — how will it know which is which" had no answer.
  //
  // [{ url, label?, at }]
  photoLibrary Json?

  // When someone last edited the copy BY HAND in the Sections pane.
  //
  // Regenerating rewrites every text field. Photos and before/after pairs are
  // carried across, but hand-written words are not — so a company that spent
  // twenty minutes rewording their about section and then typed a new prompt
  // silently lost it. This is what the confirmation before regenerating reads,
  // and it has to be persisted rather than held in component state: the twenty
  // minutes and the regeneration are often on different days.
  //
  // Cleared on generation, because at that point the copy IS the generated copy
  // and there is nothing of theirs left to warn about.
  handEditedAt DateTime?

  // Which languages this site is published in. The FIRST is the primary — the
  // one served at the root URL — and the rest get /<code> paths.
  //
  // Defaults to the company's own defaultLanguage at creation. Empty is treated
  // as [defaultLanguage] rather than "no languages", because a site that renders
  // in nothing is not a state worth representing.
  languages String[] @default(["en"])

  // Generated CONTENT for the non-primary languages:
  //   { fr: { blocks, seoTitle, seoDescription }, es: {...} }
  //
  // Generated per language and STORED, not machine-translated at request time.
  // Translating on the fly would give two visitors different words for the same
  // page, re-translate on every render, and cost a model call per pageview. The
  // site's furniture is a static table (lib/site/siteCopy.js); this is the part
  // that is actually written per company.
  translations Json?
}

// Per-company, per-trade configuration for the public instant estimator.
//
// The estimator NEVER prices off our defaults — it prices off this row. A
// trade with no row (or enabled=false) is simply not offered as an instant
// quote, which is how non-negotiable #4 (public endpoints don't publish a rate
// card WE invented) stays true: every number a homeowner sees traces to sell
// rates this company reviewed and saved.
//
// `config` is a Json blob whose shape mirrors INSTANT_ESTIMATE_DEFAULTS[trade]
// in lib/estimate/instantEstimate.js — material rows with sell rates, surcharge
// maps, range band, minimum charge. Kept as Json rather than columns because
// the shape differs per trade (roofing has $/square, lawn has size tiers) and
// a column-per-field schema would be mostly nulls. The estimator validates it
// at price time, so a malformed blob degrades to "not configured", never a bad
// price.
model InstantQuoteConfig {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Estimator trade key: roofing | epoxy | parging | lawn_mowing |
  // cabinet_refacing. Maps to a ServiceCategory key, but named `trade` because
  // the estimator's unit of configuration is the pricing model, not the
  // catalogue entry (roofing_service the category vs. roofing the estimator).
  trade     String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, trade])
}

/// Who produced the CURRENT stored version of one record — the "who" behind
/// the stale-write banner (lib/concurrency/staleWrite.js).
///
/// ── Why this is not a column on Quote/Invoice/Job ──────────────────────────
///
/// The obvious shape is `updatedById` beside `updatedAt`, and it is wrong here
/// for one reason: only the GUARDED routes would ever set it. Every other
/// writer — a lifecycle hook, the public quote-acceptance route, a cron sweep
/// — bumps `updatedAt` and leaves `updatedById` pointing at whoever last used
/// a guarded route. The banner would then name a colleague who did not make
/// the change, confidently and wrongly, which is worse than not knowing.
///
/// So the editor is recorded together with the exact version they produced.
/// `versionAt` is the record's `updatedAt` AFTER that write. The banner names
/// a person only when `versionAt` still equals the record's current
/// `updatedAt`; anything else means somebody or something not covered here
/// wrote last, and the banner says "someone on your team" rather than
/// inventing a name (AGENTS.md failure class #5 — absence of a statement is
/// not a statement).
///
/// One row per record, replaced on each guarded write: this is "who holds the
/// current version", not a history. The history is ActivityLog, below.
model RecordEdit {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Matches the `entity` string the route passes to the guard, e.g. "quote".
  /// Not an enum: adding a guarded model is a code change in one place, and a
  /// Postgres enum would make it a db push as well.
  entityType String
  entityId   String

  /// Nullable because the User row can be deleted later; `editorName` is
  /// resolved and frozen at write time for exactly that case, the same way
  /// ActivityLog.actorName is.
  editorUserId String?
  editorName   String?

  /// The record's `updatedAt` immediately after the write this row describes.
  versionAt DateTime

  createdAt DateTime @default(now())

  @@unique([companyId, entityType, entityId])
  @@index([companyId, createdAt])
}

// A tenant-side audit trail: who did what inside a company's own app. This is
// deliberately SEPARATE from PlatformAuditLog (which records FieldQuo staff
// actions). Before this existed, support could see a company's current state
// but never "who deleted this client" or "who changed this price" — the single
// most common support question had no answer anywhere in the schema.
//
// Written best-effort by lib/activity/log.js — a logging failure must never
// fail the user's actual action, so nothing here is in a transaction with the
// thing it records. That means the log can miss an event under failure, which
// is the honest trade: an audit trail that can occasionally drop a row beats
// one that can roll back a customer's quote.
//
// Actor identity is CAPTURED at write time (name + role), not just referenced,
// so a departed employee or a renamed user doesn't erase who did it.
model ActivityLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actorUserId   String?
  actorMemberId String?
  actorName     String?
  actorRole     String?
  // True if the action came through a platform-support impersonation session.
  // Support is read-only, so a write under impersonation should be impossible —
  // if one ever shows up here, that's precisely what an audit trail is for.
  viaImpersonation Boolean @default(false)

  // Dotted verb, e.g. "quote.sent", "client.deleted", "payment.recorded".
  action     String
  entityType String? // "quote" | "invoice" | "client" | "payment" | "settings" | ...
  entityId   String?
  // Human-readable one-liner shown in the log, composed at write time.
  summary    String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}

// ── Voice: the AI receptionist ───────────────────────────────────────────────

/// A phone number the AI receptionist answers on.
///
/// Three ways a company gets one, and they are genuinely different products —
/// see lib/voice/numbers.js:
///   purchased — we buy it from the provider. Instant, theirs to keep.
///   forwarded — they keep their own number and forward calls to ours. The
///               DEFAULT migration path: reversible in a minute, no paperwork,
///               and their number keeps working everywhere else it's printed.
///   ported    — the number itself moves to us. Weeks, irreversible in
///               practice, and their business line is at risk if it stalls.
model VoicePhoneNumber {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// E.164, always. Stored normalised so a lookup from a webhook can't miss on
  /// formatting — the provider sends +15551234567 and a human types (555) 123-4567.
  e164 String @unique

  /// What the company should give out. For `forwarded` this is THEIR number,
  /// not ours, and it's the one that goes on the van — printing ours would
  /// undo the whole point of forwarding.
  publicNumber String?

  source VoiceNumberSource @default(purchased)
  status VoiceNumberStatus @default(provisioning)

  /// local or toll_free. NOT cosmetic: a toll-free number costs us more to rent
  /// AND more per inbound minute, because on toll-free the CALLED party pays the
  /// carrier leg. Billing both at the local rate is a quiet loss on every
  /// toll-free customer — the kind that only shows up in a margin report months
  /// later. See lib/voice/credits.js.
  numberType String @default("local")

  /// The provider's own id, so a release or reassign doesn't have to guess.
  providerId String?
  provider   String  @default("retell")

  /// What it costs the company per month, in cents. Held here rather than read
  /// from a price list at render time: a number bought at last year's rate keeps
  /// last year's rate until someone changes it deliberately.
  monthlyCents Int @default(0)

  /// Rent is paid up to this instant, and not one second further.
  ///
  /// The rental is a REAL, recurring charge to FieldQuo the moment the number
  /// exists at the provider, whether or not the contractor ever pays. So it is
  /// debited from the prepaid balance a month at a time, in advance — the first
  /// month before the number is bought at all. This column is what makes that
  /// idempotent: the rent cron only charges numbers whose paid-through has
  /// passed, and advances it by exactly one period in the same write. A missed
  /// cron day charges once when it next runs, never twice.
  ///
  /// Null means "never charged" — a number that predates rent billing, or a
  /// port that has just gone active. Both are due immediately.
  rentPaidThroughAt DateTime?

  /// Set when a rent debit failed for want of balance. The number KEEPS WORKING
  /// until this passes: a contractor's advertised phone number vanishing without
  /// warning is worse than FieldQuo carrying a week of $4 rental. When it passes
  /// and the balance is still short, the number is released for real.
  /// Cleared the moment rent is paid.
  rentGraceUntilAt DateTime?

  /// When we last told them. Stops a daily cron sending a daily email, while
  /// still proving the warning went out before anything was taken away.
  rentWarnedAt DateTime?

  /// Set while a port is in flight, so the UI can say "moving, est. 3 Aug"
  /// rather than a spinner with no end.
  portRequestedAt DateTime?
  portExpectedAt  DateTime?

  releasedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agentId String?
  agent   VoiceAgent? @relation(fields: [agentId], references: [id])
  calls   VoiceCall[]

  /// A demo account's "number" — real receptionist, fictional line.
  ///
  /// Set only by lib/voice/demoLine.js, and only for a company whose isDemo is
  /// true. The E.164 itself is the proof: it always falls in NANP's reserved
  /// fictional block (NPA-555-0100 through NPA-555-0199 — see
  /// lib/voice/retell.js's `isSimulatedNumber`), so a prospect who writes it
  /// down and dials it later reaches nobody, not a stranger's real phone. No
  /// purchase is ever made at Retell for a row with this set, and this is the
  /// flag that says so to the two things that would otherwise assume one was:
  ///
  ///   * the rent cron (lib/voice/spendGate.js `rentDecision`) skips it for a
  ///     stated reason, exactly as it already skips a company FieldQuo has
  ///     withdrawn the feature from — never by accident of `monthlyCents`
  ///     happening to be zero, which would give a true answer for the wrong
  ///     reason and stop meaning anything the day someone reuses that column.
  ///   * /platform/voice-numbers, which reconciles this table against what
  ///     Retell's account actually holds, excludes these rows — they were never
  ///     bought, so counting one as "held here, absent at the provider" would
  ///     report a real-looking billing leak that isn't one.
  simulated Boolean @default(false)

  @@index([companyId, status])
}

enum VoiceNumberSource {
  purchased
  forwarded
  ported
}

enum VoiceNumberStatus {
  provisioning
  active
  porting
  failed
  released
}

/// The receptionist's persona and rules for one company.
model VoiceAgent {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  providerAgentId String?

  /// Fingerprint of the INSTRUCTIONS we last pushed to the provider — the
  /// prompt, the greeting and the tool definitions, hashed together.
  ///
  /// ── Why this exists ─────────────────────────────────────────────────────
  ///
  /// An agent is only ever re-provisioned when somebody saves Settings > Voice.
  /// That was fine while the prompt only changed because THEY changed it, and
  /// wrong the moment we started improving the prompt in code: a fix shipped on
  /// Friday reached exactly the companies who happened to open their voice
  /// settings afterwards, which is none of them. Every contractor's receptionist
  /// was running whatever we wrote on the day they last pressed Save.
  ///
  /// Deliberately covers the instructions ONLY. The agent payload carries a call
  /// ceiling that moves with the credit balance and a webhook URL that moves
  /// with the deployment origin; hashing those would report drift on every run
  /// for ever and re-push for nothing.
  ///
  /// Null means "pushed before this column existed" — the resync treats that as
  /// drift once, writes a hash, and is quiet afterwards.
  provisionedHash String?
  /// A SECOND agent, for calls WE place. Separate from the inbound receptionist
  /// because its whole prompt differs (discloses up front, honours "stop
  /// calling", never negotiates). One per company, reused across all outbound
  /// purposes via per-call dynamic variables. See lib/voice/outboundPrompt.js.
  outboundProviderAgentId String?
  /// Retell splits an agent in two: the AGENT (voice, language, webhook) and the
  /// RESPONSE ENGINE — a "Retell LLM" object that owns the prompt, the opening
  /// line and the tools. `/create-agent` takes a `response_engine.llm_id`, not a
  /// prompt. We must keep both ids or every re-provision would orphan the old
  /// LLM and create a new one. See lib/voice/provision.js.
  providerLlmId         String?
  outboundProviderLlmId String?
  provider        String  @default("retell")

  name     String  @default("Receptionist")
  voice    String?
  language String  @default("en")

  /// What it says when it picks up. Company-authored, because this is the first
  /// thing a stranger hears from the business.
  greeting String?

  /// Extra instructions the owner types. Layered UNDER the system rules in
  /// lib/voice/prompt.js — a company can shape the tone, not remove the
  /// guardrails.
  instructions String?

  /// A human to hand off to. Null means the agent takes a message instead of
  /// promising a transfer that can't happen.
  transferTo String?

  /// Off by default. An agent that answers before anyone has heard it is how a
  /// contractor finds out from a client.
  enabled Boolean @default(false)

  /// ── How it SOUNDS. Four codes, never provider values ────────────────────
  ///
  /// Deliberately our own vocabulary rather than Retell's numbers. Storing
  /// `interruption_sensitivity: 0.7` would tie every existing row to one
  /// provider's scale, so swapping to Vapi later would mean a data migration
  /// rather than a change to one file — the same reason lib/voice/retell.js is
  /// the only place that talks to Retell at all.
  ///
  /// The defaults are stated HERE as well as in lib/voice/agentTuning.js, so a
  /// row created by any path lands on the same four values a company that never
  /// opened the screen behaves as. `normaliseTuning` is still the gate: an
  /// unrecognised string in one of these columns resolves back to the default
  /// rather than reaching the provider.
  ///
  /// May a caller talk over it: easy | balanced | patient
  tuneInterruptions String @default("balanced")
  /// Where callers ring from, which decides denoising: quiet | normal | crowded
  tuneBackground    String @default("normal")
  /// How fast it comes back once they stop: quick | unhurried
  tunePace          String @default("quick")
  /// Brisk, or warm and chatty: professional | warm
  tuneManner        String @default("professional")

  /// Attribution for anything the agent creates. A synthetic member, so the
  /// activity log says the receptionist did it rather than naming a person who
  /// wasn't there.
  memberId String?

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  numbers   VoicePhoneNumber[]
  calls     VoiceCall[]
}

/// One call, and what came of it.
model VoiceCall {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  providerCallId String  @unique
  numberId       String?
  number         VoicePhoneNumber? @relation(fields: [numberId], references: [id])
  agentId        String?
  agent          VoiceAgent?       @relation(fields: [agentId], references: [id])

  direction String @default("inbound")
  fromE164  String?
  toE164    String?

  startedAt DateTime?
  endedAt   DateTime?
  /// Seconds. Billed minutes are derived from this and stored on the usage row,
  /// so a rounding-rule change can't silently rewrite what was charged.
  durationSec Int @default(0)

  transcript   Json?
  summary      String?
  recordingUrl String?

  /// What RETELL charged FieldQuo for this call, in cents — `call_cost.
  /// combined_cost`, documented as "Combined cost of all individual costs in
  /// cents" (https://docs.retellai.com/api-references/get-call).
  ///
  /// Nullable and left null on purpose when the provider didn't give us one.
  /// Absence is recorded as unknown, never padded with
  /// RETELL_COST_CENTS_PER_MINUTE — that constant is a hand-typed estimate and
  /// writing it here would make a guess indistinguishable from a reading. See
  /// lib/voice/providerCost.js.
  ///
  /// Four decimal places because Retell prices in cents PER SECOND and the
  /// combined figure is usually fractional. Distinct from the VoiceCreditEntry
  /// that charges the CONTRACTOR: this is our cost, that is our revenue, and
  /// the spread between them is the only measured margin the platform has.
  providerCostCents Decimal? @db.Decimal(12, 4)

  /// Why it ended, from the provider — answered, no-answer, hung up, error.
  disposition String?

  /// What the agent produced. Nullable because most calls produce nothing, and
  /// a wrong number is a perfectly normal outcome.
  leadId    String?
  clientId  String?
  bookingId String?

  /// Needs a human to look at it — the agent flagged something, or it failed.
  needsReview Boolean @default(false)
  reviewedAt  DateTime?

  /// Dealt with, and off the working list.
  ///
  /// A DIFFERENT axis from needsReview, which flags a PROBLEM — an emergency,
  /// a failed call. This one answers "is there anything left to do with this?",
  /// which is the question the receptionist screen is actually a queue for: a
  /// perfectly ordinary call that should have become a quote and hasn't is not
  /// flagged, not urgent, and the easiest thing in the product to forget.
  ///
  /// Set by hand from that screen. A call whose quote already exists is archived
  /// WITHOUT this being set — that is derived from Quote.sourceCallId, because
  /// storing it here would be a second copy of a fact the quote already carries,
  /// and the copy is the one that goes stale when the quote is deleted.
  archivedAt   DateTime?
  archivedById String?

  /// When this call was RECOVERED rather than delivered.
  ///
  /// Retell's signature check rejected every delivery for months, so calls that
  /// really happened left no row at all. lib/voice/reconcileCalls.js pulls them
  /// back from the provider afterwards — and a contractor who opens
  /// /app/receptionist and finds a two-day-old call sitting there is owed the
  /// reason. Null is the ordinary case: the webhook arrived and this row was
  /// written while the caller was still on the line.
  ///
  /// Set ONLY when the reconciler created the row. A row the webhook wrote and
  /// the reconciler merely topped up was never lost, and labelling it recovered
  /// would make the badge meaningless on the calls that really were.
  recoveredAt DateTime?

  /// The lead on this call was reconstructed from the transcript, not taken by
  /// the agent mid-call.
  ///
  /// `save_caller` posts to the tools endpoint, which had the identical broken
  /// signature check — so a recovered call has a transcript full of details and
  /// no LeadRequest. lib/ai/callLeadRecovery.js reads them back under the same
  /// evidence rules as lib/ai/callQuoteDraft.js. Separate from `recoveredAt`
  /// because the two can differ: a recovered call may yield no lead at all, and
  /// that is a correct outcome rather than a failure.
  leadRecoveredAt DateTime?

  /// The internal AI's reading of this call as QUOTE SCOPE — never a quote, and
  /// never a price. See lib/ai/callQuoteDraft.js.
  ///
  /// The phone agent itself is forbidden from ever saying a number
  /// (lib/voice/prompt.js, absolute rule 1) and that stays true: this is
  /// produced afterwards, in the back office, on a button a person pressed, and
  /// it lands as a PREFILL for the quote builder rather than as a Quote row.
  /// Nothing here reaches a client until a human has priced it and saved.
  ///
  /// Shape: { generatedAt, model, groups: [{ categoryId, categoryKey,
  /// intakeValues, missing, evidence }], unmatched, clientId }. Every value
  /// carries the transcript line it came from — a scope group nobody can trace
  /// back to what the caller actually said is one the contractor cannot check.
  /// Null is the normal case: most calls are wrong numbers.
  quoteDraft   Json?

  /// Why no quote was drafted from this call automatically.
  ///
  /// Null means a draft exists, or nothing has run yet. Anything else is a
  /// REASON, and it is stored rather than inferred because the most likely one
  /// is fixable and invisible: nothing in the caller's words matched anything in
  /// the company's service list. A contractor who has not added "water heaters"
  /// sees no draft and concludes the AI is useless, when the truth is that the
  /// call mentioned work the system has never been told they do.
  ///
  /// Written by lib/voice/autoDraft.js and read on the receptionist screen, so
  /// a skip says what it was rather than looking like nothing happened.
  quoteDraftSkipped String?
  quoteDraftAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, needsReview])
}

/// Voice minutes bought and spent. Prepaid, deliberately — see lib/voice/credits.js.
model VoiceCreditEntry {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Positive for a top-up, negative for a call. One table for both so the
  /// balance is a SUM that can be audited, rather than a counter that can drift
  /// away from the calls that moved it.
  cents Int

  /// "topup" | "call" | "trial" | "adjustment" | "number_setup" | "number_rent"
  /// | "crew_text"
  ///
  /// `crew_text` covers both directions of the crew inbox — an inbound photo
  /// or note and the reply that goes back. One ledger with voice on purpose:
  /// the contractor buys credit once, and "where did my credit go" has to have
  /// a single answer covering everything that spent it. The direction and the
  /// rate live in `note`, and `ref` ("crew_in:<msgId>" / "crew_out:<sid>")
  /// makes each one land exactly once.
  /// Which WALLET this row belongs to. "voice" or "ai".
  ///
  /// ── Why two balances and not one ─────────────────────────────────────────
  ///
  /// One balance was the original design and it was wrong. Retell and OpenAI do
  /// not charge alike, and the difference is not a detail:
  ///
  ///   voice  per MINUTE of talk time, PLUS a rental that arrives every month
  ///          whether the phone rings or not. A number costs $4 in a month with
  ///          no calls. The bill has a floor you cannot get under while you hold
  ///          the line, and crew texting is the same shape — a carrier fee per
  ///          message on a line that also rents monthly.
  ///   ai     per TOKEN, and for pictures per image-token, which moves with
  ///          resolution and quality. Nothing recurs. A company that generates
  ///          nothing in March owes nothing for March.
  ///
  /// Mixing them puts a recurring floor underneath a usage-only product. A
  /// contractor who tops up to make adverts would watch that credit drain into
  /// a phone rental for a receptionist they never asked for, and the statement
  /// would be right while the product was wrong.
  ///
  /// And the two are wanted by different people. Somebody who wants AI adverts
  /// and photo review very often does not want a robot answering their phone.
  /// Making them buy one wallet to get the other is selling the wrong thing.
  ///
  /// Never set by a caller. lib/voice/credits.js derives it from `kind`, so a
  /// new spender cannot put a row in the wrong wallet by forgetting an argument
  /// — the failure mode that would silently drain the phone line to pay for a
  /// picture.
  pool   String @default("voice")

  kind   String
  callId String?
  /// The Stripe Checkout session or payment intent behind a top-up, so a
  /// disputed charge can be traced to the credit it bought.
  stripeRef String?

  /// Idempotency key for anything that must happen EXACTLY once, enforced by
  /// the database rather than by a read-then-write that two concurrent callers
  /// can both pass.
  ///
  /// Three things depend on it, and each is a real bug it prevents:
  ///   "voice_trial"                    — the free-minutes gift, once per
  ///                                      company FOREVER. Guarding it on "no
  ///                                      active number" instead would let a
  ///                                      company release and re-buy for
  ///                                      another 30 minutes, every time.
  ///   "number_rent:<numberId>:<date>"  — one month's rent, once per period,
  ///                                      so a cron that runs twice in a day
  ///                                      charges once.
  ///   "number_setup:<token>"           — the up-front month, paired with a
  ///                                      "refund:<token>" if the purchase then
  ///                                      fails at the provider.
  ///   "voice_topup:<paymentIntentId>"  — one paid top-up, once, however many
  ///                                      of the two settlement paths reach it.
  ///                                      The success-URL redirect and the
  ///                                      checkout.session.completed webhook
  ///                                      both credit, in either order.
  ///
  /// Nullable, and null is unconstrained in Postgres, so the call rows that key
  /// on callId — and the top-up rows written before this ref existed, which key
  /// on stripeRef alone — are unaffected.
  ref String?

  note      String?

  createdAt DateTime @default(now())

  @@unique([companyId, ref])
  @@index([companyId, createdAt])
  @@index([companyId, pool])
}

/// Buy more credit automatically when the balance runs low.
///
/// ── Why this is opt-in, and why every column below is nullable ─────────────
///
/// lib/voice/credits.js makes one promise above all others: nobody is ever
/// surprised by an invoice. Charging a saved card without the contractor
/// standing there is the one feature that can break it, so the whole model is
/// built to be inert until somebody deliberately turns it on. `enabled` is
/// false by default and `thresholdCents`/`amountCents` are NULL until chosen —
/// absence of a choice is not a $10 default, it is "do not charge this card".
/// isArmed() in lib/voice/autoTopup.js is the single reader of that rule.
///
/// ── Platform Billing, NOT Connect ──────────────────────────────────────────
///
/// This is FieldQuo charging the contractor for FieldQuo's own service, so the
/// Customer is the one lib/platform/stripeBilling.js already keeps for their
/// subscription — the same customer app/api/settings/voice/topup/route.js puts
/// on the manual Checkout. There is no `transfer_data`, no connected account
/// and no application fee anywhere near it. Mixing that in would route a
/// contractor's own payment to their own Stripe account, which is the trap
/// lib/stripe.js warns about at the top.
///
/// ── Cards only ─────────────────────────────────────────────────────────────
///
/// ServicePlanAuthorisation also allows Canadian pre-authorized debit, and this
/// deliberately does not. A PAD debit settles in about five business days; a
/// top-up that lands next week is not a top-up, it is a phone that stopped
/// answering on Tuesday and came back on Monday. The point of this feature is
/// that the balance never reaches zero.
model VoiceAutoTopup {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The contractor's switch. False after WE switch it off too — see
  /// disabledReason, which says which of the two happened.
  enabled Boolean @default(false)

  /// Buy more when the balance falls below this, in cents. One of
  /// AUTO_TOPUP_THRESHOLDS ($5 / $10 / $20).
  ///
  /// Null means never chosen. Nothing fills it in: a null threshold is not
  /// "use the default", it is a company that has not agreed to anything.
  thresholdCents Int?

  /// How much to buy each time, in cents. One of TOPUP_OPTIONS.
  amountCents Int?

  /// ── The instrument, saved off-session ────────────────────────────────────
  ///
  /// Collected by a Stripe Checkout session in `mode: "setup"` with
  /// `usage: "off_session"`, exactly as lib/servicePlans/stripeMandate.js does
  /// it. Null until that session completes, and isArmed() refuses to charge
  /// until every one of them is filled in.
  stripeCustomerId      String?
  stripeSetupIntentId   String?
  stripePaymentMethodId String?
  /// A multi-use Mandate, when the method produces one. Cards usually don't,
  /// and null is correct there rather than missing.
  stripeMandateId       String?
  /// Always "card" today. Stored anyway so the PaymentIntent can pin
  /// payment_method_types to the method actually authorised, rather than
  /// letting an off-session confirm wander onto something the consent below
  /// does not cover.
  paymentMethodType  String?
  paymentMethodBrand String?
  paymentMethodLast4 String?

  /// ── The consent record ───────────────────────────────────────────────────
  ///
  /// Same discipline as ServicePlanAuthorisation, one level up: FieldQuo is the
  /// merchant here and the contractor is the customer. Stripe's guidance for
  /// charging a saved method off-session requires the merchant to state AND
  /// KEEP A RECORD OF the agreement, the timing, how the amount is decided and
  /// how to cancel. Stripe's hosted page states none of those four.
  ///
  /// So the exact wording shown is snapshotted verbatim into termsText, and
  /// improving the copy later cannot rewrite what somebody already agreed to.
  /// Stamped when the box was ticked, BEFORE Stripe was opened — a company that
  /// ticked and then abandoned the card form leaves "agreed, never finished",
  /// which is the truth and which isArmed() correctly refuses to charge.
  acceptedAt         DateTime?
  acceptedIp         String?
  acceptedAgent      String?
  /// Which member ticked it. "The company agreed" is not an answer anyone can
  /// act on months later.
  acceptedByMemberId String?
  acceptedByName     String?
  termsText          String?
  termsLanguage      String?

  /// The ceiling the terms actually stated, frozen at consent, in cents.
  ///
  /// Read back and enforced on every charge. amountCents alone would not do:
  /// it is editable, and a settings write that raised it without re-stating the
  /// terms would charge more than anybody agreed to. Changing the amount means
  /// re-accepting, which re-stamps this.
  authorisedAmountCents Int?
  /// And the most that can be taken in one day, also stated in the terms.
  authorisedDailyCents  Int?

  /// ── The runaway guards ───────────────────────────────────────────────────
  ///
  /// A bug that charges a card in a loop is the worst outcome this feature has
  /// available, so the caps are columns rather than in-process state — a second
  /// serverless invocation shares no memory with the first, and Vercel runs
  /// several.
  ///
  /// Claimed by a conditional updateMany before Stripe is called and cleared
  /// after, so at most one automatic charge is ever in flight. The token is
  /// what the Stripe idempotency key is built from: a retry that finds the same
  /// claim reuses the same key and Stripe returns the SAME PaymentIntent
  /// instead of taking a second payment.
  chargeInFlightAt    DateTime?
  chargeAttemptToken  String?

  /// UTC day the counter below belongs to, as YYYY-MM-DD. A day key rather than
  /// a rolling window because the cap has to be explicable to the person paying
  /// — "at most three a day" is a sentence; "at most three per rolling 24h" is
  /// a support ticket.
  dayKey       String?
  chargesToday Int      @default(0)
  spentTodayCents Int   @default(0)
  lastChargeAt DateTime?

  /// Consecutive transient failures. A DECLINE does not count here — it
  /// switches the feature off on the spot (see lib/voice/autoTopup.js), because
  /// retrying a declined card is how an account ends up in a bank's fraud
  /// rules. This counter is only for "we could not reach Stripe at all", which
  /// is not the contractor's problem and must not disable them on one blip.
  consecutiveFailures Int       @default(0)
  lastFailureAt       DateTime?
  lastFailureCode     String?
  lastFailureMessage  String?

  /// Set when FIELDQUO switched it off, with why. Null when the contractor did
  /// it themselves — the two read identically in `enabled` and must not read
  /// identically on screen.
  disabledAt     DateTime?
  disabledReason String?
  /// When we last emailed them about it, so a cron cannot send a daily copy of
  /// the same bad news.
  notifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A monthly AI credit allowance — Stripe BILLING (same customer as
/// VoiceAutoTopup and the company's own plan), `mode: "subscription"`, one row
/// per company.
///
/// ── Why a second wallet needs a second purchase mechanism at all ───────────
///
/// lib/ai/imageEconomics.js prices two ways to buy the SAME "ai" wallet:
/// pay-as-you-go at ~50% margin (a one-off VoiceCreditEntry, kind "ai_topup",
/// see lib/ai/topup.js) and a bundle at ~30% margin because the company has
/// committed to buying every month. A committed buyer paying less per credit
/// is the only honest reason to ask anyone to commit — so the bundle needs its
/// OWN recurring charge, and this row is what remembers which one a company
/// picked and where Stripe is with it.
///
/// ── Rollover, not expiry — and this is a decision, not a default ───────────
///
/// Unused bundle credit ROLLS OVER. It is not clawed back at the end of a
/// period, and it is not clawed back on cancellation either — see
/// cancelAiBundle in lib/ai/creditBundle.js. Two reasons, and neither is
/// laziness:
///
///   1. The ledger is a SUM (lib/voice/credits.js's own header). There is no
///      column that says "these 4,000 credits were part of March's grant" —
///      a generation debits the wallet, not a specific month's row. Expiring
///      "the unused part of March" would mean either a second, per-lot ledger
///      (a real schema change, not a policy flip) or writing a debit for
///      money the company already paid for and never spent — which is not an
///      expiry, it is FieldQuo taking money back, dressed as one.
///   2. It matches every other balance in this product. Phone credit doesn't
///      expire. A pay-as-you-go AI top-up doesn't expire. A bundle that did
///      would be the one balance in FieldQuo that punishes a quiet month, on
///      the one feature (advertising) contractors already use in bursts —
///      busy before a season, quiet after.
///
/// The UI has to say this in plain words before anyone pays — silence here
/// is the failure AGENTS.md calls out by name — see BUNDLE_ROLLOVER_NOTICE in
/// lib/ai/creditBundle.js, which the settings page and the bundle route both
/// read from the one place rather than each writing their own sentence.
///
/// ── Cancelling stops FUTURE grants, and nothing else ────────────────────────
///
/// cancelAiBundle() cancels the Stripe subscription itself, immediately.
/// That is the entire enforcement: no subscription, no more invoices, no more
/// invoice.payment_succeeded events, no more grants — lib/ai/creditBundle.js
/// does not gate the grant on this row's own `status` column, because this
/// row is a cache of what Stripe already decided, not a second switch that
/// could disagree with it. Already-granted credit is an ordinary balance of
/// ai_bundle-kind rows in VoiceCreditEntry and is never touched.
model AiCreditBundle {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// BUNDLES[].key from lib/ai/imageEconomics.js — "starter" | "busy" |
  /// "agency". The price and credit count are NOT stored here: they live in
  /// that one priced list, so a margin correction there is a margin
  /// correction everywhere, including for a company already subscribed.
  key String

  /// The same platform Billing customer as the company's own subscription and
  /// VoiceAutoTopup — see lib/stripe.js's warning never to mix a Connect
  /// account into a Billing call.
  stripeCustomerId     String
  stripeSubscriptionId String @unique

  /// Stripe's own subscription status, kept for display only — see the model
  /// header for why the grant does not read this column to decide anything.
  status String @default("active")

  /// Mirrors subscription.cancel_at_period_end. Not used to gate a grant
  /// either; shown on screen so "you cancelled" and "we're still charging
  /// you" cannot both be true on the page at once.
  cancelAtPeriodEnd Boolean @default(false)

  /// Stripe's current_period_end, for "renews on" / "credit stops after".
  currentPeriodEnd DateTime?

  /// The most recent period this subscription was actually granted credit
  /// for — display only. The real idempotency guard is the ledger's own
  /// unique (companyId, ref), keyed by lib/ai/creditBundle.js's aiBundleRef(),
  /// the same pattern rentRef() uses for number rental.
  lastGrantedPeriodStart DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

/// Permission to ring a specific number, and where it came from.
///
/// ── Why this is a table and not a boolean ──────────────────────────────────
///
/// "May we call this number" has to be answerable months later, in front of a
/// regulator, with a date and a reason. TCPA is up to $1,500 PER CALL and CASL
/// up to $10M for an organisation, and the defence is always the same: show
/// that the person asked to be contacted, and when.
///
/// So consent is a ROW with a source and a timestamp, not a flag somebody could
/// have set. If there is no row, the agent does not dial. That makes cold
/// calling structurally impossible rather than merely against the rules — a
/// contractor who pastes in a purchased list gets nothing, which is the point.
model CallConsent {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// E.164, normalised. The lookup key, so a number typed one way and dialled
  /// another can't slip past the check.
  e164 String

  /// How they asked. Each of these is a real, evidenced request to be
  /// contacted — not an inference:
  ///   self_quote     submitted a quote request that said we'd call
  ///   booking        booked a visit
  ///   quote_approved a quote they asked for was approved
  ///   job_completed  we did work for them
  ///   manual         staff recorded a verbal request — needs `note`
  source String

  /// The exact wording they were shown when they gave it. Stored, not
  /// referenced, because the form copy WILL change and the defence has to be
  /// what this person actually saw.
  disclosure String?

  /// What it relates to, so consent can be traced to the thing that created it.
  leadId    String?
  clientId  String?
  quoteId   String?
  jobId     String?
  note      String?

  /// Set the moment they ask to stop. Checked BEFORE any consent row — an
  /// opt-out always wins, whatever else is on file, and it is never deleted.
  optedOutAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId, e164])
  @@index([e164, optedOutAt])
}

/// One queued outbound call, waiting for a good time to be placed.
///
/// A queue rather than a call placed on the spot, because the trigger and the
/// call must not be the same moment: a quote approved at 9pm must not ring the
/// customer at 9pm. The cron drains this within calling hours, re-checking
/// consent and credit at dial time — not at enqueue time, because a number can
/// opt out in the hours between.
///
/// Everything the call is ABOUT is a foreign key, never a copied name or
/// number: the dialled number is read from the linked lead/client at send
/// time, so an opt-out or a corrected number takes effect even for a call
/// already in the queue.
model VoiceCallTask {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Why we're calling — drives the script. See lib/voice/outboundPrompt.js.
  purpose String

  /// queued → calling → done | failed | skipped | cancelled
  status String @default("queued")

  /// What it's about. The number to dial is derived from these, not stored.
  leadId    String?
  clientId  String?
  quoteId   String?
  jobId     String?
  bookingId String?

  /// Script variables the purpose needs (customer first name, quote total as a
  /// fact the agent may STATE because a human already set it, appointment time).
  /// Never a price the agent computes — only figures a human already committed to.
  context Json?

  /// The earliest this may be dialled. Set to the next morning when a trigger
  /// fires after hours, so the queue itself carries the "not yet".
  notBefore DateTime @default(now())

  /// Dial attempts. A no-answer is retried a few times across days, then given
  /// up on — a fourth voicemail is a nuisance, not a follow-up.
  attempts   Int       @default(0)
  lastError  String?
  lastTriedAt DateTime?

  /// The call it produced, once placed. Links to the VoiceCall row the webhook
  /// fills in.
  providerCallId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([status, notBefore])
}

/// The number a company's crew texts.
///
/// ── Deliberately NOT VoicePhoneNumber ──────────────────────────────────────
///
/// VoicePhoneNumber is bought from Retell and answers CALLS. It cannot receive
/// texts: the number lives in Retell's telephony account, FieldQuo's Twilio
/// account has never heard of it, and Retell's own inbound webhook carries no
/// message body and no MMS media. Conflating the two is what shipped a crew
/// inbox whose switch saved a column and whose webhook nothing could ever
/// reach. They are two different lines from two different providers, so they
/// are two different tables — and on a `forwarded` setup the voice number the
/// company advertises isn't even ours, because carrier forwarding forwards
/// calls and never texts.
///
/// ── Both uniques are load-bearing ──────────────────────────────────────────
///
/// `companyId` unique: one crew line per company, so "which number do my crew
/// text?" has exactly one answer to print.
///
/// `e164` unique: one company per number, enforced by the database rather than
/// by a check someone remembers to write. That is what makes the shared
/// platform test line safe to hand out — while a company holds it, the inbound
/// webhook resolving `To` → this row can only ever land on that one tenant. A
/// second company claiming it is a constraint violation, not a race.
model CrewInboxNumber {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// E.164, normalised — the webhook's `To` is matched against this and nothing
  /// else. See app/api/crew/inbound/route.js on why the sender is never a key.
  e164 String @unique

  /// Only "twilio" resolves today; see lib/crew/capability.js. Stored rather
  /// than assumed so the day a second provider can deliver a body and media,
  /// the rows already say which is which.
  provider String @default("twilio")

  /// shared_test — FieldQuo's own platform number, on loan to one company at a
  ///               time so a contractor can prove the feature works before
  ///               anybody buys anything.
  /// dedicated   — a number bought for this company alone.
  source String @default("shared_test")

  /// Twilio's IncomingPhoneNumber SID. Needed to set the messaging webhook, and
  /// stored so re-pointing it doesn't have to search the account by number.
  providerId String?

  /// The URL we actually pointed the number's SMS webhook at, and when.
  ///
  /// Stored so the setup screen can detect DRIFT rather than assume: a preview
  /// deployment claiming the shared line repoints it, and the production tenant
  /// who claimed it yesterday would otherwise show a green tick while their
  /// crew's texts went to a branch build. Null `connectedAt` means the number
  /// exists but nothing has been wired — the honest "not finished" state.
  webhookUrl  String?
  connectedAt DateTime?

  /// When a shared-line loan lapses. Null for a dedicated number, which doesn't
  /// expire. A lapsed loan stops resolving and frees the number for the next
  /// company — otherwise the first contractor to press the button owns the only
  /// test line forever.
  expiresAt DateTime?

  /// ── Monthly rental, for `dedicated` lines only ──────────────────────────
  ///
  /// Same three columns, same meanings and the same pure rule as
  /// VoicePhoneNumber — lib/voice/spendGate.js `rentDecision` decides for both,
  /// via a shim in lib/crew/lineRent.js. Duplicating the grace-and-warning
  /// logic for a second kind of number is how the two would come to disagree
  /// about what a delinquent company is owed.
  ///
  /// A `shared_test` loan has no rental: it is FieldQuo's own number, and the
  /// loan expires instead (see expiresAt). These stay null on those rows, and
  /// the rent cron skips them by source.
  ///
  /// Rent is paid up to this instant and not one second further. Null on a
  /// dedicated line means "never charged", which reads as due immediately.
  rentPaidThroughAt DateTime?

  /// Set when a rent debit failed for want of balance. The line KEEPS WORKING
  /// until this passes — a crew's texts stopping without warning is worse than
  /// FieldQuo carrying a week of rental. Cleared the moment rent is paid.
  rentGraceUntilAt DateTime?

  /// Last time we told them the rental was short, so a reminder can't become a
  /// daily email.
  rentWarnedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One message a crew member texted in — a photo, an update, a voice note.
///
/// Doubles as the record of what was filed AND the "which job?" question when
/// one is open (status = pending, candidateJobIds set). One row, both jobs:
/// there's no separate pending-question table to drift out of sync with the
/// message it's about. See lib/crew/inboxLogic.js for the state machine.
model CrewInboundMessage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The crew member, resolved from their phone. Null when the number isn't on
  /// the roster — the message is still logged (so nothing vanishes) but nothing
  /// is filed, because we don't know whose schedule to look at.
  senderUserId String?
  senderPhone  String

  body      String?
  /// Re-hosted to Cloudinary, not raw Twilio URLs — those need auth to fetch
  /// and expire, and JobVisit.photos are shown to staff expecting durable links.
  mediaUrls String[] @default([])
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// pending → filed | ignored | superseded
  ///
  /// `superseded` is a question the crew answered with a new photo instead of an
  /// answer. It stops the SMS side treating it as the open question — a stale
  /// "which job?" that a later unrelated "2" could resolve is a silent wrong
  /// file — while still showing in the office inbox, because the held photo is
  /// real and a person can still say where it goes. It is NOT a tombstone;
  /// fileHeldMessage accepts it for exactly that reason.
  status String @default("pending")
  /// How it was attributed once filed: explicit | gps | only-one | answered |
  /// manual. `manual` is a person picking the job in the office inbox; the
  /// others are the attribution engine's own verdicts (lib/crew/attribution.js).
  method String?

  /// Where it landed. jobVisitId is the specific visit the media was appended
  /// to — read back when re-filing and asserted on, because a null here next to
  /// status "filed" means the media went nowhere while the crew were told it
  /// had. See fileToVisit, which now refuses to report success it didn't have.
  jobId      String?
  jobVisitId String?

  /// When status = pending: the jobs the crew was asked to choose between.
  candidateJobIds String[] @default([])

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([companyId, status])
  @@index([companyId, senderPhone, status])
}

/// One photo of a job, with the stage it belongs to and whether it's been
/// promoted to the public website gallery.
///
/// This is the richer store behind the crew inbox. A crew photo files to a job
/// (JobVisit.photos keeps the raw feed for the job screen); a JobPhoto row adds
/// the STAGE (start / progress / finish / issue) the crew agent inferred, and a
/// `featured` flag the owner sets to lift the best ones onto their website.
/// Start + finish of the same job is the before/after that sells the work.
model JobPhoto {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobVisitId String?

  /// The to-do this photo was filed to satisfy, if any — set only by
  /// POST /api/tasks/[id]/photos. Most JobPhoto rows have no task: this is
  /// the exception, not the rule. SetNull rather than Cascade: a completed
  /// to-do can be deleted later (DELETE /api/tasks/[id]) without deleting the
  /// evidence the crew actually filed — a photo of finished work outlives the
  /// checklist item that asked for it.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  /// The safety incident this is evidence for, if any — set only by
  /// POST /api/safety-incidents/[id]/photos. SetNull rather than Cascade: a
  /// photo of a hazard is evidence in its own right and must survive even if
  /// the incident record it was filed against were ever removed (it isn't —
  /// see SafetyIncident's own comment — but the relation follows the same
  /// "evidence outlives the record that asked for it" rule JobPhoto.taskId
  /// already states above).
  safetyIncidentId String?
  safetyIncident   SafetyIncident? @relation(fields: [safetyIncidentId], references: [id], onDelete: SetNull)

  url     String
  /// start | progress | finish | issue — see lib/gallery/stages.js.
  stage   String  @default("progress")
  caption String?

  /// Promoted to the public gallery. Off by default: a job photo is private
  /// until the owner deliberately shows it — a homeowner's kitchen is not
  /// marketing until they say so.
  featured   Boolean @default(false)
  /// Manual ordering within an album; lower shows first.
  sortOrder  Int     @default(0)

  /// The markup layer — Fabric's canvas.getObjects(), serialised, and
  /// nothing else. Deliberately NEVER includes the photo itself: `url` above
  /// is the one and only copy of the original pixels, forever. See
  /// docs/PHOTO-ANNOTATION.md for why the objects live here instead of
  /// flattened into `url` — the short version is AGENTS.md's hard rule that
  /// customer data (a contractor's evidence photo) is never destroyed.
  annotationJson      String?
  /// The pixel dimensions annotationJson's object coordinates are relative
  /// to (the working canvas at the moment it was saved) — needed to rescale
  /// the markup correctly if it's ever reopened against a differently-sized
  /// render of the same photo.
  annotationWidth     Int?
  annotationHeight    Int?
  annotationUpdatedAt DateTime?
  /// A SECOND Cloudinary asset: the original photo with annotationJson
  /// baked in, PNG. Fabric cannot run server-side in this repo (no jsdom —
  /// see AGENTS.md's Next.js banner and DesignerLoader.js), so this is
  /// rendered client-side at save time via canvas.toDataURL() and uploaded
  /// through the existing /api/upload — there is no way to flatten on
  /// demand from a server route. `flattenedPublicId` lets a re-save or a
  /// cleared annotation delete the previous flattened asset instead of
  /// accumulating one per edit.
  flattenedUrl        String?
  flattenedPublicId   String?

  createdAt DateTime @default(now())

  comments JobPhotoComment[]
  /// Company-defined labels — "sanding", "priming", "top coat". Purely
  /// descriptive, additive to `stage`, never a substitute for it. See
  /// JobPhotoTag's own comment for why this is a separate table rather than
  /// a widened `stage` column.
  tags JobPhotoTagOnPhoto[]

  @@index([companyId, featured])
  @@index([jobId, stage])
  @@index([taskId])
  @@index([safetyIncidentId])
}

/// An internal note on a job photo — never a client-facing surface. Nothing
/// under /quote, /book, /portal, /site or /embed, no PDF and no email selects
/// this model; the public gallery (lib/site/jobPhotos.js) and the photo report
/// PDF (lib/jobs/photoReport.js) both hand-pick { url, caption, stage,
/// createdAt } and would need a deliberate edit to ever reach this table. The
/// second guard is memberOrRefusal itself: a homeowner has no Member row, so
/// even a route that mistakenly queried this would refuse them before the
/// query ran. See docs/PHOTO-COMMENTS.md.
///
/// Flat, not threaded. A photo's comment thread is short — "who tagged the
/// trim, what's the touch-up colour" — and a reply-to-reply tree buys
/// structure a handful of short-lived company staff comments never need.
model JobPhotoComment {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobPhotoId String
  jobPhoto   JobPhoto @relation(fields: [jobPhotoId], references: [id], onDelete: Cascade)

  /// The Member row, not the User — this is company-scoped identity, the same
  /// thing every permission check in lib/permissions/enforce.js reasons about.
  authorMemberId String
  authorMember   Member @relation(fields: [authorMemberId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())

  mentions JobPhotoMention[]

  @@index([jobPhotoId, createdAt])
  @@index([companyId])
}

/// One @mention inside a comment, and the record of whether — and how — the
/// mentioned person was actually told. This IS the notification store: there
/// is no generic Notification/inbox model anywhere else in this schema (see
/// docs/PHOTO-COMMENTS.md for what was checked before this was added), so
/// "was this person notified" has nowhere else to be durable.
model JobPhotoMention {
  id        String          @id @default(cuid())
  commentId String
  comment   JobPhotoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// sms | email | none — how delivery was attempted, decided once at write
  /// time and never revisited. A member's phone number changing next week
  /// must not rewrite history about how THIS mention was (or wasn't) sent.
  notifiedVia String    @default("none")
  notifiedAt  DateTime?

  /// Populated only when notifiedVia is "none" — self_mention | no_channel |
  /// crew_line_not_set_up | opted_out | insufficient_balance | send_failed.
  /// See lib/photoComments/notify.js, the only writer of these two columns.
  skipReason String?

  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([commentId])
}

/// A company-defined label for job photos — "sanding", "priming", "top coat",
/// "demo" — layered ON TOP of JobPhoto.stage, never a replacement for it.
///
/// ── Why a separate model rather than widening `stage` ──────────────────────
///
/// start/progress/finish/issue are not labels, they're product logic that must
/// not bend to what a contractor types: start+finish drive
/// lib/gallery/albums.js's beforeAfterPairs, and issue is a hard privacy
/// boundary enforced independently in TWO places — the API refuses
/// `featured: true` on one (app/api/jobs/[id]/photos/route.js) and
/// featuredUrls() filters `stage: { not: "issue" }` at read time
/// (lib/site/jobPhotos.js). If a company's free-form vocabulary lived in that
/// same column, a company could create a custom value that reads like
/// "before"/"after"/"issue" to a human but isn't one of the four the pairing
/// and privacy code actually checks for equality — or, worse, one that IS one
/// of those four strings and silently inherits behaviour nobody asked for. A
/// tag stored here can never occupy the `stage` column, so it structurally
/// cannot trip either piece of logic — not because this file remembers to
/// guard it, but because nothing that guards stage ever reads this table. See
/// lib/gallery/tags.js and docs/PHOTO-TAGS.md for the full reasoning and the
/// tests that pin it down.
model JobPhotoTag {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  /// Hex, optional — a chip with no colour just renders neutral.
  color String?
  /// Manual ordering in the picker and the settings list; lower shows first.
  sortOrder Int @default(0)

  /// Retiring, not deleting — the same pattern Worker.active uses for a
  /// person who leaves. A tag already on 200 photos must not vanish from them
  /// just because the company stopped using it going forward: retiring drops
  /// it from the picker offered on NEW photos, and existing JobPhotoTagOnPhoto
  /// rows (and the tag's own name/colour) are untouched.
  active Boolean @default(true)

  createdAt DateTime @default(now())

  photos JobPhotoTagOnPhoto[]

  @@index([companyId, active])
}

/// The join: which tags sit on which photo. A photo can carry several tags; a
/// tag can sit on many photos. A row here surviving its tag being retired, or
/// its photo being featured/unfeatured/re-staged, is the point — this table
/// only ever records "this label is on this photo", nothing about whether
/// either one is currently active or public.
model JobPhotoTagOnPhoto {
  id      String      @id @default(cuid())
  photoId String
  photo   JobPhoto    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tagId   String
  tag     JobPhotoTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([photoId, tagId])
  @@index([tagId])
}

// ============================================================
// SERVICE PLANS — recurring work, sold as a package, billed on a cadence
// ============================================================

/// A block of recurring work a contractor sold to one client: spring + fall
/// gutter cleaning, a quarterly maintenance visit, weekly lawn care.
///
/// ── Why this is not a Stripe Subscription ───────────────────────────────────
///
/// Stripe Billing can bill on an interval, and lib/platform/stripeBilling.js
/// already uses it — for FieldQuo charging its own tenants. Reaching for it
/// here was considered and rejected on four counts, and the reasons are worth
/// keeping because the shortcut is tempting:
///
///   1. White-label. A Stripe Subscription bills through Stripe's own invoice
///      and receipt, on the PLATFORM account. The homeowner would receive a
///      document from FieldQuo. The whole product promise is that they don't.
///   2. "Twice a year, starting in April" is not a Stripe interval. Seasonal
///      work is the case the owner actually asked for.
///   3. A package discount ("10% off the total") would become a Coupon object
///      to keep in sync with a figure we already hold.
///   4. Two different subscription object graphs on one platform account is
///      exactly the mixing lib/platform/stripeBilling.js warns against.
///
/// So the SCHEDULE lives here and the money moves through the same primitive
/// the existing pay link already uses: a destination charge on the platform,
/// transferred to the connected account (see lib/stripe.js). The only thing
/// added is that the PaymentIntent is confirmed off-session against a payment
/// method the client authorised in advance.
///
/// The consequence is the property that matters most: there is no Stripe object
/// that can charge anybody on its own. Nothing bills unless
/// lib/servicePlans/run.js decides an occurrence is due, and it refuses a plan
/// that is not `active`. Cancelling cannot leave a live subscription behind,
/// because there was never one to leave.
///
/// ── Money terms are frozen at creation ──────────────────────────────────────
///
/// amountPerOccurrence, discountPct, frequency and the length are immutable
/// once the row exists. Not laziness: the client's authorisation names those
/// figures, and Stripe's own rules for off-session charging require the terms
/// they agreed to cover the charge. Editing the amount under a live mandate is
/// the chargeback. To change the deal, cancel and sell a new plan.
model ServicePlan {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])

  /// What the contractor calls this package on the client's invoice.
  name String

  /// The service being sold, FROZEN as text at creation rather than joined.
  ///
  /// Deliberately a copy, for the same reason Invoice.lineItems is a copy of
  /// the quote's: a company renaming a trade next year must not rewrite what a
  /// homeowner agreed to buy. `categoryId` is kept alongside for provenance and
  /// is intentionally NOT a relation — it answers "which service was this
  /// picked from", never "what is it called now".
  serviceName String
  categoryId  String?

  /// active · cancelled · completed. A plain String, matching Job.status'
  /// neighbours in this schema; the closed set is enforced in
  /// lib/servicePlans/schedule.js, which is the only thing that reads it.
  status String @default("active")

  /// weekly · monthly · quarterly · semiannual · annual.
  /// The closed set is PLAN_FREQUENCIES in lib/servicePlans/schedule.js.
  frequency String

  /// The date of the FIRST occurrence. Every later date is computed from this
  /// anchor, never from the previous one — see the schedule module for why
  /// iterating drifts a "31st of the month" plan backwards over a year.
  startDate DateTime

  /// count · until · open — how the series ends.
  ///   count → occurrenceCount is the number of visits sold
  ///   until → endDate is the last day an occurrence may fall on
  ///   open  → runs until somebody cancels it
  endMode         String
  occurrenceCount Int?
  endDate         DateTime?

  /// What one occurrence costs BEFORE the package discount and before tax, in
  /// the company's own currency. Decimal, like every other money column here.
  amountPerOccurrence Decimal @db.Decimal(12, 2)

  /// The package discount, as a percentage off the total — "Spring & Fall,
  /// 10% off". Applied identically to every occurrence rather than deducted
  /// from the term total, which is the only way each invoice can add up on its
  /// own; see lib/servicePlans/pricing.js.
  discountPct Decimal @default(0) @db.Decimal(6, 3)

  /// Tax rate applied to each occurrence's invoice, as a percentage. Null
  /// means the contractor stated there is no tax on this plan — NOT that we
  /// should guess one. An absent rate is a statement, not a gap to fill.
  taxRatePct Decimal? @db.Decimal(6, 3)

  /// invoice · automatic — how each occurrence is collected.
  ///
  /// `invoice` is the default and works on its own with no stored card: each
  /// occurrence raises an invoice and emails the existing pay link.
  ///
  /// `automatic` is a REQUEST, not a capability. It only ever charges when a
  /// ServicePlanAuthorisation row exists and is unrevoked. Without one the run
  /// falls back to the pay link and says so on the plan — it never silently
  /// collects nothing.
  collectionMode String @default("invoice")

  /// The language the plan's client-facing wording was written in, fixed at
  /// creation like Quote.language. Automatic collection is only offered when
  /// this is a language we hold reviewed authorisation wording for — see
  /// AUTHORISATION_LANGUAGES in lib/servicePlans/consent.js.
  language String @default("en")

  /// Unguessable token for the client's authorisation page at /plan/<token>.
  /// Only minted when the contractor asks for a payment method, so a plan that
  /// never needed one has no public surface at all.
  authToken String? @unique

  cancelledAt  DateTime?
  cancelledById String?
  completedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  occurrences   ServicePlanOccurrence[]
  authorisation ServicePlanAuthorisation?

  @@index([companyId, status])
  @@index([clientId])
}

/// One dated instance of a plan: the visit that is due, the invoice it raised,
/// and what happened when we tried to collect for it.
///
/// Rows are created LAZILY, one per run, only once the date has arrived — see
/// lib/servicePlans/run.js. Materialising the whole series up front would mean
/// a plan back-dated by mistake fires a burst of real invoices at real clients
/// the moment it is saved.
model ServicePlanOccurrence {
  id     String      @id @default(cuid())
  planId String
  plan   ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// 0-based position in the series. Unique per plan, which is what makes the
  /// generator idempotent: a cron that runs twice cannot bill twice.
  seq     Int
  dueDate DateTime

  /// pending · invoiced · charging · paid · failed
  ///
  /// `charging` exists because pre-authorized debit is a delayed-notification
  /// method: the PaymentIntent sits in `processing` for days. Collapsing it
  /// into `paid` would mark an invoice settled on money that has not moved.
  status String @default("pending")

  /// The figures as billed, frozen. The plan's columns can't be edited, but
  /// freezing here still matters: it is what the invoice and the charge agree
  /// on, and it is what a dispute is read against.
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  /// The invoice this occurrence raised. SetNull, never Cascade: an invoice is
  /// a financial record and outranks its link to the schedule that produced it.
  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  stripePaymentIntentId String?   @unique
  chargeAttemptedAt     DateTime?
  /// Why the last automatic attempt failed, in Stripe's own words. Shown to the
  /// contractor, never to the client.
  chargeFailureCode     String?
  chargeFailureMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, seq])
  @@index([planId, status])
}

/// The client's standing permission to be charged for one plan, and the
/// evidence that they gave it.
///
/// ── Why a separate row, and why its absence is the point ────────────────────
///
/// Same structural reasoning as InvoiceCosting: a plan is returned to screens
/// and, at /plan/<token>, to a stranger's browser. Stripe customer and payment
/// method ids must not ride along on that payload by accident, and a column on
/// ServicePlan would. More importantly, "is there a mandate" then has exactly
/// one answer — does this row exist and is revokedAt null — instead of a set of
/// nullable columns that can disagree with each other.
///
/// Stripe's own compliance guidance for off-session charging requires the terms
/// the customer agreed to be RECORDED, not merely displayed. termsText is that
/// record: the exact wording rendered on the page they ticked, snapshotted, so
/// improving the wording later cannot rewrite what an existing client agreed to.
model ServicePlanAuthorisation {
  id     String      @id @default(cuid())
  planId String      @unique
  plan   ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// A Stripe Customer on the PLATFORM account, holding the client's payment
  /// method. Deliberately NOT tagged with a `companyId` metadata key — see
  /// lib/servicePlans/stripeMandate.js. getOrCreateStripeCustomer in
  /// lib/platform/stripeBilling.js searches customers by exactly that key, and
  /// a collision would hand a tenant's own subscription a homeowner's card.
  stripeCustomerId      String
  stripeSetupIntentId   String
  stripePaymentMethodId String
  /// Stripe's multi-use Mandate, when the method generates one (pre-authorized
  /// debit always does; cards usually don't). Passed back on every off-session
  /// charge so the debit is made under the mandate the client accepted.
  stripeMandateId       String?

  /// card · acss_debit. Pinned onto the PaymentIntent so an off-session charge
  /// cannot wander onto a method the client never authorised.
  paymentMethodType  String
  paymentMethodBrand String?
  paymentMethodLast4 String?

  /// ── The consent record ──────────────────────────────────────────────────
  /// acceptedAt is stamped when the CLIENT ticked the box on /plan/<token>,
  /// before Stripe is ever opened — so a client who abandoned the card form
  /// leaves an accepted-terms row with no payment method, which reads
  /// correctly as "agreed, never finished" rather than as authority to charge.
  acceptedAt   DateTime
  acceptedIp   String?
  acceptedAgent String?
  /// The full terms as rendered, verbatim, plus the language they were in.
  termsText    String
  termsLanguage String

  /// Set when the plan is cancelled or the contractor removes the method. A
  /// revoked row is never charged, and the payment method is detached at Stripe
  /// as well — two independent stops, deliberately.
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
//  Sales portal
// ═══════════════════════════════════════════════════════════════════════════
//
// FieldQuo's own reps, the companies they brought in, and what they are owed.
// None of this belongs to a tenant, and a contractor can never see any of it.
//
// ── Why a SalesRep is not a Member, and not a PlatformAdmin ────────────────
//
// Not a Member: the whole tenant stack resolves one session to one company via
// session.activeOrganizationId, and Member is @@unique([userId, companyId]). A
// rep is the opposite shape — one identity across MANY companies, read-mostly.
// Making a rep a Member of each attributed company would spend that customer's
// licensed seats and put FieldQuo staff inside a contractor's tenant, which is
// the thing non-negotiable #2 exists to prevent.
//
// Not a PlatformAdmin either, though that is the closer analogue. A platform
// token is checked by a long tail of /api/platform/* routes, some of which
// only ask "is there an admin?"; issuing reps the same credential would grant
// them whatever the least careful of those routes grants. So this is a third
// identity with its own table and its own cookie scope, exactly as
// PlatformAdmin is a third one beside User — same reasoning, one level along.

model SalesRep {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  /// Null until the invite is accepted. A rep exists — and can be attributed
  /// to — from the moment they are added, the same way a PendingTeamProfile
  /// holds a seat before anyone clicks a link.
  passwordHash String?

  /// The mailbox this rep SENDS from. Deliberately separate from `email`,
  /// which is how they sign in and where their invite went.
  ///
  /// Two reasons, and the second is the one that would have bitten. A mailbox
  /// is BOUGHT — the owner adds a rep before the inbox exists, so there is a
  /// real window where a rep has a login and no address to send from. And a
  /// login address may be personal or pre-existing; sending cold outreach from
  /// it would put a stranger's reply somewhere the portal cannot see, and
  /// possibly somewhere the rep does not want it.
  ///
  /// **There is deliberately no fallback to `email`.** A missing work mailbox
  /// must block sending and say so, because the alternative — quietly sending
  /// from the login address — is a send that reads as successful while the
  /// reply goes somewhere nobody is watching. That is the same reasoning
  /// lib/sales/outreachSender.js gives for refusing to fall back to the
  /// platform sender.
  workEmail String? @unique

  /// The slug in their link: /signup?sales=<code>. Its own namespace, because
  /// ?ref= and the referralCode POST field are already claimed by the promo and
  /// referral waterfall in app/api/companies/route.js.
  code String @unique

  active     Boolean   @default(true)
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?
  startedAt  DateTime?
  /// Set when they leave. Deliberately not a delete: their attributions and
  /// their ledger are history, and history does not stop being true.
  endedAt    DateTime?

  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?

  commissionPlanId String?
  commissionPlan   SalesCommissionPlan? @relation(fields: [commissionPlanId], references: [id])

  /// One resettable demo tenant per rep. @unique so two reps cannot be pointed
  /// at the same demo and reset it out from under each other mid-walkthrough.
  demoCompanyId String?  @unique
  demoCompany   Company? @relation(fields: [demoCompanyId], references: [id])

  createdAt DateTime @default(now())

  /// Who this rep reports to. The org chart lib/sales/team.js derives its
  /// team-lead tier from — there is deliberately no `tier` column, because a
  /// rep IS a team lead exactly when somebody reports to them, and a stored
  /// tier is a second answer that can disagree with the first.
  ///
  /// Shaped after Worker.manager @relation("WorkerReports"), which leave
  /// approval already uses, rather than a new shape nobody has seen before.
  ///
  /// SetNull, not Cascade: a team lead leaving must not delete their reports.
  /// Nothing in the database can stop A reporting to B reporting to A; the
  /// cycle guard is lib/sales/team.js's wouldCycle(), executed by
  /// scripts/check-sales-call-handling.mjs.
  managerId String?
  manager   SalesRep?  @relation("SalesRepReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   SalesRep[] @relation("SalesRepReports")

  attributions      SalesAttribution[]
  touches           SalesAttributionTouch[]
  commissionEntries SalesCommissionEntry[]
  payoutBatches     SalesPayoutBatch[]
  leads             SalesLead[]
  threads           SalesThread[]
  smsMessages       SalesSmsMessage[]
  callAttempts      SalesCallAttempt[]
  activity          SalesRepActivity[]

  @@index([active])
  @@index([managerId])
  repNotes SalesRepNote[]
}

/// What a rep earns, per milestone. A row rather than constants so the numbers
/// can change for new reps without rewriting what existing ones were promised —
/// an entry records the amount it was written with, never a lookup at payout.
model SalesCommissionPlan {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  activationCents   Int @default(2000)
  firstPaymentCents Int @default(4000)
  retentionCents    Int @default(6500)
  /// Days after the first successful payment before the retention milestone can
  /// be earned. Configurable because 60 is a policy, not a fact.
  retentionDays     Int @default(60)

  createdAt DateTime @default(now())
  reps      SalesRep[]
}

/// Which rep brought a company in. One row per company, ever.
///
/// A separate row rather than columns on Company because "locked, correctable
/// and audited" is history, and a column has none. Corrections supersede rather
/// than overwrite — see SalesAttributionAudit.
model SalesAttribution {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id])

  /// "link" | "manual" | "admin"
  source     String
  capturedAt DateTime @default(now())
  /// Attribution locks the moment it is captured. Nothing in the product moves
  /// it; a superadmin correction writes a new row and an audit trail.
  lockedAt   DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([salesRepId])
}

/// A second rep touching a company that is already attributed.
///
/// Recorded rather than refused, deliberately, and this is the important part:
/// a contractor's ability to sign up must never depend on FieldQuo's commission
/// bookkeeping. It also means whichever policy is chosen later — split, first
/// touch, last touch — has the evidence it needs, instead of the losing rep's
/// involvement having been thrown away at the door.
model SalesAttributionTouch {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id])

  source String
  note   String?
  at     DateTime @default(now())

  @@index([companyId])
  @@index([salesRepId])
}

/// Every change to an attribution, by whom and why. Written in the same
/// transaction as the change itself — the discipline MigrationWrite established
/// for the one other place FieldQuo staff may write into tenant-adjacent data.
model SalesAttributionAudit {
  id String @id @default(cuid())

  companyId     String
  fromRepId     String?
  toRepId       String?
  actorAdminId  String
  reason        String
  at            DateTime @default(now())

  @@index([companyId])
}

/// The commission ledger. Append-only.
///
/// Modelled on VoiceCreditEntry, which is the codebase's existing answer to
/// "money that must survive a replayed webhook": a unique ref, a balance that is
/// SUMMED rather than stored, and reversals written as new negative rows rather
/// than edits. An amount already paid is never rewritten — computeInvoiceState
/// makes the same argument on the invoice side, that overloading a status or a
/// figure makes it lie.
model SalesCommissionEntry {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id])

  /// "activation" | "first_payment" | "retention"
  milestone  String
  amountCents Int

  /// Idempotency. `commission:<companyId>:<milestone>` for an earning, and a
  /// distinct reversal ref for its undo, so a webhook delivered twice cannot
  /// pay twice and a reversal cannot land twice either.
  ref String

  /// "earned" | "reversed" | "under_review"
  status String @default("earned")

  /// Stamped from Stripe's own event timestamp where there is one, never
  /// new Date() — the discipline canceledAt already uses, so a replay months
  /// later cannot move when something happened.
  occurredAt DateTime @default(now())

  stripeEventId String?

  payoutBatchId String?
  payoutBatch   SalesPayoutBatch? @relation(fields: [payoutBatchId], references: [id])

  createdAt DateTime @default(now())

  @@unique([companyId, ref])
  @@index([salesRepId, status])
  @@index([payoutBatchId])
}

/// A week's worth of a rep's earnings, closed for payment.
///
/// No money moves from this build. A batch closes, is exported, and is marked
/// paid by a human — paying reps automatically is a separate decision with its
/// own compliance surface, and nothing in the brief requires it on day one.
model SalesPayoutBatch {
  id String @id @default(cuid())

  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id])

  /// UTC day boundaries, via lib/analytics/periodPresets.js, so "the week
  /// closed on Sunday" means the same instant for every rep.
  periodStart DateTime
  periodEnd   DateTime

  /// "open" | "ready" | "paid"
  status String @default("open")

  /// A record of what was owed when the batch closed. NOT the figure paid from
  /// — the ledger is re-summed at payment time, so a reversal landing after the
  /// close is reflected instead of being papered over by a cached total.
  totalCentsAtClose Int @default(0)

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  entries SalesCommissionEntry[]

  @@unique([salesRepId, periodStart])
  @@index([status])
}

// ── A rep's own outreach ───────────────────────────────────────────────────
//
// The owner wants BOTH halves: a rep sends and receives from their own real
// mailbox (10 of them cost $121.27 CAD a year, so per-rep addresses are not the
// constraint they usually are), AND the conversation is attached to the
// prospect inside FieldQuo rather than living only in that mailbox.
//
// Outbound is easy to capture: the rep composes in the portal, FieldQuo sends
// it, so FieldQuo has it. Inbound is the half that needs the mail provider's
// help — the rep's mailbox forwards a copy to an inbound endpoint, which files
// it against the thread. That is why SalesMessage carries a direction and a
// provider id rather than assuming every message was one we sent.
//
// None of this is tenant data. A prospect is FieldQuo's lead, not a
// contractor's client, and a Client row would put it inside somebody's tenant.

model SalesLead {
  id String @id @default(cuid())

  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  businessName String
  contactName  String?
  email        String?
  phone        String?

  /// The prospect's IANA time zone, as the rep states it after speaking to
  /// them. Nullable, and NOT defaulted to anything.
  ///
  /// It exists because texting has a legal clock on it — see
  /// lib/sales/smsWindow.js — and the clock is the RECIPIENT's, not ours. A
  /// rep in Kyiv and a prospect in Vancouver are ten hours apart, so FieldQuo's
  /// own local time is the single most dangerous substitute available. Absent
  /// means absent: the send is refused with that stated, rather than evaluated
  /// against an invented zone. AGENTS.md failure class #5.
  ///
  /// Written from the one place that has the answer — the rep who just had the
  /// person on the phone — rather than inferred from an area code, which is
  /// wrong for every ported mobile and for the area codes that straddle two
  /// zones.
  timeZone String?

  /// "new" | "contacted" | "demoed" | "signed" | "lost"
  status String  @default("new")
  notes  String?

  /// The discovered business this lead came from, when it came from discovery
  /// at all. Nullable because a rep meeting someone at a trade show has a lead
  /// with no Prospect behind it, and forcing one would mean inventing a
  /// discovery record that never happened.
  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id])

  /// Set when this prospect actually signs up, so a rep's pipeline and their
  /// attribution are the same story rather than two lists that disagree.
  convertedCompanyId String?   @unique
  convertedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threads      SalesThread[]
  smsMessages  SalesSmsMessage[]
  callAttempts SalesCallAttempt[]
  inboundCalls PlatformVoiceCall[]

  @@index([salesRepId, status])
  repNotes SalesRepNote[]
}

/// One text message a rep sent a prospect from FieldQuo's own sales number.
///
/// ══ Why this is not a SalesMessage on a SalesThread ════════════════════════
///
/// SalesThread is an EMAIL conversation: it carries a subject and a `replyToken`
/// that is @unique because an inbound reply is matched by it. A text has
/// neither, and a synthetic thread invented to hold one would appear in the
/// rep's conversation list offering a compose box that emails — a control that
/// looks like a reply to the text and is not. Writing phone numbers into
/// `fromAddress`/`toAddress` would also make every query that means "email"
/// silently mean "email or SMS".
///
/// ══ Why there is no inbound direction ══════════════════════════════════════
///
/// A prospect texting STOP back is handled where it matters — as a row on
/// FieldQuo's do-not-contact list (SalesSuppression), keyed on the phone
/// number, which binds FieldQuo rather than one rep's copy of a lead. Filing
/// the inbound message here as well would need a lead to attach it to, and
/// SalesLead.phone is neither unique nor normalised, so two reps holding the
/// same prospect makes that attachment a guess. A field written by a guess is
/// worse than no field.
model SalesSmsMessage {
  id String @id @default(cuid())

  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  leadId String
  lead   SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// E.164 both ways. The `from` is stored rather than derived at read time
  /// because FieldQuo's sales number can be released and replaced, and "which
  /// number did this actually go out from" is the question a carrier complaint
  /// asks.
  fromE164 String
  toE164   String

  /// Exactly what was sent, footer included. The CASL identification and
  /// mailing address are part of the message, so a copy without them would not
  /// evidence the thing it exists to evidence.
  body String

  /// Twilio's message SID. Present because the row is written only after the
  /// provider accepted the message — same rule lib/sales/outreachSender.js
  /// applies to email: a row saying "sent" for a text that never left is the
  /// class of bug AGENTS.md opens with.
  providerId String?

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([salesRepId, sentAt])
  @@index([leadId, sentAt])
}

model SalesThread {
  id String @id @default(cuid())

  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  leadId String
  lead   SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  subject String

  /// The token that makes an inbound reply findable. Put in the outbound
  /// message's Reply-To and References so a reply carries it back, because
  /// matching on the sender's address alone breaks the moment a prospect
  /// replies from their phone with a different address — the same reasoning
  /// app/api/crew/inbound/route.js gives for never keying on the sender.
  replyToken String @unique

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages SalesMessage[]

  @@index([salesRepId, lastMessageAt])
  repNotes SalesRepNote[]
}

model SalesMessage {
  id String @id @default(cuid())

  threadId String
  thread   SalesThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// "out" | "in"
  direction String

  fromAddress String
  toAddress   String
  subject     String
  body        String

  /// Null for an inbound message we merely received. Present for one we sent,
  /// so a delivery failure can be traced back to the provider's own record.
  providerId String?

  /// When the message actually happened, from the provider's own header where
  /// there is one — not when we wrote the row.
  sentAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([threadId, sentAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  Sales intelligence — prospects, evidence, opportunities
// ═══════════════════════════════════════════════════════════════════════════
//
// ── The one architectural rule everything here serves ──────────────────────
//
// A FACT, an INFERENCE and a RECOMMENDATION are three different things and
// never share a column. That is the brief's §2 and it is the reason this is
// six tables instead of a wide Prospect row with a hundred nullable fields.
//
//   ProspectEvidence     — something observed. Has a source and a URL.
//   ProspectCapability   — a normalised yes/no/unknown, derived from evidence.
//   ProspectInference    — a conclusion evidence SUPPORTS but does not prove.
//   ProspectOpportunity  — something FieldQuo might sell, citing evidence.
//
// The failure this prevents is the one the brief names outright: turning "the
// site shows several vans and a team page" into `employeeCount = 12`. An
// inference that gets written into a fact column is indistinguishable from a
// fact a week later, and a rep reads it aloud to a prospect who then corrects
// them. So the layers are separate in the database, not merely in the UI.
//
// ── Why Prospect is NOT SalesLead ─────────────────────────────────────────
//
// SalesLead.salesRepId is required and cascade-deletes with the rep: it is
// structurally "my pipeline", cannot exist before assignment, and dies when
// the rep leaves. A Prospect is org-wide, exists in the thousands, is mostly
// unworked, and carries provenance a typed-in lead never has.
//
// The decisive argument is money. SalesLead.convertedCompanyId is @unique — a
// SECOND path from a prospect to a company would give the commission ledger
// two disagreeing answers about who is attributed. So they are joined by a
// nullable FK on SalesLead and nothing is denormalised across it.

model Prospect {
  id String @id @default(cuid())

  // ── Identity, in the order deduplication trusts it ──────────────────────
  //
  // Deterministic identifiers first, fuzzy matching only after. A Place ID is
  // proof; a similar company name two streets apart is a question.
  googlePlaceId String? @unique
  /// E.164. Normalised on write so a match is a match — see lib/phone.
  phoneE164     String?
  /// Registrable domain, lowercased, no scheme and no www.
  domain        String?

  businessName String
  /// What the source called it, before normalisation. Kept because a
  /// deduplication argument is unreadable without the original strings.
  rawName      String?

  addressLine String?
  city        String?
  province    String?
  postalCode  String?
  country     String?
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  /// What the SOURCE called this business, verbatim and unmapped, namespaced by
  /// provider (`rbq:9`, an Overture slug). Mapping them to a FieldQuo trade is a
  /// separate, revisable decision and must never overwrite the source's words.
  ///
  /// A code here is NOT a trade, and for the Quebec register it is not even a
  /// claim about one: RBQ publishes what a licence PERMITS its holder to do, and
  /// the median licence carries sixteen or seventeen permissions — 81% include
  /// interior finishing. So the set identifies no single trade, which is why
  /// tradeDetect reads the contractor's website instead. The superadmin screen
  /// shows every code and says this in as many words.
  sourceCategories String[] @default([])
  /// The FieldQuo trade this was discovered as, as a key of DISCOVERY_TRADES
  /// in lib/sales/discovery/trades.js. Null when nothing mapped — never a
  /// guess. NOT a ServiceCategory key: that space is quote types, and a
  /// painting contractor sells two of them. trades.js's header argues it.
  tradeKey         String?

  googleRating      Decimal? @db.Decimal(2, 1)
  googleReviewCount Int?
  /// What the SOURCE said about whether this business is trading, verbatim.
  ///
  /// Null means the source said nothing, and nothing may read that as "open".
  /// Overture's `operating_status` is only ever `open` or NULL — measured, no
  /// `closed` value exists at all — so some of these businesses have shut and
  /// the directory does not know it. Provider-neutral on purpose: this is the
  /// same question whoever answers it.
  businessStatus    String?

  // ── Provenance: which source, which record, which release ──────────────
  //
  // Not decoration. "Why do we think this phone number is theirs" has to be
  // answerable a year later, and for a directory source the answer is a
  // (release, record id) pair that can be looked up in a file that still
  // exists. A prospect with no release stamped on it cannot be re-checked
  // against the data it came from, and a monthly-refreshed source makes that
  // a real question rather than a hypothetical one.

  /// The BusinessDiscoveryProvider key — "overture". Null for a prospect that
  /// nothing discovered (a hand-typed row).
  sourceProvider   String?
  /// The provider's own stable id for the record.
  sourceRecordId   String?
  /// Names the business actually trades under, from a register's own
  /// alternate-name column. 15,098 of Quebec's 54,264 RBQ licences — 27.8% —
  /// trade under a name their registered name does not contain: licence
  /// 1104-8618-06 is "Plancher Nobel", "Tapis L. Émard Ltée", "Emard
  /// Couvre-Planchers" and "Décor Tapis Émard", and the registered name says
  /// nothing about flooring. A rep searching "Plancher Nobel" has to find that
  /// row, and dedupe has to see these before deciding two rows are two
  /// businesses. Empty array means the source offered none — it does NOT mean
  /// the business trades only under its registered name.
  tradingNames     String[] @default([])
  /// The regulator's own licence number, as a human types it. Deliberately
  /// duplicated from sourceRecordId: that column is provider-opaque and may be
  /// a composite, while this is the string a superadmin pastes into the RBQ's
  /// public lookup to check a row against the source.
  licenceNumber    String?
  /// The dataset release this came from, e.g. "2026-08-19.0". Overture ships
  /// monthly, so this is what says WHEN the world looked like this.
  sourceRelease    String?
  /// Which contributor inside the source supplied it — meta, Microsoft,
  /// Foursquare. Kept because the fill rates and the staleness differ sharply
  /// between them.
  sourceDataset    String?
  /// The source's own confidence. STORED AND NEVER FILTERED ON: measured, it
  /// is 98.9% phone fill in the lowest bucket against 100.0% in the highest,
  /// and for Foursquare rows it is a per-source constant with three distinct
  /// values across 2,279 records. It is a provenance tag, not a probability.
  sourceConfidence Decimal? @db.Decimal(6, 5)
  /// When the SOURCE last refreshed this record. Null means it did not say —
  /// never now(). 11.6% of the measured sample is pre-2020, and a rep needs to
  /// see that before dialling.
  sourceUpdatedAt  DateTime?

  /// contractor | retailer | needs_review — see lib/sales/discovery/classify.js.
  /// Separate from `status` because it is a fact about what KIND of business
  /// this is, which does not change as the prospect moves through the pipeline.
  classification       String?
  /// The one sentence the review screen shows. Stored rather than recomputed
  /// so a later change to the rules cannot silently rewrite why an existing
  /// row was rejected.
  classificationReason String?

  /// FALSE is a finding, not a blank. The brief is explicit that a business
  /// with a Google profile and no website is a strong prospect, not a
  /// discard — so this is three-valued: true, false, or null for "not yet
  /// looked".
  hasWebsite Boolean?
  websiteUrl String?

  status String @default("discovered")

  territoryId String?
  territory   SalesTerritory? @relation(fields: [territoryId], references: [id])

  campaignId String?
  campaign   ProspectCampaign? @relation(fields: [campaignId], references: [id])

  // ── Ownership: one rep works a prospect at a time ─────────────────────
  //
  // The owner's reason is the operational one rather than the accounting one:
  // two reps must not phone the same contractor. Attribution at signup already
  // decides who gets PAID — the link carries the code and the row locks — but
  // that resolves the money after the fact and does nothing about the
  // contractor answering the same pitch twice in a week.
  //
  // So ownership is claimed BEFORE the call, and released when the rep is done
  // or when the claim goes stale. Stale rather than permanent because a rep who
  // claims two hundred prospects and calls nine of them would otherwise freeze
  // the list for everyone else.
  assignedRepId String?
  assignedAt    DateTime?
  /// When an unworked claim lapses back to the pool. Null for a prospect that
  /// has actually been worked — a real conversation is not a lease.
  claimExpiresAt DateTime?

  /// Set when a human says never contact this business. Distinct from status
  /// so it survives every pipeline transition.
  doNotContactAt     DateTime?
  doNotContactReason String?

  /// A possible duplicate is FLAGGED, never auto-deleted. Merging destroys
  /// provenance, and a wrong merge is unrecoverable.
  possibleDuplicateOfId String?

  lastCrawledAt            DateTime?
  lastGoogleRefreshAt      DateTime?
  lastOpportunityAnalysisAt DateTime?
  /// Hash of the crawled content, so an unchanged site is not re-analysed.
  contentHash              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence      ProspectEvidence[]
  capabilities  ProspectCapability[]
  technologies  ProspectTechnology[]
  inferences    ProspectInference[]
  opportunities ProspectOpportunity[]
  scores        ProspectScore[]
  corrections   ProspectCorrection[]
  leads         SalesLead[]
  callAttempts  SalesCallAttempt[]
  inboundCalls  PlatformVoiceCall[]

  /// One row per (provider, record). The database refuses a second copy of the
  /// same source record rather than the ingest remembering not to write one —
  /// a read-then-write dedupe loses the race between two overlapping cron
  /// ticks, and the schema is the only place that cannot.
  @@unique([sourceProvider, sourceRecordId])
  @@index([licenceNumber])
  /// GIN, not B-tree: the category filter is Prisma `has`, which compiles to
  /// `@> ARRAY[$1]`, and a B-tree cannot answer containment on an array column.
  /// It does NOT help the facet aggregate that builds the picker's option list —
  /// that unnests every row by design, which is why a failure there disables the
  /// picker rather than the page.
  @@index([sourceCategories], type: Gin)
  @@index([status])
  @@index([assignedRepId, status])
  @@index([territoryId, status])
  @@index([campaignId])
  @@index([campaignId, classification])
  @@index([phoneE164])
  @@index([domain])
  repNotes SalesRepNote[]
  playbookAssignments SalesPlaybookAssignment[]
  talkingPoints       ProspectTalkingPoint[]
}

/// Something we OBSERVED. The bottom of the stack; everything above cites it.
///
/// First-class rather than a JSON blob on Prospect because the question this
/// exists to answer — "why does FieldQuo think this company has no online
/// booking?" — is a join, and a blob cannot be joined to a recommendation.
model ProspectEvidence {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  /// What kind of observation: "page_content" | "script_src" | "iframe_host" |
  /// "google_field" | "form" | "link" | "meta" | "schema_org" | "transcript"
  type String
  /// Where it came from: "google" | "website" | "bbb" | "registry" | "call"
  source    String
  sourceUrl String?

  /// The observation as found, and as normalised. Both, because a fingerprint
  /// argument that shows only the normalised form is unreviewable.
  rawValue        String?
  normalizedValue String?

  observedAt DateTime @default(now())
  confidence Decimal  @default(1.0) @db.Decimal(3, 2)

  /// Which detector produced this, and which version of it. Without the
  /// version, an improvement to a detector silently rewrites history.
  detector        String?
  detectorVersion String?

  createdAt DateTime @default(now())

  @@index([prospectId, type])
  @@index([prospectId, source])
  /// contactBasisFor() resolves an address's provenance by exact match here,
  /// on every send. Without this it is a full scan of the evidence table.
  @@index([rawValue])
}

/// A normalised capability: does this business have online booking, live chat,
/// online payment, and so on.
///
/// `value` is deliberately nullable. "Not detected" and "definitely absent"
/// are different claims, and collapsing them is how a rep ends up telling a
/// contractor they have no booking page when they have one the crawler could
/// not reach.
model ProspectCapability {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  /// ONLINE_BOOKING, INSTANT_ESTIMATE, LIVE_CHAT, ONLINE_PAYMENT, ...
  code  String
  value Boolean?

  confidence Decimal @default(0.5) @db.Decimal(3, 2)
  /// Evidence ids. A recommendation that cites this can walk back to what was
  /// actually seen.
  evidenceIds String[] @default([])

  detectedAt      DateTime @default(now())
  detectorVersion String?

  @@unique([prospectId, code])
  @@index([code, value])
}

/// A technology fingerprint — Jobber, Housecall Pro, Calendly, a chat widget.
///
/// Competitor detection changes the entire sales conversation, so this is its
/// own table rather than a capability: a capability answers "can they book
/// online", this answers "with whose software".
model ProspectTechnology {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  /// The signature that matched, by code.
  technologyCode String
  /// True when this technology is a FieldQuo competitor rather than an
  /// adjacent tool. Stored rather than derived so the classification can
  /// change without rewriting detections.
  isCompetitor   Boolean @default(false)

  confidence  Decimal  @default(0.5) @db.Decimal(3, 2)
  evidenceIds String[] @default([])

  detectedAt       DateTime @default(now())
  signatureVersion String?

  @@unique([prospectId, technologyCode])
  @@index([technologyCode])
}

/// A conclusion the evidence SUPPORTS but does not prove.
///
/// Its own table so nothing can accidentally read an inference as a fact. The
/// canonical example is company size: several vans in a photo and a team page
/// support "small team", and they do not support "eleven employees". `value`
/// is therefore a CLASSIFICATION, never a number.
model ProspectInference {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  /// "company_scale" | "organization_structure" | "decision_maker" | ...
  kind String
  /// SOLO_LIKELY, SMALL_BUSINESS, FRANCHISE_LIKELY, ... A bucket, not a count.
  value String

  confidence  Decimal  @default(0.5) @db.Decimal(3, 2)
  evidenceIds String[] @default([])

  /// Where the claim came from. A prospect SAYING "we have six technicians" on
  /// a recorded call is first-party and outranks any web inference — this is
  /// what lets that supersede rather than sit beside it.
  source     String   @default("derived")
  observedAt DateTime @default(now())

  modelVersion String?

  @@unique([prospectId, kind])
  @@index([kind, value])
}

/// Something FieldQuo might sell, and why.
///
/// Every row cites evidence. A recommendation with no evidenceIds is the
/// generic sales filler the brief exists to prevent, so the absence is
/// visible rather than plausible.
model ProspectOpportunity {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  /// FK by code to the FieldQuo capability matrix — never a free-text feature
  /// name, so nothing can recommend a capability the product does not have.
  capabilityCode String
  capability     FieldQuoCapability @relation(fields: [capabilityCode], references: [code])

  rank       Int     @default(0)
  confidence Decimal @default(0.5) @db.Decimal(3, 2)

  /// Human-readable, generated from the rule that fired. Shown to the rep.
  reason      String
  evidenceIds String[] @default([])

  /// Which rule produced it, so a bad recommendation is traceable to a rule
  /// rather than to "the AI".
  ruleCode    String?
  ruleVersion String?

  generatedAt DateTime @default(now())

  @@unique([prospectId, capabilityCode])
  @@index([capabilityCode])
}

/// How worth calling this prospect is. Separate from confidence: confidence is
/// how sure we are of the DATA, this is how attractive the PROSPECT is.
///
/// Versioned rows rather than a column, so changing the scoring model does not
/// make last month's analytics unreadable.
model ProspectScore {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  score Int
  /// [{ label, weight }] — the shape LeadRequest.scoreReasons already uses, so
  /// a score is explainable in the UI without a second convention.
  reasons Json?

  scoringVersion String
  computedAt     DateTime @default(now())

  @@index([prospectId, computedAt])
  @@index([score])
}

/// A human saying the machine got it wrong.
///
/// A confirmed correction outranks automated inference — that is the point.
/// Kept as its own row rather than an in-place edit so the detector that was
/// wrong can be found and fixed, which an overwrite would hide.
model ProspectCorrection {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  /// Which thing was corrected: "capability:ONLINE_BOOKING",
  /// "technology:JOBBER", "inference:company_scale", "field:phoneE164"
  target String

  originalValue  String?
  correctedValue String?
  reason         String?

  correctedByAdminId String?
  correctedByRepId   String?
  correctedAt        DateTime @default(now())

  @@index([prospectId])
  @@index([target])
}

// ── Configuration the owner can change without a deploy ────────────────────

/// What FieldQuo can actually provide. The ONLY source of truth for what may
/// be recommended, which is what makes "never recommend a capability FieldQuo
/// does not have" enforceable rather than aspirational — ProspectOpportunity
/// has a foreign key to it.
model FieldQuoCapability {
  id   String @id @default(cuid())
  code String @unique
  name String
  description String?

  active        Boolean @default(true)
  salesPriority Int     @default(0)

  /// What must be observed before this may be recommended.
  requiredEvidence Json?
  /// Capability codes that make this one irrelevant.
  incompatibilities String[] @default([])
  recommendedTalkingPoints Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities ProspectOpportunity[]
}

/// A technology fingerprint, as data rather than code — so a new competitor
/// can be detected without redeploying the crawler.
model TechnologySignature {
  id   String @id @default(cuid())
  code String @unique
  name String

  isCompetitor Boolean @default(false)
  active       Boolean @default(true)

  /// [{ kind: "script_src"|"iframe_host"|"html"|"link"|"meta", pattern, weight }]
  /// Matched deterministically. The brief is explicit that fingerprinting is
  /// NOT an AI task — a model guessing at a competitor would be confidently
  /// wrong in a sales conversation.
  patterns Json

  version   String   @default("1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Weights behind a confidence figure, editable by a superadmin.
model ConfidenceRule {
  id     String  @id @default(cuid())
  signal String  @unique
  weight Decimal @db.Decimal(4, 3)
  category String?
  enabled  Boolean @default(true)
  version  String  @default("1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// When a capability gap becomes a recommendation.
model OpportunityRule {
  id   String @id @default(cuid())
  code String @unique
  name String

  capabilityCode String
  /// The conditions, as data: which prospect capabilities/technologies must
  /// hold. Deterministic — AI may phrase the reason, never decide it.
  conditions Json
  /// Template for the human-readable reason. Interpolated from evidence, so a
  /// reason cannot claim something no evidence supports.
  reasonTemplate String

  priority Int     @default(0)
  active   Boolean @default(true)
  version  String  @default("1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesTerritory {
  id   String @id @default(cuid())
  name String @unique

  country  String?
  province String?
  city     String?

  /// A radius territory works with what the codebase already has —
  /// haversineKm in lib/booking/travel.js is pure and needs no API key.
  /// Polygons and postcode sets are deliberately not modelled yet.
  centerLat Decimal? @db.Decimal(9, 6)
  centerLng Decimal? @db.Decimal(9, 6)
  radiusKm  Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  prospects Prospect[]
  campaigns ProspectCampaign[]
}

/// One discovery run: "1,000 painting contractors in Ottawa".
model ProspectCampaign {
  id   String @id @default(cuid())
  name String

  territoryId String?
  territory   SalesTerritory? @relation(fields: [territoryId], references: [id])

  /// The trade this campaign banks, or null when `allTrades` is set. Exactly
  /// one of the two is a statement; neither is a campaign that cannot run, and
  /// both the create route and runDiscoverBusinesses refuse it rather than
  /// picking one.
  tradeKey String?

  /// "Bank every trade this source returns" — the owner's ask, stated
  /// explicitly rather than inferred from `tradeKey` being null.
  ///
  /// A BOOLEAN and not a null trade key, because absence is not a statement
  /// (AGENTS.md's fifth failure class). A row whose `tradeKey` is null because
  /// nobody chose one and a row whose trade is deliberately "all of them" want
  /// opposite behaviour, and telling them apart from one nullable column is
  /// impossible — the safe reading (bank nothing) makes the feature dead, and
  /// the unsafe one silently banks 54,264 licence-holders into the research
  /// pipeline. So the deliberate choice carries its own column.
  ///
  /// What it changes, exactly: `planIngest` stops skipping a business whose
  /// category maps to a DIFFERENT trade — that row is written with ITS OWN
  /// trade key and counted as accepted. What it does NOT change: a rep's queue
  /// is still single-trade, because claimCandidateWhere() filters on an exact
  /// trade key and knows nothing about campaigns. A roofer banked here is
  /// claimable from the ROOFING queue and from no other.
  allTrades Boolean @default(false)

  keywords String[] @default([])

  /// How many prospects the campaign is FOR. Two things measure against it,
  /// and they are different: `campaignProgress` stops discovery at this many
  /// ACCEPTED rows, and `researchBudget` caps how many of this campaign's
  /// prospects may ever be promoted into crawling and analysis. Banking is
  /// cheap and researching is not — about seven pipeline tasks per prospect
  /// against a platform ceiling of ~3,600 tasks/day — so the expensive half is
  /// bounded by a number a human typed.
  targetCount Int    @default(100)

  /// Where the business comes from — a SET, because the owner's rule is that
  /// "where the business comes from should be a checkbox to allow multiple
  /// sources, not one or the other". One campaign draws from Overture AND a
  /// licence register AND a bought list, in one run.
  ///
  /// NO DEFAULT, deliberately, and an EMPTY list rather than one. The obvious
  /// default was "google", and the compliance audit of 2026-09-01 found that
  /// the Maps Platform ToS (§3.2.3(a)(iii), §3.2.3(d)(iii)) prohibits copying
  /// and saving business names and addresses, and prohibits building a
  /// directory or augmenting an advertising product — which is precisely this
  /// table. Worse, §5.2(d) permits immediate suspension, and the same key
  /// powers address autocomplete, the maps and the Solar roof measurement in
  /// the live product.
  ///
  /// So a campaign must NAME its sources rather than inherit any, and an empty
  /// list means nobody has chosen yet. Choosing a source is choosing a
  /// LICENCE, and choosing three is taking on three sets of terms at once —
  /// which is why lib/sales/discovery/provider.js refuses to register a source
  /// that does not state its own.
  discoverySources String[] @default([])

  /// Settings each chosen source needs, KEYED BY SOURCE — `{ "overture":
  /// { "snapshotUrl": "…" }, "rbq": { "snapshotUrl": "…" } }`.
  ///
  /// Keyed rather than one blob because both shipped sources have a config
  /// field called `snapshotUrl`. A single blob for several sources means the
  /// second source reads the first source's file: a wrong dataset ingested
  /// under the right provider name, with nothing anywhere saying so.
  ///
  /// Source-specific by design: putting `snapshotUrl` on the model itself
  /// would bake one provider's transport into a provider-neutral table, and
  /// the next provider would add a second column nothing else reads. It lives
  /// here and not in an environment variable because of the owner's standing
  /// rule: every setting is editable from the superadmin UI.
  sourceConfigs Json?

  /// Where each source got to, keyed the same way — `{ "overture": { "cursor":
  /// "1200", "ended": false, "blocked": null, "failures": 0, "lastError":
  /// null, "lastErrorAt": null } }`.
  ///
  /// One cursor cannot serve several sources: they page independently, in
  /// their own dialects, and one running out says nothing about the others.
  /// `ended` and `blocked` are separate states on purpose — a campaign whose
  /// second source died is NOT a campaign that found everything there was, and
  /// only `blocked` makes that visible. See lib/sales/discovery/sources.js.
  sourceState Json?

  /// ── The three columns below are READ and no longer WRITTEN ─────────────
  ///
  /// Every campaign created before 2026-09-03 carries its single source here
  /// and nowhere else, and `prisma db push` moves no data — so dropping them
  /// would delete the only record of what those campaigns were discovering.
  /// lib/sales/discovery/sources.js falls back to all three when the plural
  /// fields above are empty, which is what makes an existing single-source
  /// campaign keep running unchanged.
  ///
  /// Writing BOTH the old and the new shape was rejected: `discoveryProvider`
  /// would then have to hold one of three sources, and a column that names one
  /// of three lies about the other two.
  discoveryProvider String?
  providerConfig    Json?
  discoveryCursor   String?

  status String @default("draft")

  /// Counters, so the admin screen can show progress without scanning rows.
  ///
  /// The funnel these serve is spec §56: found → duplicates removed →
  /// accepted → no website → ready → needs review. Every one is incremented in
  /// the same transaction as the write it counts, so a crashed run cannot
  /// leave a total that disagrees with the rows.
  foundCount      Int @default(0)
  duplicateCount  Int @default(0)
  acceptedCount   Int @default(0)
  readyCount      Int @default(0)
  needsReviewCount Int @default(0)
  /// Classified as a shop or a supplier and NOT written as a prospect. Counted
  /// rather than stored: the decision is deterministic and re-runnable from the
  /// same release, so nothing is lost, and a rep's queue never contains a row
  /// whose only purpose is to be skipped.
  rejectedCount   Int @default(0)
  /// Accepted, and the SOURCE listed no website. Not the same claim as
  /// `Prospect.hasWebsite = false`, which only the crawler may make.
  noWebsiteCount  Int @default(0)
  /// Rows that could not go into THIS campaign's queue: the source category
  /// maps to no FieldQuo trade, or maps to a different one, or the row carried
  /// no name or id. Reported so a gap in the trade map shows up as a number
  /// instead of as a quietly smaller campaign.
  unmappedCount   Int @default(0)
  /// A SUBSET of `unmappedCount`: the rows whose category mapped to no trade
  /// and which were written to the bank anyway, with `Prospect.tradeKey` null.
  ///
  /// Not part of the funnel's arithmetic — `found` still equals unmapped +
  /// duplicates + rejected + needsReview + accepted — because these rows were
  /// already counted as dropped from THIS campaign's queue. They are counted
  /// separately because "the trade map has a gap and we kept 54,000 licence
  /// holders" and "we threw 54,000 rows away" are different outcomes that
  /// `unmappedCount` alone cannot distinguish. A banked row is not callable:
  /// claimCandidateWhere() filters on an exact trade key, so nothing with a
  /// null one reaches a rep until lib/sales/intel/tradeDetect.js establishes
  /// a trade from the business's own website.
  bankedCount     Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  prospects Prospect[]

  @@index([status])
}

/// The generic pipeline task.
///
/// Modelled on VoiceCallTask, which already has the right shape — status,
/// notBefore, attempts, lastError, and an index on (status, notBefore) — and
/// on lib/voice/autoTopup.js, which already has the atomic claim, a stale-claim
/// timeout, and token reuse so a reclaim keeps its idempotency key. Those two
/// were written for different features and never met; together they are this.
///
/// A queue library was rejected: it would be a second scheduling mechanism
/// whose failures look nothing like the nineteen crons already here.
model SalesPipelineTask {
  id String @id @default(cuid())

  /// DISCOVER_BUSINESSES, ENRICH_BUSINESS, CRAWL_WEBSITE, DETECT_TECHNOLOGY,
  /// ANALYZE_CAPABILITIES, DETECT_OPPORTUNITIES, CALCULATE_LEAD_SCORE, ...
  kind String

  prospectId String?
  campaignId String?

  /// Everything the task needs, so a runner never re-derives inputs that may
  /// have changed since it was queued.
  payload Json?

  /// queued | claimed | done | failed | abandoned
  status String @default("queued")

  /// Do not run before this. Carries the backoff.
  notBefore DateTime @default(now())

  attempts  Int     @default(0)
  lastError String?

  /// Who holds the claim and when it goes stale. A claim that dies mid-flight
  /// must become reclaimable, or one crashed run wedges the task forever.
  claimedAt    DateTime?
  claimToken   String?
  claimExpires DateTime?

  /// Idempotency across a reclaim: the token is REUSED rather than reissued,
  /// so retrying cannot produce a second side effect at a provider.
  idempotencyKey String? @unique

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status, notBefore])
  @@index([kind, status])
  @@index([prospectId])
  @@index([campaignId])
}

/// Per-host crawl politeness.
///
/// A database row and not lib/rateLimit.js, whose own header says it lives in
/// lambda memory — which is exactly what cross-invocation crawl politeness
/// cannot use. Two lambdas hammering one contractor's site is how FieldQuo's
/// crawler gets blocked and deserves to be.
model CrawlHostPolicy {
  id   String @id @default(cuid())
  host String @unique

  /// Parsed robots.txt outcome. Null means not yet fetched — NOT "allowed".
  robotsAllowed   Boolean?
  robotsFetchedAt DateTime?
  crawlDelayMs    Int?

  lastRequestAt DateTime?
  requestCount  Int       @default(0)

  /// Set when a host asks us to stop, by 429 or by robots. Respected until it
  /// expires rather than retried on the next run.
  blockedUntil DateTime?
  blockReason  String?

  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
// FieldQuo's own do-not-contact list
// ═══════════════════════════════════════════════════════════════════════════
//
// ── Why none of the existing consent tables could hold this ────────────────
//
// CallConsent and MarketingSubscriber are both `companyId`-scoped, and that is
// not an accident of implementation — they model a TENANT's relationship with
// a HOMEOWNER. FieldQuo cold-calling a contractor is a different party, a
// different audience and a different legal basis; writing it into either table
// would either need a fake Company row for FieldQuo (which lib/platform/
// salesCall.js already refused to create, for the same reason) or a nullable
// companyId that every existing tenant-scoped query would then have to
// remember to exclude.
//
// The compliance audit (docs/sales-intel/AUDIT-compliance.md §5) searched for
// a platform-level list properly and found nothing in any channel. This is it.
//
// ── The principle, in one line ─────────────────────────────────────────────
//
// An opt-out binds FieldQuo, not one rep's copy of a row. `SalesLead` has no
// unique constraint on email, so two reps can hold the same prospect; the
// pre-existing `leadOptedOut()` silenced one rep's copy and left the other
// free to keep emailing. Nothing here is scoped to a rep, a lead, a campaign
// or a company.

/// An instruction to FieldQuo never to make contact again.
///
/// Keyed three ways, independently, because the channels are not independent:
/// a prospect who says "stop calling me" on the phone has also said stop to
/// the email, and a lookup that only knew their number would keep writing.
model SalesSuppression {
  id String @id @default(cuid())

  /// "email" | "phone" | "domain" — see SUPPRESSION_KINDS in
  /// lib/sales/suppressionRules.js, which is the only place that normalises a
  /// value into one of these.
  kind String
  /// The NORMALISED key. Lowercased address, E.164 number, or registrable
  /// domain with no scheme and no www. Never the raw string a human typed —
  /// `Bob <BOB@Acme.com>` and `bob@acme.com` have to collide, or the list
  /// answers "not suppressed" to the same person twice.
  value String

  /// Exactly what was given to us, before normalisation. Kept because a
  /// regulator asking "who asked you to stop, and what did they say" is
  /// answered by the original strings, not by our canonical form.
  rawValue String?

  /// Which channels this closes: "email", "phone", "sms". A list rather than a
  /// boolean because a narrow request ("stop emailing, you can still call")
  /// is a real thing a person says, and recording it as a blanket stop would
  /// be padding absent data with a default — AGENTS.md failure class #5.
  ///
  /// NO schema default, deliberately. The widening happens in code, where it
  /// can be argued: an unqualified "stop" is written as every channel, because
  /// over-suppression is the safe failure and under-suppression is the fine.
  channels String[]

  /// How the request reached us: "reply" | "call" | "sms" | "form" |
  /// "manual" | "import" | "regulator". Part of the evidence, not decoration —
  /// the Canadian internal-DNC obligation is about honouring a REQUEST, so
  /// where the request came from is the thing being retained.
  source String
  /// Free text, in the person's own terms where we have them.
  reason String?
  /// A URL that evidences the request, when there is one.
  evidenceUrl String?

  /// Where this came from, as loose pointers rather than foreign keys.
  ///
  /// Deliberately NOT relations: a FK with a cascade would let deleting a
  /// SalesRep (and with them their cascaded leads, threads and messages)
  /// delete the do-not-call record that outlives them by three years. The
  /// pointer going stale is the acceptable failure; the row vanishing is not.
  salesLeadId    String?
  prospectId     String?
  salesMessageId String?

  /// When the person actually asked. The retention clock runs from here, not
  /// from createdAt — a list imported later must not restart it.
  requestedAt DateTime @default(now())

  /// The date before which this row must not be deleted by anything, ever.
  /// Computed once and STORED so the obligation is legible in the row rather
  /// than only in a function somewhere. See internalDncRetainUntil() in
  /// lib/sales/suppressionRules.js for where three years and fourteen days
  /// comes from.
  retainUntil DateTime

  /// Who recorded it. Both nullable: a rep filing a reply and a superadmin
  /// pasting a regulator's list are both real, and an automated write from the
  /// inbound mail handler has neither.
  createdBySalesRepId String?
  createdByAdminId    String?

  /// ── Removal is a soft state, and superadmin-only ────────────────────────
  ///
  /// The row is never deleted. `removedAt` lifts the block; the record of the
  /// original request stays, which is what the retention obligation is about.
  /// A removal with no reason is refused in code — see unsuppress().
  removedAt       DateTime?
  removedByAdminId String?
  removedReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Required (not optional) on purpose: Prisma's default referential action
  /// for a required relation is Restrict, so a SalesSuppression that has ever
  /// been touched cannot be deleted even by a hand-written query. The
  /// retention obligation gets a constraint, not only a convention.
  events SalesSuppressionEvent[]

  /// One row per key. An add for a key that already exists reopens and
  /// re-evidences that row rather than creating a second one that a lookup
  /// might or might not find.
  @@unique([kind, value])
  /// The send-time lookup: several keys at once, live rows only.
  @@index([kind, value, removedAt])
  @@index([removedAt])
  @@index([requestedAt])
}

/// Every add, re-add and removal, append-only.
///
/// SalesSuppression carries the CURRENT state and is mutated by a re-add; this
/// is the history that mutation would otherwise overwrite. Separate for the
/// same reason ProspectCorrection is separate from Prospect: an in-place edit
/// hides the sequence, and the sequence is the evidence.
model SalesSuppressionEvent {
  id String @id @default(cuid())

  suppressionId String
  suppression   SalesSuppression @relation(fields: [suppressionId], references: [id])

  /// "suppressed" | "resuppressed" | "removed"
  action String

  source   String?
  reason   String?
  channels String[]

  actorAdminId    String?
  actorSalesRepId String?

  occurredAt DateTime @default(now())

  @@index([suppressionId, occurredAt])
  @@index([action, occurredAt])
}


/// FieldQuo's OWN AI spend, at cost.
///
/// ══ Why this is not AiUsage ═══════════════════════════════════════════════
///
/// AiUsage.companyId is NOT NULL and recordAiUsage returns null without one,
/// so every model call FieldQuo makes for itself — the sales copilot, prospect
/// analysis, research briefs — is currently invisible. There is precedent for
/// spending unmetered (anonymous Jennifer calls the model with no metering at
/// all, deliberately), but a prospecting pipeline running at volume is a
/// different proposition: nobody notices a slow leak until the invoice.
///
/// Making AiUsage.companyId nullable was the obvious alternative and was
/// rejected. Every read of that table is "this company, this month", its index
/// says so, and a nullable tenant key would put FieldQuo's own spend inside
/// queries that mean "a customer's usage" — the same conflation
/// PlatformVoiceCall exists to avoid, one table along.
///
/// ══ At cost, not at price ═════════════════════════════════════════════════
///
/// costMicros is what the VENDOR charges, in millionths of a dollar, the same
/// unit and the same reasoning AiUsage uses: one call can cost $0.0004 and
/// summing floats over thousands of rows accumulates error into a number
/// someone will hold against an invoice.
///
/// There is no revenue column and there must not be one. A tenant's AI usage
/// has a spread between what FieldQuo pays and what it charges; this has none.
/// FieldQuo is spending its own money on its own sales operation.
model PlatformAiUsage {
  id String @id @default(cuid())

  /// Which part of the sales system spent this — "prospect_analysis",
  /// "research_brief", "call_summary", "coaching". Lets a spike be traced to a
  /// stage rather than to "AI", which is the whole point of measuring.
  area  String
  model String

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  /// Millionths of a dollar. Null is NOT zero — it means the vendor gave no
  /// figure and nothing invented one.
  costMicros Int?

  /// What it was spent on, when that is knowable. Both nullable: a coaching
  /// pass belongs to a call, not a prospect.
  prospectId String?
  campaignId String?

  /// Who or what triggered it. Null for background pipeline work.
  salesRepId String?

  /// Idempotency, so a retried pipeline task cannot double-count spend.
  ref String? @unique

  createdAt DateTime @default(now())

  @@index([area, createdAt])
  @@index([campaignId])
}

/// A ceiling on what a prospecting run may spend before it stops and asks.
///
/// checkAiQuota has no untenanted equivalent — it gates on a company's plan,
/// and FieldQuo has no plan. Without something here, a misconfigured campaign
/// spends until someone reads a bill.
///
/// Deliberately a STOP, not a warning. A budget that only warns is a budget
/// that gets exceeded, and the pipeline is unattended overnight by design.
model PlatformAiBudget {
  id String @id @default(cuid())

  /// "campaign" | "daily" | "global"
  scope   String
  /// The campaign id for a campaign budget; null for daily and global.
  scopeId String?

  limitMicros Int
  /// Summed from PlatformAiUsage rather than stored, so the ledger and the
  /// budget cannot disagree. Kept here only as a cached read for the console,
  /// and never the thing a spend decision is made against.
  cachedSpentMicros Int @default(0)
  cachedAt          DateTime?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId])
}

// ═══════════════════════════════════════════════════════════════════════════
// THE NOTIFICATION FEED — docs/construction/AUDIT-notifications.md §8.1
// ═══════════════════════════════════════════════════════════════════════════

/// One notable thing that happened inside one company. Written once, no matter
/// how many people are told — "the quote was accepted" is one row and "Ann and
/// Bo were told" is two NotificationDelivery rows.
///
/// Deliberately NOT ActivityLog. That table records who DID what for audit, is
/// owner/admin-only, and swallows its own write failures by design
/// (lib/activity/log.js) — acceptable for a trail you consult, wrong for the
/// only record that somebody was told a chargeback landed.
///
/// ── Why there is no `title` string here ──────────────────────────────────
///
/// The audit sketched a `title`/`body` composed at write time, like
/// ActivityLog.summary. Two things make that the wrong shape, and both are
/// AGENTS.md rules:
///
///   1. A stored English sentence is a stored English sentence. Non-negotiable
///      #6 is about documents, but the /app interface is translated (en + fr,
///      gated by check:translations) and a feed row composed at write time can
///      never be read in French.
///   2. A pre-composed string is composed by somebody who does not know who
///      will read it. Put a dollar figure in it and it is DELIVERED to whoever
///      can read the row — redacting at render is already too late, which is
///      the GET /api/clients failure enforce.js's REDACTION section was written
///      after. §10.8 of the audit says it plainly: not "redacted for", not
///      delivered to.
///
/// So the row stores the TYPE and structured `params` (a catalog-declared
/// allowlist of key names — see lib/notifications/catalog.js), and the sentence
/// is built at read time from the reader's own message catalogue. Money never
/// enters `params`: it lives in `amount`, which lib/notifications/render.js
/// joins in only for a reader the catalog says may see money.
model NotificationEvent {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// A key of NOTIFICATION_TYPES in lib/notifications/catalog.js. Reuses
  /// ActivityLog's dotted vocabulary where one already exists ("quote.accepted",
  /// "leave.requested") so the two never invent two names for one thing.
  type String

  /// What it happened to. entityType drives the link the feed row opens; both
  /// are null for an event that has no destination screen.
  entityType String?
  entityId   String?

  /// Catalog-declared, money-free parameters for the sentence — a quote number,
  /// a client's name, a worker's name. Anything not on the type's declared
  /// `params` list is dropped by notifyEvent before the row is written, so a
  /// careless caller cannot smuggle a price in here.
  params Json?

  /// The figure, structurally, so it can be withheld. Null for every type whose
  /// catalog entry does not set `money: true`.
  amount   Decimal? @db.Decimal(12, 2)
  currency String?

  /// Who caused it. Null is a real answer rather than a gap — "the homeowner
  /// approved it" and "Stripe told us" have no member.
  actorUserId String?
  actorName   String?

  createdAt DateTime @default(now())

  deliveries NotificationDelivery[]

  @@index([companyId, createdAt])
  @@index([companyId, type, createdAt])
}

/// One person's copy of one event. The read state lives here and nowhere else.
///
/// Keyed to the MEMBER, not the User. Read state is per (person, company): a
/// user who belongs to two companies must not carry one company's read state
/// into the other. User.uiState is the counter-example — it is user-global, and
/// putting read state there would leak it across tenants for anybody with two
/// memberships (audit §6.1).
model NotificationDelivery {
  id      String            @id @default(cuid())
  eventId String
  event   NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Denormalised so every query on this model can be companyId-scoped without
  /// a join — which is what scripts/check-tenant-scope.mjs requires of every
  /// single-record lookup once a model carries a companyId at all.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  readAt DateTime?

  /// Delivered-state, mirroring JobPhotoMention.notifiedVia: which channels
  /// this copy actually went out on. ["in_app"] is the whole of v1 — there is
  /// no push (no service worker, no VAPID, and iOS Safari cannot subscribe
  /// outside a Home Screen install this product never prompts for) and no new
  /// email, because the events that already email still email from where they
  /// always did and a feed must not double-notify.
  channels String[] @default(["in_app"])

  createdAt DateTime @default(now())

  /// Fan-out is idempotent. A retried Stripe webhook or a double-submitted form
  /// must not put the same acceptance in somebody's feed twice — createMany
  /// with skipDuplicates leans on exactly this index.
  @@unique([eventId, memberId])
  @@index([companyId, memberId, readAt, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  Field operations — documents, daily logs, equipment, purchasing, fleet
// ═══════════════════════════════════════════════════════════════════════════

/// A file that belongs to a job.
///
/// Document MANAGEMENT, which the product did not have. `lib/documents/` is
/// document RENDERING — it builds a quote PDF. Those are different things and
/// the name has been misleading anyone who went looking.
///
/// Deliberately hung off Job rather than a free-floating folder tree. A
/// contractor's documents are about a job; a general drive is a different
/// product and an empty one is worse than none.
model JobDocument {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name String
  /// "plan" | "permit" | "contract" | "warranty" | "photo" | "invoice" | "other"
  kind String  @default("other")
  url  String
  /// Bytes as the provider reported them. Null when it did not say — never
  /// zero, which would read as an empty file.
  sizeBytes Int?
  mimeType  String?

  /// Superseding rather than overwriting: a revised drawing is a NEW row that
  /// points at the one it replaces, so "which plan were we working from in
  /// March" stays answerable. Overwriting a URL loses exactly that.
  supersedesId String?  @unique
  supersedes   JobDocument? @relation("DocumentRevision", fields: [supersedesId], references: [id])
  supersededBy JobDocument? @relation("DocumentRevision")

  uploadedById String?
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, jobId])
  @@index([jobId, kind])
}

/// What happened on a job on a given day.
///
/// The ingredients already existed and never met: JobPhoto has photos, tasks
/// have completion comments, JobVisit.notes has a write path with no caller.
/// This is the row that ties a day together.
///
/// One log per job per day, enforced — two half-written logs for one Tuesday is
/// how a daily log stops being a record.
model JobDailyLog {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// The DAY being reported on, at UTC midnight — not when it was written. A
  /// crew member filling yesterday's log at 6am is normal and must not create
  /// a second Tuesday.
  logDate DateTime

  /// BlockNote's JSON document. Decided 2026-09-02: BlockNote → JSON →
  /// Postgres with autosave, no realtime — see docs/construction/
  /// AUDIT-realtime-hosting.md for the costing of the alternatives.
  body Json?
  /// Plain text extracted from `body`, for search. Derived, never authored —
  /// two sources of truth for the same words is how they drift.
  bodyText String?

  weather      String?
  crewCount    Int?
  hoursOnSite  Decimal? @db.Decimal(6, 2)
  delays       String?

  authorUserId String?
  authorName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, logDate])
  @@index([companyId, logDate])
}

/// A piece of equipment AT a client's site — the furnace, the panel, the unit.
///
/// Not `Asset`, which is FieldQuo's customer's own kit (a van, a sprayer) and
/// carries depreciation. This is the customer's CUSTOMER's equipment, and the
/// thing that makes it worth storing is the warranty: "installed 2019, covered
/// to 2029, serviced three times" is what turns a cold call into a renewal.
///
/// No warranty period existed anywhere in the product before this.
model ClientEquipment {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name         String
  manufacturer String?
  modelNumber  String?
  serialNumber String?

  /// Where it physically is. A client can have three properties.
  siteAddress String?

  installedAt DateTime?
  /// Null means UNKNOWN, not "no warranty". A blank warranty date must never
  /// be rendered as "out of warranty" — that is a claim nobody made, and it is
  /// the difference between a renewal call and an insult.
  warrantyEndsAt   DateTime?
  warrantyProvider String?
  warrantyNotes    String?

  installedByJobId String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services ClientEquipmentService[]

  @@index([companyId, clientId])
  @@index([companyId, warrantyEndsAt])
}

/// A visit to a piece of equipment. The service history behind the warranty.
model ClientEquipmentService {
  id String @id @default(cuid())

  equipmentId String
  equipment   ClientEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  jobId       String?
  servicedAt  DateTime
  description String
  /// Set when this visit was covered rather than billed — the fact a warranty
  /// exists to record.
  underWarranty Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([equipmentId, servicedAt])
}

/// Who a contractor buys from.
///
/// Purchasing existed as free text on a Bill. A supplier as an ENTITY is what
/// makes "what did we spend at this merchant this year" and "which PO is this
/// receipt against" answerable.
model Supplier {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  accountRef  String?
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([companyId, active])
}

model PurchaseOrder {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  jobId      String?

  /// Per company, not global. Two companies both having PO-001 is correct.
  number String

  /// "draft" | "sent" | "partial" | "received" | "cancelled"
  status String @default("draft")

  /// What was agreed. Actual cost lives on the receipt/bill — the gap between
  /// the two is the number a contractor wants and cannot currently get.
  expectedTotal Decimal? @db.Decimal(12, 2)
  currency      String?

  orderedAt  DateTime?
  expectedAt DateTime?
  receivedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PurchaseOrderLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model PurchaseOrderLine {
  id String @id @default(cuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  materialId  String?
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String?
  unitCost    Decimal? @db.Decimal(12, 4)

  /// Partial deliveries are the normal case, so received is its own quantity
  /// rather than a boolean.
  quantityReceived Decimal @default(0) @db.Decimal(12, 3)

  createdAt DateTime @default(now())

  @@index([purchaseOrderId])
}

/// A movement of stock. The level is SUMMED from these, never stored.
///
/// Same reasoning as the voice credit ledger and the commission ledger: a
/// stored quantity is a second opinion that drifts from the movements, and the
/// one nobody looks at is the one that rots. `Material.reorderThreshold`
/// already exists and has never been read by anything — this is what finally
/// gives it something to compare against.
model StockMovement {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  materialId String

  /// Signed. Positive is in, negative is out — so the level is one sum with no
  /// special cases, and a correction is a movement rather than an edit.
  quantity Decimal @db.Decimal(12, 3)

  /// "received" | "used" | "returned" | "adjustment" | "wastage"
  kind String

  jobId           String?
  purchaseOrderId String?
  note            String?

  /// Idempotency for anything machine-written (a PO receipt, an import).
  ref String? @unique

  occurredAt DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  @@index([companyId, materialId, occurredAt])
}

/// A vehicle, beyond what Asset carries.
///
/// A van is already an Asset with category "vehicle", which handles what it
/// cost and how it depreciates. What Asset cannot answer is anything a fleet
/// question asks: which van, what mileage, when is it due, who has it.
///
/// Hung off Asset rather than replacing it, so the depreciation already in the
/// job-costing overhead keeps working untouched.
model VehicleDetail {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// One row per vehicle Asset.
  assetId String @unique

  vin          String?
  plate        String?
  makeModel    String?
  year         Int?
  odometerKm   Int?
  odometerAtUtc DateTime?

  assignedToUserId String?

  insuranceExpiresAt DateTime?
  registrationExpiresAt DateTime?
  nextServiceDueKm   Int?
  nextServiceDueAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenance VehicleMaintenance[]

  @@index([companyId])
}

model VehicleMaintenance {
  id String @id @default(cuid())

  vehicleId String
  vehicle   VehicleDetail @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// "service" | "repair" | "tyres" | "inspection" | "other"
  kind        String
  description String
  odometerKm  Int?
  costCents   Int?
  supplierId  String?

  performedAt DateTime
  createdAt   DateTime @default(now())

  @@index([vehicleId, performedAt])
}

/// A sales rep's own note. The Notion-shaped surface, minus the editor that
/// would not install — see lib/sales/notes/body.js for why.
///
/// NOT tenant data: a rep is not a member of any company, so there is no
/// companyId here and there must never be one. The scoping column is
/// salesRepId, exactly as lib/sales/scope.js argues for a rep's company list —
/// the fragment IS the boundary, not a filter behind one.
model SalesRepNote {
  id String @id @default(cuid())

  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  title String @default("")

  /// What `body` holds. Named rather than assumed so a richer editor can land
  /// later without having to guess at the rows written before it.
  body       String @default("")
  bodyFormat String @default("text")

  /// Optional parents, and ALL THREE may be null. A rep jotting during a call
  /// has not decided what the note is about yet, and forcing a parent would
  /// mean inventing one — the same reasoning SalesLead.prospectId gives.
  ///
  /// SetNull rather than Cascade: deleting a lead must not delete the rep's
  /// notes about it. What survives is the note plus parentLabel.
  leadId     String?
  lead       SalesLead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  threadId   String?
  thread     SalesThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  prospectId String?
  prospect   Prospect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  /// The parent's name, frozen when the note was attached. Same reasoning as
  /// ActivityLog.actorName: when the lead is deleted the FK goes null, and
  /// "this was about Acme Painting" is the one fact worth keeping.
  parentLabel String?

  /// Soft. Nothing hard-deletes a note.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesRepId, updatedAt])
  @@index([leadId])
}


model SalesPlaybook {
  id   String @id @default(cuid())
  key  String @unique
  name String

  /// Closed vocabulary — see selectors.js. Never free text.
  selectorKey String

  /// Higher opens first. Ties break on `key`, so the answer does not depend on
  /// the order Postgres returned the rows in.
  priority Int @default(0)

  stages Json

  active  Boolean @default(true)
  /// Bumped when an edit changes what the playbook SAYS or when it opens.
  /// Renaming it does not bump. Same rule as OpportunityRule.version.
  version String  @default("1")

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  experiments SalesPlaybookExperiment[]

  @@index([active, priority])
}

model SalesObjection {
  code  String @id
  label String

  /// The words a prospect actually says. Matched as lower-cased substrings —
  /// no stemming: a near-match opens the wrong answer and the rep reads it out.
  cues String[] @default([])

  response String

  contextSelectorKey String?

  priority Int     @default(0)
  active   Boolean @default(true)
  version  String  @default("1")

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active, priority])
}

model SalesPlaybookExperiment {
  id  String @id @default(cuid())
  key String @unique

  name       String
  hypothesis String

  playbookKey String
  playbook    SalesPlaybook @relation(fields: [playbookKey], references: [key], onDelete: Cascade)

  /// [{ key, label, weight, stages: [{ stageKey, say, prompts }] }]
  /// A variant may only OVERRIDE one of the nine stages. It cannot add or
  /// remove one: two variants that do not cover the same nine stages are not
  /// comparable, which is the one thing an experiment needs them to be.
  variants Json

  active    Boolean   @default(false)
  startedAt DateTime?
  stoppedAt DateTime?

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignments SalesPlaybookAssignment[]

  @@index([active, playbookKey])
}

model SalesPlaybookAssignment {
  id String @id @default(cuid())

  experimentId String
  experiment   SalesPlaybookExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  variantKey String
  /// The hash bucket the assignment came out of, kept so an assignment can be
  /// re-derived and checked rather than taken on trust.
  bucket     Int?

  /// Who was looking at it when it was assigned. NOT who chose it — nobody
  /// chooses it.
  salesRepId String?
  assignedBy String  @default("system")
  assignedAt DateTime @default(now())

  @@unique([experimentId, prospectId])
  @@index([experimentId, variantKey])
}

model ProspectTalkingPoint {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  playbookKey String
  stageKey    String

  capabilityCode String
  text           String

  /// "ai" | "rule"
  source String @default("rule")
  /// The model that wrote it, when one did. Null for a rule sentence.
  model  String?

  /// Copied from the opportunity at generation time, so the point stays
  /// explainable after the rule that produced it is edited.
  evidenceIds String[] @default([])
  ruleCode    String?
  ruleVersion String?

  generatedAt DateTime @default(now())

  @@index([prospectId, playbookKey])
}
/// One press of the call button.
///
/// ── Written at the DIAL, not at the outcome ──────────────────────────────
///
/// Oklahoma and Florida cap CALLS to the same business on the same subject at
/// three per 24 hours — not conversations. A rep who dials five times and
/// fills one outcome in has made five calls, so the row exists before there is
/// anything to say about it and `disposition` starts null. An attempt with no
/// disposition is a real, visible state, not a gap.
///
/// ── Two ways a call can be placed, and only one of them is measurable ────
///
/// `dialChannel` says which. A `handset` dial is a `tel:` handoff: the
/// operating system takes the call and nothing reports back, so every provider
/// column below stays null forever on those rows. A `browser` dial is bridged
/// through Twilio, and the provider reports ring, answer, hangup and price.
///
/// The columns are nullable rather than absent BECAUSE the two coexist. What
/// must never happen is a report that averages them together and calls the
/// result talk time — a handset row is not a zero-second call, it is a call
/// nobody timed. lib/sales/calls/reporting.js counts the measured rows and
/// prints the denominator beside every duration for exactly that reason.
model SalesCallAttempt {
  id String @id @default(cuid())

  /// Who dialled. Restrict, not Cascade: a rep leaving must not delete the
  /// evidence that a business was called. Same reasoning SalesSuppression
  /// gives for keeping loose pointers instead of cascading foreign keys.
  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id])

  /// The prospect the rep was looking at, when there was one. Nullable and
  /// SetNull: a rep ringing a lead they typed in themselves has no Prospect,
  /// and deleting one must not delete the call record.
  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  /// The rep's own lead, when there is one.
  leadId String?
  lead   SalesLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// The number as dialled, E.164, normalised on write.
  ///
  /// THE CAP IS COUNTED ON THIS COLUMN, not on prospectId. Prospect dedupe
  /// FLAGS duplicates rather than merging them — `possibleDuplicateOfId`,
  /// "merging destroys provenance" — so one business can hold two rows, and
  /// counting per row would turn a three-call cap into a six-call one by
  /// accident.
  toE164 String

  /// The number presented to them. Null on a handset dial, because nothing in
  /// FieldQuo knows what a rep's own phone presents. Not defaulted to the sales
  /// line: that would record a caller ID that was never shown.
  fromE164 String?

  /// "out" | "in". Inbound rows are written by the sales-line handler when a
  /// contractor rings back, so "how many times have we spoken" is one query.
  direction String @default("out")

  /// "browser" | "handset". Which door the call went through, and therefore
  /// whether any of the provider columns below can ever be filled. Defaulted
  /// to handset so a row written by an older path is not silently claimed as
  /// measured.
  dialChannel String @default("handset")

  dialledAt DateTime @default(now())

  // ── What the carrier reported. Browser dials only ─────────────────────
  //
  // Every one of these is nullable and stays null on a handset row. None is
  // ever defaulted to zero: "not measured" and "zero seconds" are different
  // facts and collapsing them is what turns an honest gap into a false chart.

  /// Twilio's CallSid for the PSTN leg. @unique so the three status callbacks
  /// for one call (initiated, answered, completed) land on one row and a
  /// provider retry cannot duplicate it — the same reason
  /// PlatformVoiceCall.providerCallId is unique.
  providerCallSid String? @unique
  /// Twilio's own final status: completed, busy, no-answer, failed, canceled.
  /// Kept verbatim and NOT mapped onto a disposition: what the network says
  /// and what the rep says are two different statements about one call, and
  /// merging them loses the case where they disagree.
  providerStatus  String?
  /// When it started ringing, when it was answered, when it ended.
  ringingAt   DateTime?
  answeredAt  DateTime?
  endedAt     DateTime?
  /// Billed seconds, from the provider. This IS talk time, on these rows only.
  talkSeconds Int?
  /// Seconds the rep had the prospect on hold, summed from hold events.
  holdSeconds Int?
  /// FieldQuo's own cost for this call, both legs, from the provider's figure.
  /// Null when the provider gave none — never a hand-typed per-minute
  /// estimate, for the reason VoiceCall.providerCostCents gives.
  providerCostCents Decimal? @db.Decimal(12, 4)

  // ── The gate's answer, frozen at the moment of the dial ────────────────
  //
  // "Was this call lawful when it was made" has to be answerable a year later,
  // after CALLING_JURISDICTIONS has been edited and a state has moved from
  // unverified to verified. Recomputing it then would answer a different
  // question. So the decision travels with the row.

  /// The CALLING_JURISDICTIONS key that was applied — "US-OK", "CA", and so on.
  /// Null only for a lead with no jurisdiction, which cannot produce an
  /// allowed decision and therefore cannot produce a row today.
  jurisdictionCode String?
  /// Always "allowed" — dialHref() cannot return a target from anything else.
  /// Stored rather than assumed so the invariant is auditable in the data
  /// instead of only in the code that wrote it.
  decisionAtDial   String  @default("allowed")
  /// The window as it read on screen, e.g. "08:00–20:00".
  windowText       String?
  /// The zone the window was evaluated in, and whether a human stated it or it
  /// was derived from the subdivision. The two are not equally good and the
  /// difference must survive.
  prospectTimeZone String?
  timeZoneSource   String?

  // ── What the rep says happened ────────────────────────────────────────
  //
  // Null until they say. A DISPOSITIONS key from lib/sales/calls/dispositions.js
  // — a closed vocabulary, checked in code, deliberately not a superadmin table
  // because each value carries a claim transition with it.

  disposition     String?
  dispositionAt   DateTime?
  dispositionNote String?

  /// Set only by the `callback` disposition. The claim's lease is extended to
  /// cover it, which is why dispositions.js bounds how far out it may be.
  callbackAt DateTime?

  // ── What was said, so an experiment can be read afterwards ────────────
  //
  // SalesPlaybookExperiment and SalesPlaybookAssignment already store which
  // arm a prospect is in, BEFORE the call, per spec §38 — and there has been
  // nothing to measure them against. These four columns are that missing half.
  // Copied at dial time rather than joined at read time: editing a playbook
  // must not retroactively change what a rep is recorded as having read.

  playbookKey     String?
  playbookVersion String?
  experimentKey   String?
  variantKey      String?

  createdAt DateTime @default(now())

  /// The cap query, and the only index that has to be fast: every dial runs it.
  @@index([toE164, dialledAt])
  @@index([salesRepId, dialledAt])
  @@index([prospectId, dialledAt])
  @@index([disposition])
}

/// What a rep is doing right now, and the log of what they were doing.
///
/// ── One model, not two ────────────────────────────────────────────────────
///
/// A contact centre usually keeps a live agent-status row and a separate
/// activity log, because a predictive dialler has to read the live one
/// thousands of times a second. FieldQuo has no dialler reading it: the only
/// consumer is a person looking at a screen. So this is the LOG, and "what are
/// they doing right now" is its most recent row — one table that cannot
/// disagree with itself, rather than two that can. The same argument
/// lib/voice/credits.js makes for summing a balance instead of storing one.
///
/// ── Nothing infers a state ────────────────────────────────────────────────
///
/// Every row is written because a rep pressed something, or because they
/// dialled, or because their session ended. Nothing writes "available" because
/// a page loaded, and nothing writes "offline" on a guess about a browser that
/// stopped polling — a stale row says when it was written and the screen says
/// how old it is. Inventing presence is AGENTS.md failure class 5 pointed at a
/// person's timesheet.
model SalesRepActivity {
  id String @id @default(cuid())

  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  /// A REP_STATES key from lib/sales/calls/agentState.js. Closed vocabulary.
  state String

  /// Why, for `paused` only — a PAUSE_REASONS key. Null for every other state,
  /// and refused as a value on any other state, so "paused" without a reason
  /// cannot exist and "available, reason: lunch" cannot either.
  pauseReason String?

  /// The attempt that caused it, for `on_call` and `after_call`. Loose pointer
  /// on purpose, like SalesSuppression's: the activity log outliving an
  /// attempt row is an acceptable failure, the log vanishing is not.
  callAttemptId String?

  startedAt DateTime @default(now())
  /// Written when the NEXT row is opened, so a period has a real length rather
  /// than one computed from the gap to whatever row happened to sort next.
  /// Null on the current row, which is how "right now" is found.
  endedAt   DateTime?

  /// Last time the rep's browser said it was still there. Beaten every 60s by
  /// the portal shell.
  ///
  /// This exists so the supervisor board can tell "available" from "said they
  /// were available before the laptop lid closed". Without it an open row is
  /// true forever and the board confidently reports a rep who went home. It is
  /// NOT used to close the row or to infer a state — nothing writes "offline"
  /// on a guess about a browser that stopped talking. It only ages the claim,
  /// and livePresence() turns that age into a third answer beside the state.
  heartbeatAt DateTime?

  createdAt DateTime @default(now())

  /// The live lookup: one rep's open row, and a team's open rows.
  @@index([salesRepId, startedAt])
  @@index([endedAt, startedAt])
}
