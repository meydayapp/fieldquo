enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  // Money that was collected has since gone back out, in whole or in part —
  // a Stripe refund or a lost dispute. Deliberately NOT folded into "overdue"
  // or left silently as "paid": neither is true, and AGENTS.md's own rule is
  // that a status must not be overloaded with a meaning it wasn't given. See
  // lib/invoices/computeInvoiceState.js for exactly when each applies.
  refunded
  partially_refunded
  // A chargeback is open — the bank is deciding, the money is not yet
  // reversed. Different from "unpaid": the client DID pay, and different from
  // "paid": the contractor cannot rely on the money staying theirs yet.
  disputed
}

enum PaymentMethod {
  cash
  e_transfer
  cheque
  shop
  stripe
  // A paid booking/visit fee the client already paid (via Stripe Connect at
  // booking) that the contractor later credits onto this invoice. Tracked as
