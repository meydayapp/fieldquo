# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Bundled output of scripts/check-takeoff-render.jsx — written and deleted by
# `npm run check:takeoff-render`, never committed.
.takeoff-render.cjs

# Installed skill payloads (npx skills add). skills-lock.json is committed and
# is the reproducible record; this directory is 6.7 MB of vendored third-party
# content that `npx skills install` restores — the node_modules pattern.
.claude/skills/
