{
  "name": "fieldquo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-imports.mjs && node scripts/check-env-docs.mjs && prisma generate && next build",
    "check:imports": "node scripts/check-imports.mjs",
    "start": "next start",
    "lint": "eslint",
    "check:translations": "node scripts/check-translations.mjs",
    "check:kitchen": "node --import ./scripts/alias-loader.mjs scripts/check-kitchen-pricing.mjs",
    "check:contrast": "node --import ./scripts/alias-loader.mjs scripts/check-designer-contrast.mjs",
    "check:plan": "node --import ./scripts/alias-loader.mjs scripts/check-kitchen-plan.mjs",
    "check:finishes": "node --import ./scripts/alias-loader.mjs scripts/check-kitchen-finishes.mjs",
    "check:voice": "node --import ./scripts/alias-loader.mjs scripts/check-voice.mjs",
    "check:access": "node --import ./scripts/alias-loader.mjs scripts/check-billing-access.mjs",
    "check:retention": "node --import ./scripts/alias-loader.mjs scripts/check-retention.mjs",
    "check:prompt": "node --import ./scripts/alias-loader.mjs scripts/check-voice-prompt.mjs",
    "check:pdf": "npx tsx scripts/check-kitchen-pdf.jsx",
    "check:section": "node scripts/check-kitchen-section.mjs",
    "check:outbound": "node --import ./scripts/alias-loader.mjs scripts/check-outbound.mjs",
    "check:leadconsent": "node scripts/check-lead-consent.mjs",
    "check:cleaning": "node --import ./scripts/alias-loader.mjs scripts/check-cleaning-pricing.mjs",
    "check:reviews": "node --import ./scripts/alias-loader.mjs scripts/check-reviews.mjs && node --import ./scripts/alias-loader.mjs scripts/check-review-email.mjs",
    "check:travel": "node --import ./scripts/alias-loader.mjs scripts/check-travel.mjs",
    "check:env": "node scripts/check-env-docs.mjs",
    "check:booking": "node --import ./scripts/alias-loader.mjs scripts/check-travel.mjs && node --import ./scripts/alias-loader.mjs scripts/check-arrival-window.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/infra": "^0.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-google-maps/api": "^2.20.8",
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "openai": "^7.0.0",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "shadcn": "^4.13.0",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
